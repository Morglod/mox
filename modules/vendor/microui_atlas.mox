// microui default atlas:
// a 128x128 alpha texture with a font (ASCII 32..127, 18 px line) and the icons,
// plus helpers that turn microui commands into textured quads.
// Optional: import it when you have no font / icon rendering of your own.
//
// Data from rxi/microui demo/atlas.inl (via the Odin vendor/microui port).
// Copyright (c) 2020 rxi - MIT license, see vendor/microui.mox.
//
// Use:
//   ctx.text_width = mu_atlas_text_width;
//   ctx.text_height = mu_atlas_text_height;
//   upload mu_atlas_alpha (MU_ATLAS_WIDTH x MU_ATLAS_HEIGHT, 1 byte per texel;
//   or mu_atlas_rgba for white RGBA) as a texture, then for every command:
//     MU_COMMAND_RECT  mu_atlas_draw_rect(...)   - the white texel stretched
//     MU_COMMAND_TEXT  mu_atlas_draw_text(...)   - one quad per glyph
//     MU_COMMAND_ICON  mu_atlas_draw_icon(...)   - one quad, centered
//   each emits quads through your MuAtlasQuadFn: dst rect on screen,
//    src rect in the atlas (texels), color. MU_COMMAND_CLIP is a scissor rect.

import "internal.mox";
import "assert.mox";
import "./microui.mox";

const MU_ATLAS_WIDTH  : i64 = 128;
const MU_ATLAS_HEIGHT : i64 = 128;
const MU_ATLAS_LINE_HEIGHT : i32 = 18;

const MuAtlasQuadFn : __type_ptr = #type fn(user: *u8, dst: MuRect, src: MuRect, color: MuColor): void;

