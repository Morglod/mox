fn mu_atlas_text_width(font: *u8, str: []u8): i32 {
    w : i32 = 0;
    for (i : it_range(str.len)) {
        b := str[i];
        if ((b & 0xC0) == 0x80) { continue; }
        w += mu_atlas_font[min(b, 127u8).cast(i64)].w;
    }
    return w;
}

fn mu_atlas_text_height(font: *u8): i32 {
    return MU_ATLAS_LINE_HEIGHT;
}

fn mu_atlas_rgba(out: []u8): void {
    assert(out.len >= MU_ATLAS_WIDTH * MU_ATLAS_HEIGHT * 4, "mu_atlas_rgba: buffer too small", .{});
    for (i : it_range(MU_ATLAS_WIDTH * MU_ATLAS_HEIGHT)) {
        out[i * 4] = 255;
        out[i * 4 + 1] = 255;
        out[i * 4 + 2] = 255;
        out[i * 4 + 3] = mu_atlas_alpha[i];
    }
}

fn mu_atlas_draw_rect(rect: MuRect, color: MuColor, quad: *MuAtlasQuadFn, user: *u8): void {
    quad(user, rect, mu_atlas_white, color);
}

fn mu_atlas_draw_text(str: []u8, pos: MuVec2, color: MuColor, quad: *MuAtlasQuadFn, user: *u8): void {
    dst := mu_rect(pos.x, pos.y, 0, 0);
    for (i : it_range(str.len)) {
        b := str[i];
        if ((b & 0xC0) == 0x80) { continue; }
        src := mu_atlas_font[min(b, 127u8).cast(i64)];
        dst.w = src.w;
        dst.h = src.h;
        if (src.w > 0) { quad(user, dst, src, color); }
        dst.x += dst.w;
    }
}

fn mu_atlas_draw_icon(id: i32, rect: MuRect, color: MuColor, quad: *MuAtlasQuadFn, user: *u8): void {
    if ((id <= 0) || (id.cast(i64) >= MU_ICON_MAX)) { return; }
    src := mu_atlas_icons[id.cast(i64)];
    x := rect.x + (rect.w - src.w) / 2;
    y := rect.y + (rect.h - src.h) / 2;
    quad(user, mu_rect(x, y, src.w, src.h), src, color);
}

fn mu_atlas_draw_command(cmd: *MuCommand, quad: *MuAtlasQuadFn, user: *u8): bool {
    if (cmd.type == MU_COMMAND_RECT) {
        c := cmd.cast(*MuRectCommand);
        mu_atlas_draw_rect(c.rect, c.color, quad, user);
    } else if (cmd.type == MU_COMMAND_TEXT) {
        c := cmd.cast(*MuTextCommand);
        mu_atlas_draw_text(mu_text_command_str(c), c.pos, c.color, quad, user);
    } else if (cmd.type == MU_COMMAND_ICON) {
        c := cmd.cast(*MuIconCommand);
        mu_atlas_draw_icon(c.id, c.rect, c.color, quad, user);
    } else {
        return false;
    }
    return true;
}
