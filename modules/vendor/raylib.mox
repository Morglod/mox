const AudioCallback : __type_ptr = #type *fn(_arg0: *i32, _arg1: u32): void;
#linkc fn InitAudioDevice(): void;
#linkc fn CloseAudioDevice(): void;
#linkc fn IsAudioDeviceReady(): bool;
#linkc fn SetMasterVolume(volume: f32): void;
#linkc fn GetMasterVolume(): f32;
