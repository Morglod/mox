import "internal.mox";
import "build.mox";
import "format.mox";

fn link_sdl3($link_comptime: bool): void {
    if (!#is_comptime) { return; }

    link_path := "";
    dll_path := "";

    switch (MOX_OS) {
        case .Windows:
            link_path = "./win64/libSDL3.dll.a";
            dll_path = "./win64/SDL3.dll";
        case .Linux:
            link_path = "./linux64/libSDL3.so.0";
            dll_path = "./linux64/libSDL3.so.0";
            __compiler_link_lib("m", false);
            __compiler_append_linker("-Wl,-rpath,'$ORIGIN'");
        case .Darwin:
            println("\n\nsdl3 binaries on Darwin is not shipped yet, link it manually\n\n");
            return;
        case .Unknown:
    }

    __compiler_link_lib(build_resolve_path(link_path), false);
    if ($link_comptime) {
        __compiler_link_lib(build_resolve_path(dll_path), true);
    }
    build_copy_to_output(build_resolve_path(dll_path));
}

#run link_sdl3(false);

// example of comptime usage:
// #run {
//     link_sdl3(true);
//     use sdl here
// }