const SDL_HapticEffectType : __type_ptr = #type u16;
const SDL_HapticDirectionType : __type_ptr = #type u8;
const SDL_HapticEffectID : __type_ptr = #type i32;
struct SDL_HapticDirection {
    type: SDL_HapticDirectionType;
    dir: [3]i32;
};

struct SDL_HapticConstant {
    type: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: u32;
    delay: u16;
    button: u16;
    interval: u16;
    level: i16;
    attack_length: u16;
    attack_level: u16;
    fade_length: u16;
    fade_level: u16;
};

struct SDL_HapticPeriodic {
    type: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: u32;
    delay: u16;
    button: u16;
    interval: u16;
    period: u16;
    magnitude: i16;
    offset: i16;
    phase: u16;
    attack_length: u16;
    attack_level: u16;
    fade_length: u16;
    fade_level: u16;
};

struct SDL_HapticCondition {
    type: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: u32;
    delay: u16;
    button: u16;
    interval: u16;
    right_sat: [3]u16;
    left_sat: [3]u16;
    right_coeff: [3]i16;
    left_coeff: [3]i16;
    deadband: [3]u16;
    center: [3]i16;
};

struct SDL_HapticRamp {
    type: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: u32;
    delay: u16;
    button: u16;
    interval: u16;
    start: i16;
    end: i16;
    attack_length: u16;
    attack_level: u16;
    fade_length: u16;
    fade_level: u16;
};

struct SDL_HapticLeftRight {
    type: SDL_HapticEffectType;
    length: u32;
    large_magnitude: u16;
    small_magnitude: u16;
};

struct SDL_HapticCustom {
    type: SDL_HapticEffectType;
    direction: SDL_HapticDirection;
    length: u32;
    delay: u16;
    button: u16;
    interval: u16;
    channels: u8;
    period: u16;
    samples: u16;
    data: *u16;
    attack_length: u16;
    attack_level: u16;
    fade_length: u16;
    fade_level: u16;
};

// Union SDL_HapticEffect
const SDL_HapticEffect := #run SDL_HapticEffectType |> type_union(SDL_HapticConstant) |> type_union(SDL_HapticPeriodic) |> type_union(SDL_HapticCondition) |> type_union(SDL_HapticRamp) |> type_union(SDL_HapticLeftRight) |> type_union(SDL_HapticCustom);

