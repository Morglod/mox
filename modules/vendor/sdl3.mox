const SDL_GamepadBinding_input := #run (i32 |> type_union(SDL_GamepadBinding_input_axis) |> type_union(SDL_GamepadBinding_input_hat));

// Anonymous struct SDL_GamepadBinding_output_axis
struct SDL_GamepadBinding_output_axis {
    axis: SDL_GamepadAxis;
    axis_min: i32;
    axis_max: i32;
};

// Anonymous union SDL_GamepadBinding_output
const SDL_GamepadBinding_output := #run (SDL_GamepadButton |> type_union(SDL_GamepadBinding_output_axis));

struct SDL_GamepadBinding {
    input_type: SDL_GamepadBindingType;
    input: SDL_GamepadBinding_input;
    output_type: SDL_GamepadBindingType;
    output: SDL_GamepadBinding_output;
};

