// rapidhash v3 implementation

import "internal.mox";
import "math.mox";

fn _rapid_likely_(x: bool): bool {
    return x;
}

const RAPIDHASH_LITTLE_ENDIAN : bool = true;

 /*
  *  Unrolled macro.
  *  Improves large input speed, but increases code size and worsens small input speed.
  *
  *  RAPIDHASH_COMPACT: Normal behavior.
  *  RAPIDHASH_UNROLLED: 
  *
  */
const RAPIDHASH_COMPACT : bool = true;
 
 /*
  *  Protection macro, alters behaviour of rapid_mum multiplication function.
  *
  *  RAPIDHASH_FAST: Normal behavior, max speed.
  *  RAPIDHASH_PROTECTED: Extra protection against entropy loss.
  */

const RAPIDHASH_PROTECTED : bool = false; 

 /*
  *  Default secret parameters.
  */
const rapid_secret : [?]u64 = .{
    0x2d358dccaa6c78a5;
    0x8bb84b93962eacc9;
    0x4b33a62ed433d4a3;
    0x4d5a2da51de1aa47;
    0xa0761d6478bd642f;
    0xe7037ed1a0b428db;
    0x90ed1765281c388c;
    0xaaaaaaaaaaaaaaaa;
};
 
 /*
  *  64*64 -> 128bit multiply function.
  *
  *  @param A  Address of 64-bit number.
  *  @param B  Address of 64-bit number.
  *
  *  Calculates 128-bit C = *A * *B.
  *
  *  When RAPIDHASH_FAST is defined:
  *  Overwrites A contents with C's low 64 bits.
  *  Overwrites B contents with C's high 64 bits.
  *
  *  When RAPIDHASH_PROTECTED is defined:
  *  Xors and overwrites A contents with C's low 64 bits.
  *  Xors and overwrites B contents with C's high 64 bits.
  */
 fn rapid_mum(A: *u64, B: *u64) {
    #if (RAPIDHASH_PROTECTED) {
        b : u64 = #memory_garbage;
        a : u64 = umul128(A.*, B.*, b.^);
        A.* ^= a;
        B.* ^= b;
    } else {
        A.* = umul128(A.*, B.*, B);
    }
}
 
 /*
  *  Multiply and xor mix function.
  *
  *  @param A  64-bit number.
  *  @param B  64-bit number.
  *
  *  Calculates 128-bit C = A * B.
  *  Returns 64-bit xor between high and low 64 bits of C.
  */
fn rapid_mix(A: u64, B: u64): u64 {
    rapid_mum(A.^, B.^);
    return A ^ B;
}
 
 /*
  *  Read functions.
  */
#if (RAPIDHASH_LITTLE_ENDIAN) {
    fn rapid_read64(p: *u8): u64 {
        return p.cast(*u64).*;
    }
    fn rapid_read32(p: *u8): u64 {
        return p.cast(*u32).*.cast(u64);
    }
} else {
    fn rapid_read64(p: *u8): u64 {
        return #byte_reverse(p.cast(*u64).*);
    }
    fn rapid_read32(p: *u8): u64 {
        return #byte_reverse(p.cast(*u32).*).cast(u64);
    }
}

 /*
  *  rapidhash main function.
  *
  *  @param key     Buffer to be hashed.
  *  @param len     @key length, in bytes.
  *  @param seed    64-bit seed used to alter the hash result predictably.
  *  @param secret  Triplet of 64-bit secrets used to alter hash result predictably.
  *
  *  Returns a 64-bit hash.
  */
fn rapidhash_internal(key: *u8, len: i64, seed: u64, secret: *u64): u64 {
    p : *u8 = key;
    seed ^= rapid_mix(seed ^ (secret |> ty_offset(2) .*), (secret |> ty_offset(1) .*));
    a: u64 = 0; b: u64 = 0;
    i : i64 = len;
    if (_rapid_likely_(len <= 16)) {
        if (len >= 4) {
            seed ^= len.cast(u64);
            if (len >= 8) {
                plast: *u8 = p |> byte_offset(len - 8);
                a = rapid_read64(p);
                b = rapid_read64(plast);
            } else {
                plast: *u8 = p |> byte_offset(len - 4);
                a = rapid_read32(p);
                b = rapid_read32(plast);
            }
        } else if (len > 0) {
            a = #shl(p.*.cast(u64), 45) | (p |> byte_offset(len - 1) .*).cast(u64);
            b = p |> byte_offset(#shr(len, 1)) .*;
        } else {
            a = b = 0;
        }
    } else {
        if (len > 112) {
            see1 : u64 = seed; see2 : u64 = seed;
            see3 : u64 = seed; see4 : u64 = seed;
            see5 : u64 = seed; see6 : u64 = seed;
            #if (RAPIDHASH_COMPACT) {
                while(i > 112) {
                    seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(0) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
                    see1 = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(24)) ^ see1);
                    see2 = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(40)) ^ see2);
                    see3 = rapid_mix(rapid_read64(p |> byte_offset(48)) ^ (secret |> ty_offset(3) .*), rapid_read64(p |> byte_offset(56)) ^ see3);
                    see4 = rapid_mix(rapid_read64(p |> byte_offset(64)) ^ (secret |> ty_offset(4) .*), rapid_read64(p |> byte_offset(72)) ^ see4);
                    see5 = rapid_mix(rapid_read64(p |> byte_offset(80)) ^ (secret |> ty_offset(5) .*), rapid_read64(p |> byte_offset(88)) ^ see5);
                    see6 = rapid_mix(rapid_read64(p |> byte_offset(96)) ^ (secret |> ty_offset(6) .*), rapid_read64(p |> byte_offset(104)) ^ see6);
                    p = p |> byte_offset(112);
                    i -= 112;
                }
            } else {
                while (i > 224) {
                    seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(0) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
                    see1 = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(24)) ^ see1);
                    see2 = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(40)) ^ see2);
                    see3 = rapid_mix(rapid_read64(p |> byte_offset(48)) ^ (secret |> ty_offset(3) .*), rapid_read64(p |> byte_offset(56)) ^ see3);
                    see4 = rapid_mix(rapid_read64(p |> byte_offset(64)) ^ (secret |> ty_offset(4) .*), rapid_read64(p |> byte_offset(72)) ^ see4);
                    see5 = rapid_mix(rapid_read64(p |> byte_offset(80)) ^ (secret |> ty_offset(5) .*), rapid_read64(p |> byte_offset(88)) ^ see5);
                    see6 = rapid_mix(rapid_read64(p |> byte_offset(96)) ^ (secret |> ty_offset(6) .*), rapid_read64(p |> byte_offset(104)) ^ see6);
                    seed = rapid_mix(rapid_read64(p |> byte_offset(112)) ^ (secret |> ty_offset(0) .*), rapid_read64(p |> byte_offset(120)) ^ seed);
                    see1 = rapid_mix(rapid_read64(p |> byte_offset(128)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(136)) ^ see1);
                    see2 = rapid_mix(rapid_read64(p |> byte_offset(144)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(152)) ^ see2);
                    see3 = rapid_mix(rapid_read64(p |> byte_offset(160)) ^ (secret |> ty_offset(3) .*), rapid_read64(p |> byte_offset(168)) ^ see3);
                    see4 = rapid_mix(rapid_read64(p |> byte_offset(176)) ^ (secret |> ty_offset(4) .*), rapid_read64(p |> byte_offset(184)) ^ see4);
                    see5 = rapid_mix(rapid_read64(p |> byte_offset(192)) ^ (secret |> ty_offset(5) .*), rapid_read64(p |> byte_offset(200)) ^ see5);
                    see6 = rapid_mix(rapid_read64(p |> byte_offset(208)) ^ (secret |> ty_offset(6) .*), rapid_read64(p |> byte_offset(216)) ^ see6);
                    p = p |> byte_offset(224);
                    i -= 224;
                }
                if (i > 112) {
                    seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(0) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
                    see1 = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(24)) ^ see1);
                    see2 = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(40)) ^ see2);
                    see3 = rapid_mix(rapid_read64(p |> byte_offset(48)) ^ (secret |> ty_offset(3) .*), rapid_read64(p |> byte_offset(56)) ^ see3);
                    see4 = rapid_mix(rapid_read64(p |> byte_offset(64)) ^ (secret |> ty_offset(4) .*), rapid_read64(p |> byte_offset(72)) ^ see4);
                    see5 = rapid_mix(rapid_read64(p |> byte_offset(80)) ^ (secret |> ty_offset(5) .*), rapid_read64(p |> byte_offset(88)) ^ see5);
                    see6 = rapid_mix(rapid_read64(p |> byte_offset(96)) ^ (secret |> ty_offset(6) .*), rapid_read64(p |> byte_offset(104)) ^ see6);
                    p = p |> byte_offset(112);
                    i -= 112;
                }
            }
            seed ^= see1;
            see2 ^= see3;
            see4 ^= see5;
            seed ^= see6;
            see2 ^= see4;
            seed ^= see2;
        }
        if (i > 16) {
            seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
            if (i > 32) {
                seed = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(24)) ^ seed);
                if (i > 48) {
                    seed = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(40)) ^ seed);
                    if (i > 64) {
                        seed = rapid_mix(rapid_read64(p |> byte_offset(48)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(56)) ^ seed);
                        if (i > 80) {
                            seed = rapid_mix(rapid_read64(p |> byte_offset(64)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(72)) ^ seed);
                            if (i > 96) {
                                seed = rapid_mix(rapid_read64(p |> byte_offset(80)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(88)) ^ seed);
                            }
                        }
                    }
                }
            }
        }
        a = rapid_read64(p |> byte_offset(i - 16)) ^ i.cast(u64);
        b = rapid_read64(p |> byte_offset(i - 8));
    }
    a ^= (secret |> ty_offset(1) .*);
    b ^= seed;
    rapid_mum(a.^, b.^);
    return rapid_mix(a ^ (secret |> ty_offset(7) .*), b ^ (secret |> ty_offset(1) .*) ^ i.cast(u64));
}

 /*
  *  rapidhashMicro main function.
  *
  *  @param key     Buffer to be hashed.
  *  @param len     @key length, in bytes.
  *  @param seed    64-bit seed used to alter the hash result predictably.
  *  @param secret  Triplet of 64-bit secrets used to alter hash result predictably.
  *
  *  Returns a 64-bit hash.
  */
fn rapidhashMicro_internal(key: *u8, len: i64, seed: u64, secret: *u64): u64 {
    p : *u8 = key;
    seed ^= rapid_mix(seed ^ (secret |> ty_offset(2) .*), (secret |> ty_offset(1) .*));
    a: u64 = 0; b: u64 = 0;
    i : i64 = len;
    if (_rapid_likely_(len <= 16)) {
        if (len >= 4) {
            seed ^= len.cast(u64);
            if (len >= 8) {
                plast: *u8 = p |> byte_offset(len - 8);
                a = rapid_read64(p);
                b = rapid_read64(plast);
            } else {
                plast: *u8 = p |> byte_offset(len - 4);
                a = rapid_read32(p);
                b = rapid_read32(plast);
            }
        } else if (len > 0) {
            a = #shl(p.*.cast(u64), 45) | (p |> byte_offset(len - 1) .*).cast(u64);
            b = p |> byte_offset(#shr(len, 1)) .*;
        } else {
            a = b = 0;
        }
    } else {
        if (i > 80) {
            see1 : u64 = seed; see2 : u64 = seed;
            see3 : u64 = seed; see4 : u64 = seed;
            while (i > 80) {
                seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(0) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
                see1 = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(24)) ^ see1);
                see2 = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(40)) ^ see2);
                see3 = rapid_mix(rapid_read64(p |> byte_offset(48)) ^ (secret |> ty_offset(3) .*), rapid_read64(p |> byte_offset(56)) ^ see3);
                see4 = rapid_mix(rapid_read64(p |> byte_offset(64)) ^ (secret |> ty_offset(4) .*), rapid_read64(p |> byte_offset(72)) ^ see4);
                p = p |> byte_offset(80);
                i -= 80;
            }
            seed ^= see1;
            see2 ^= see3;
            seed ^= see4;
            seed ^= see2;
        }
        if (i > 16) {
            seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
            if (i > 32) {
                seed = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(24)) ^ seed);
                if (i > 48) {
                    seed = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(40)) ^ seed);
                    if (i > 64) {
                        seed = rapid_mix(rapid_read64(p |> byte_offset(48)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(56)) ^ seed);
                    }
                }
            }
        }
        a = rapid_read64(p |> byte_offset(i - 16)) ^ i.cast(u64);
        b = rapid_read64(p |> byte_offset(i - 8));
    }
    a ^= (secret |> ty_offset(1) .*);
    b ^= seed;
    rapid_mum(a.^, b.^);
    return rapid_mix(a ^ (secret |> ty_offset(7) .*), b ^ (secret |> ty_offset(1) .*) ^ i.cast(u64));
}

  /*
  *  rapidhashNano main function.
  *
  *  @param key     Buffer to be hashed.
  *  @param len     @key length, in bytes.
  *  @param seed    64-bit seed used to alter the hash result predictably.
  *  @param secret  Triplet of 64-bit secrets used to alter hash result predictably.
  *
  *  Returns a 64-bit hash.
  */
fn rapidhashNano_internal(key: *u8, len: i64, seed: u64, secret: *u64): u64 {
    p : *u8 = key;
    seed ^= rapid_mix(seed ^ (secret |> ty_offset(2) .*), (secret |> ty_offset(1) .*));
    a: u64 = 0; b: u64 = 0;
    i : i64 = len;
    if (_rapid_likely_(len <= 16)) {
        if (len >= 4) {
            seed ^= len.cast(u64);
            if (len >= 8) {
                plast: *u8 = p |> byte_offset(len - 8);
                a = rapid_read64(p);
                b = rapid_read64(plast);
            } else {
                plast: *u8 = p |> byte_offset(len - 4);
                a = rapid_read32(p);
                b = rapid_read32(plast);
            }
        } else if (len > 0) {
            a = #shl(p.*.cast(u64), 45) | (p |> byte_offset(len - 1) .*).cast(u64);
            b = p |> byte_offset(#shr(len, 1)) .*;
        } else {
            a = b = 0;
        }
    } else {
        if (i > 48) {
            see1 : u64 = seed; see2 : u64 = seed;
            while (i > 48) {
                seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(0) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
                see1 = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(1) .*), rapid_read64(p |> byte_offset(24)) ^ see1);
                see2 = rapid_mix(rapid_read64(p |> byte_offset(32)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(40)) ^ see2);
                p = p |> byte_offset(48);
                i -= 48;
            }
            seed ^= see1;
            seed ^= see2;
        }
        if (i > 16) {
            seed = rapid_mix(rapid_read64(p) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(8)) ^ seed);
            if (i > 32) {
                seed = rapid_mix(rapid_read64(p |> byte_offset(16)) ^ (secret |> ty_offset(2) .*), rapid_read64(p |> byte_offset(24)) ^ seed);
            }
        }
        a = rapid_read64(p |> byte_offset(i - 16)) ^ i.cast(u64);
        b = rapid_read64(p |> byte_offset(i - 8));
    }
    a ^= (secret |> ty_offset(1) .*);
    b ^= seed;
    rapid_mum(a.^, b.^);
    return rapid_mix(a ^ (secret |> ty_offset(7) .*), b ^ (secret |> ty_offset(1) .*) ^ i.cast(u64));
}
 
/*
 *  rapidhash seeded hash function.
 *
 *  @param key     Buffer to be hashed.
 *  @param len     @key length, in bytes.
 *  @param seed    64-bit seed used to alter the hash result predictably.
 *
 *  Calls rapidhash_internal using provided parameters and default secrets.
 *
 *  Returns a 64-bit hash.
 */
fn rapidhash_withSeed(key: *u8, len: i64, seed: u64): u64 {
    return rapidhash_internal(key, len, seed, rapid_secret[0].^);
}
 
/*
 *  rapidhash general purpose hash function.
 *
 *  @param key     Buffer to be hashed.
 *  @param len     @key length, in bytes.
 *
 *  Calls rapidhash_withSeed using provided parameters and the default seed.
 *
 *  Returns a 64-bit hash.
 */
fn rapidhash(key: *u8, len: i64): u64 {
    return rapidhash_withSeed(key, len, 0);
}

/*
 *  rapidhashMicro seeded hash function.
 *
 *  Designed for HPC and server applications, where cache misses make a noticeable performance detriment.
 *  Clang-18+ compiles it to ~140 instructions without stack usage, both on x86-64 and aarch64.
 *  Faster for sizes up to 512 bytes, just 15%-20% slower for inputs above 1kb.
 *
 *  @param key     Buffer to be hashed.
 *  @param len     @key length, in bytes.
 *  @param seed    64-bit seed used to alter the hash result predictably.
 *
 *  Calls rapidhash_internal using provided parameters and default secrets.
 *
 *  Returns a 64-bit hash.
 */
fn rapidhashMicro_withSeed(key: *u8, len: i64, seed: u64): u64 {
    return rapidhashMicro_internal(key, len, seed, rapid_secret[0].^);
}
 
/*
 *  rapidhashMicro hash function.
 *
 *  @param key     Buffer to be hashed.
 *  @param len     @key length, in bytes.
 *
 *  Calls rapidhash_withSeed using provided parameters and the default seed.
 *
 *  Returns a 64-bit hash.
 */
fn rapidhashMicro(key: *u8, len: i64): u64 {
    return rapidhashMicro_withSeed(key, len, 0);
}

/*
 *  rapidhashNano seeded hash function.
 *
 *  @param key     Buffer to be hashed.
 *  @param len     @key length, in bytes.
 *  @param seed    64-bit seed used to alter the hash result predictably.
 *
 *  Calls rapidhash_internal using provided parameters and default secrets.
 *
 *  Returns a 64-bit hash.
 */
fn rapidhashNano_withSeed(key: *u8, len: i64, seed: u64): u64 {
    return rapidhashNano_internal(key, len, seed, rapid_secret[0].^);
}
 
/*
 *  rapidhashNano hash function.
 *
 *  Designed for Mobile and embedded applications, where keeping a small code size is a top priority.
 *  Clang-18+ compiles it to less than 100 instructions without stack usage, both on x86-64 and aarch64.
 *  The fastest for sizes up to 48 bytes, but may be considerably slower for larger inputs.
 *
 *  @param key     Buffer to be hashed.
 *  @param len     @key length, in bytes.
 *
 *  Calls rapidhash_withSeed using provided parameters and the default seed.
 *
 *  Returns a 64-bit hash.
 */
fn rapidhashNano(key: *u8, len: i64): u64 {
    return rapidhashNano_withSeed(key, len, 0);
}

fn rapidhash(key: []u8): u64 {
    return rapidhash(key.ptr, key.len);
}