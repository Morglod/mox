import "./internal.mox";
import "./slice.mox";

#if (MOX_OS == .Windows) {
    import "./os_win.mox" #export;
} else {
    import "./os_posix.mox" #export;
}

// heap hooks the runtime calls
#linkc fn __mox_mem_alloc(size: i64, align: u32): *u8 {
    return os_heap_alloc(size, align);
}

#linkc fn __mox_mem_realloc(old_mem: *u8, new_size: i64, align: u32): *u8 {
    return os_heap_realloc(old_mem, new_size, align);
}

#linkc fn __mox_mem_free(mem: *u8): void {
    os_heap_free(mem);
}
