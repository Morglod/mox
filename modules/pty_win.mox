import "./internal.mox";
import "./context.mox";
import "./os_win.mox";

// CreatePseudoConsole wants a COORD packed in a u32: cols in the low 16 bits, rows in the high 16
fn _pty_pack_size(cols: u32, rows: u32): u32 { return (cols & 65535) | #shl(rows, 16); }

struct Pty {
    hpc: u64;        // HPCON (pseudo-console)
    in_write: u64;   // parent writes -> child stdin
    out_read: u64;   // parent reads  <- child stdout
    hproc: u64;      // child process
    hthread: u64;
    cols: u32;
    rows: u32;
    alive: bool;
};

// close whatever a failed pty_spawn already created; zero handles are skipped
fn _pty_spawn_cleanup(in_read: u64, in_write: u64, out_read: u64, out_write: u64, hpc: u64): void {
    if (hpc != 0)      { ClosePseudoConsole(hpc.cast(*u8)); }
    if (in_read != 0)  { CloseHandle(in_read.cast(*u8)); }
    if (in_write != 0) { CloseHandle(in_write.cast(*u8)); }
    if (out_read != 0) { CloseHandle(out_read.cast(*u8)); }
    if (out_write != 0){ CloseHandle(out_write.cast(*u8)); }
}

// spawn `cmd` (CreateProcessA needs it writable and NUL-terminated) in a cols x rows pty
fn pty_spawn(cmd: *u8, cols: i64, rows: i64, out: *Pty): bool {
    out.cols = max(cols, 1).cast(u32);
    out.rows = max(rows, 1).cast(u32);
    out.alive = false;
    // zero the handles first, pty_close closes whatever is non-zero
    out.hpc = 0;
    out.in_write = 0;
    out.out_read = 0;
    out.hproc = 0;
    out.hthread = 0;

    in_read: u64 = 0;
    in_write: u64 = 0;
    out_read: u64 = 0;
    out_write: u64 = 0;
    hpc: u64 = 0;
    if (CreatePipe(in_read.^, in_write.^, nullptr(u8), 0) == 0) { return false; }
    if (CreatePipe(out_read.^, out_write.^, nullptr(u8), 0) == 0) {
        _pty_spawn_cleanup(in_read, in_write, 0, 0, 0);
        return false;
    }

    hr := CreatePseudoConsole(_pty_pack_size(out.cols, out.rows), in_read.cast(*u8), out_write.cast(*u8), 0, hpc.^);
    if (hr != 0) {
        _pty_spawn_cleanup(in_read, in_write, out_read, out_write, 0);
        return false;
    }

    // attribute list that hands the pseudo-console to the child
    attr_size: u64 = 0;
    InitializeProcThreadAttributeList(nullptr(u8), 1, 0, attr_size.^); // first call always fails, it only fills attr_size
    attr := #temp_buffer(attr_size.cast(i64)).ptr;
    if (InitializeProcThreadAttributeList(attr, 1, 0, attr_size.^) == 0) {
        _pty_spawn_cleanup(in_read, in_write, out_read, out_write, hpc);
        return false;
    }
    if (UpdateProcThreadAttribute(attr, 0, PROC_THREAD_ATTRIBUTE_PSEUDOCONSOLE, hpc.cast(*u8), 8, nullptr(u8), nullptr(u64)) == 0) {
        DeleteProcThreadAttributeList(attr);
        _pty_spawn_cleanup(in_read, in_write, out_read, out_write, hpc);
        return false;
    }

    siex: STARTUPINFOEXA = 0;
    siex.StartupInfo.cb = sizeof_type(STARTUPINFOEXA).cast(u32);
    siex.lpAttributeList = attr;

    pi: PROCESS_INFORMATION = 0;

    ok := CreateProcessA(nullptr(u8), cmd, nullptr(u8), nullptr(u8), 0, EXTENDED_STARTUPINFO_PRESENT, nullptr(u8), nullptr(u8), siex.^, pi.^);
    if (ok == 0) {
        DeleteProcThreadAttributeList(attr);
        _pty_spawn_cleanup(in_read, in_write, out_read, out_write, hpc);
        return false;
    }

    // the child holds its own reference to hpc once CreateProcess returns, the attribute list can go
    DeleteProcThreadAttributeList(attr);

    // the child ends belong to the pty now
    CloseHandle(in_read.cast(*u8));
    CloseHandle(out_write.cast(*u8));

    out.hpc = hpc;
    out.in_write = in_write;
    out.out_read = out_read;
    out.hproc = pi.hProcess.cast(u64);
    out.hthread = pi.hThread.cast(u64);
    out.alive = true;
    return true;
}

// non-blocking, returns 0 when the child produced nothing yet
fn pty_read(pty: *Pty, buf: *u8, cap: i64): i64 {
    avail: u32 = 0;
    if (PeekNamedPipe(pty.out_read.cast(*u8), nullptr(u8), 0, nullptr(u32), avail.^, nullptr(u32)) == 0) { return 0; }
    if (avail == 0) { return 0; }
    n := min(avail.cast(i64), cap);
    got: u32 = 0;
    ReadFile(pty.out_read.cast(*u8), buf, n.cast(u32), got.^, nullptr(u8));
    return got.cast(i64);
}

fn pty_write(pty: *Pty, buf: *u8, n: i64): void {
    if (n == 0) { return; }
    wr: u32 = 0;
    WriteFile(pty.in_write.cast(*u8), buf, n.cast(u32), wr.^, nullptr(u8)); // input is tiny (keystrokes/paste), no partial-write loop
}

fn pty_alive(pty: *Pty): bool {
    if (!pty.alive) { return false; }
    code: u32 = 0;
    if (GetExitCodeProcess(pty.hproc.cast(*u8), code.^) == 0) { return false; }
    return code == STILL_ACTIVE;
}

// only meaningful after pty_alive() returned false
fn pty_exit_code(pty: *Pty): u32 {
    code: u32 = 0;
    GetExitCodeProcess(pty.hproc.cast(*u8), code.^);
    return code;
}

fn pty_resize(pty: *Pty, cols: i64, rows: i64): void {
    if (!pty.alive) { return; }
    cols_ := max(cols, 1).cast(u32);
    rows_ := max(rows, 1).cast(u32);
    if ((cols_ == pty.cols) && (rows_ == pty.rows)) { return; }
    pty.cols = cols_;
    pty.rows = rows_;
    ResizePseudoConsole(pty.hpc.cast(*u8), _pty_pack_size(cols_, rows_));
}

// releases everything still open, whether the child is running, exited, or already closed (idempotent)
fn pty_close(pty: *Pty): void {
    if (pty.alive) { TerminateProcess(pty.hproc.cast(*u8), 0); } // no-op error if it already exited
    if (pty.hpc != 0)      { ClosePseudoConsole(pty.hpc.cast(*u8)); pty.hpc = 0; }
    if (pty.in_write != 0) { CloseHandle(pty.in_write.cast(*u8)); pty.in_write = 0; }
    if (pty.out_read != 0) { CloseHandle(pty.out_read.cast(*u8)); pty.out_read = 0; }
    if (pty.hproc != 0)    { CloseHandle(pty.hproc.cast(*u8)); pty.hproc = 0; }
    if (pty.hthread != 0)  { CloseHandle(pty.hthread.cast(*u8)); pty.hthread = 0; }
    pty.alive = false;
}
