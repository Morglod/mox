const _FMT_DIGITS2: []u8 = "00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899";

// Division by small constants as multiply-shift,
// see umul128_hi / div10_u64 /div1e8_u64 / div10_u32 / div10000_u32 / div_pow10 in math.mox.
// The ones that only the float code needs stay here.

// valid for the full u64 range
fn _div5_u64(x: u64): u64 {
    h := umul128_hi(x, 14757395258967641293);
    return #shr(h, 2);
}

fn _div1e7_u64(x: u64): u64 {
    h := umul128_hi(x, 15474250491067253437);
    return #shr(h, 23);
}

// valid only while x fits in 32 bits
fn _div100_u32(x: u64): u64 {
    return #shr(x * 1374389535, 37);
}

// store the two ascii chars of nn (0..99) at address p. dt is _FMT_DIGITS2.ptr,
// hoisted by the caller so the global is not reloaded on every store.
fn _fmt_store_pair(p: u64, dt: u64, nn: u64): void {
    if (#is_comptime) {
        p.cast(*u8).* = (dt + nn * 2).cast(*u8).*;
        (p + 1).cast(*u8).* = (dt + nn * 2 + 1).cast(*u8).*;
    } else {
        p.cast(*u16).* = (dt + nn * 2).cast(*u16).*;
    }
}

// true when 5^p divides value (value != 0)
fn _fmt_multiple_of_pow5(value: u64, p: u64): bool {
    count: u64 = 0;
    while (count < p) {
        q := _div5_u64(value);
        if (value - q * 5 != 0) {
            return false;
        }
        value = q;
        count += 1;
    }
    return true;
}

// Write the decimal digits of v (v < 10^17) ending at address endp (exclusive),
// two digits per store. Returns the digit count, digits start at endp - count.
fn _fmt_digits_backward(endp: u64, v: u64): u64 {
    dt := _FMT_DIGITS2.ptr.cast(u64);
    p := endp;
    if (v >= 100000000) {
        q := div1e8_u64(v);
        low := v - q * 100000000;       // low 8 digits, fits in 32 bits
        c1 := div10000_u32(low);
        c0 := low - c1 * 10000;
        d1 := _div100_u32(c0);
        d0 := c0 - d1 * 100;
        p -= 2;
        _fmt_store_pair(p, dt, d0);
        p -= 2;
        _fmt_store_pair(p, dt, d1);
        e1 := _div100_u32(c1);
        e0 := c1 - e1 * 100;
        p -= 2;
        _fmt_store_pair(p, dt, e0);
        p -= 2;
        _fmt_store_pair(p, dt, e1);
        v = q;                          // < 10^9, fits in 32 bits
    }
    while (v >= 10000) {
        q := div10000_u32(v);
        r := v - q * 10000;
        r1 := _div100_u32(r);
        r0 := r - r1 * 100;
        p -= 2;
        _fmt_store_pair(p, dt, r0);
        p -= 2;
        _fmt_store_pair(p, dt, r1);
        v = q;
    }
    if (v >= 100) {
        q := _div100_u32(v);
        r := v - q * 100;
        p -= 2;
        _fmt_store_pair(p, dt, r);
        v = q;
    }
    if (v >= 10) {
        p -= 2;
        _fmt_store_pair(p, dt, v);
    } else {
        p -= 1;
        p.cast(*u8).* = 48 + v.cast(u8);
    }
    return endp - p;
}

// n '0' bytes at p, 8 per store at runtime (the caller's buffer always has
// >= 7 bytes of slack past the true end). Returns p + n.
fn _fmt_fill_zeros(p: u64, n: u64): u64 {
    end := p + n;
    if (#is_comptime) {
        while (p < end) {
            p.cast(*u8).* = 48;
            p += 1;
        }
    } else {
        while (p < end) {
            p.cast(*u64).* = 3472328296227680304;   // "00000000"
            p += 8;
        }
    }
    return end;
}

// copy n digit bytes, 8 per load/store at runtime (same slack contract on both
// buffers). Returns dst + n.
fn _fmt_copy_digits(dst: u64, src: u64, n: u64): u64 {
    out := dst + n;
    if (#is_comptime) {
        mem_copy(dst.cast(*u8), src.cast(*u8), n.cast(i64));
    } else {
        end := src + n;
        while (src < end) {
            dst.cast(*u64).* = src.cast(*u64).*;
            src += 8;
            dst += 8;
        }
    }
    return out;
}

// Render sign * digits * 10^e10 into buf and return the byte length. digits has
// no trailing decimal zeros (Ryu guarantees that; plain 0 never reaches here).
// buf must be >= 40 bytes: at most 32 bytes are meaningful but chunked stores
// touch up to 7 bytes past the returned length.
fn _fmt_layout(buf: *u8, sign: bool, digits: u64, e10: i64): i64 {
    tmp: [32]u8 = #memory_garbage;
    tmp_end := tmp.^.cast(u64) + 24;
    n := _fmt_digits_backward(tmp_end, digits);
    dstart := tmp_end - n;

    base := buf.cast(u64);
    p := base;
    if (sign) {
        p.cast(*u8).* = 45;   // '-'
        p += 1;
    }

    pp := n.cast(i64) + e10;   // decimal point position: value = 0.DDDD * 10^pp
    if (e10 >= 0) {
        if (pp <= 21) {
            // integer: all digits then e10 zeros
            p = _fmt_copy_digits(p, dstart, n);
            p = _fmt_fill_zeros(p, e10.cast(u64));
            return (p - base).cast(i64);
        }
    } else {
        if (pp > 0) {
            // ddd.ddd
            ppu := pp.cast(u64);
            p = _fmt_copy_digits(p, dstart, ppu);
            p.cast(*u8).* = 46;   // '.'
            p += 1;
            p = _fmt_copy_digits(p, dstart + ppu, n - ppu);
            return (p - base).cast(i64);
        }
        if (pp > -6) {
            // 0.000ddd
            p.cast(*u8).* = 48;
            p += 1;
            p.cast(*u8).* = 46;
            p += 1;
            p = _fmt_fill_zeros(p, (0 - pp).cast(u64));
            p = _fmt_copy_digits(p, dstart, n);
            return (p - base).cast(i64);
        }
    }

    // scientific: d.ddde+E / d.ddde-E
    p.cast(*u8).* = dstart.cast(*u8).*;
    p += 1;
    if (n > 1) {
        p.cast(*u8).* = 46;
        p += 1;
        p = _fmt_copy_digits(p, dstart + 1, n - 1);
    }
    dt := _FMT_DIGITS2.ptr.cast(u64);
    p.cast(*u8).* = 101;   // 'e'
    p += 1;
    ee := pp - 1;
    if (ee < 0) {
        p.cast(*u8).* = 45;
        p += 1;
        ee = 0 - ee;
    } else {
        p.cast(*u8).* = 43;   // '+'
        p += 1;
    }
    e := ee.cast(u64);
    if (e >= 100) {
        h := _div100_u32(e);
        r := e - h * 100;
        p.cast(*u8).* = 48 + h.cast(u8);
        p += 1;
        _fmt_store_pair(p, dt, r);
        p += 2;
    } else {
        if (e >= 10) {
            _fmt_store_pair(p, dt, e);
            p += 2;
        } else {
            p.cast(*u8).* = 48 + e.cast(u8);
            p += 1;
        }
    }
    return (p - base).cast(i64);
}

// Ryu d2s core: shortest round-trip decimal for a f64.
// buf must be >= 40 bytes (see _fmt_layout). Returns the byte length.
fn _format_f64_to_buf(buf: *u8, value: f64): i64 {
    bits := value.^.cast(*u64).*;
    sign := #shr(bits, 63) != 0;
    ieee_exp := #shr(bits, 52) & 2047;
    ieee_mant := bits & 4503599627370495;     // 2^52 - 1

    p := buf.cast(u64);
    if (ieee_exp == 2047) {
        if (ieee_mant != 0) {
            p.cast(*u8).* = 110;         // "nan"
            (p + 1).cast(*u8).* = 97;
            (p + 2).cast(*u8).* = 110;
            return 3;
        }
        if (sign) {
            p.cast(*u8).* = 45;
            p += 1;
        }
        p.cast(*u8).* = 105;             // "inf"
        (p + 1).cast(*u8).* = 110;
        (p + 2).cast(*u8).* = 102;
        return (p + 3 - buf.cast(u64)).cast(i64);
    }
    if (ieee_exp == 0 && ieee_mant == 0) {
        if (sign) {
            p.cast(*u8).* = 45;
            (p + 1).cast(*u8).* = 48;
            return 2;
        }
        p.cast(*u8).* = 48;
        return 1;
    }

    // decode into m2 * 2^e2, pre-scaled by 4 (the Ryu -2 convention)
    e2: i64 = -1076;
    m2: u64 = ieee_mant;
    if (ieee_exp != 0) {
        e2 = ieee_exp.cast(i64) - 1077;
        m2 = 4503599627370496 + ieee_mant;   // 2^52 | mant
    }

    // fast path: exact integer < 2^53 (very common). Shift the fraction out and
    // strip trailing decimal zeros, the Ryu core is not needed.
    e2i := e2 + 2;
    if (ieee_exp != 0 && e2i <= 0 && e2i >= -52) {
        shift := (0 - e2i).cast(u64);
        mask := #shl(1 .cast(u64), shift) - 1;
        if ((m2 & mask) == 0) {
            d := #shr(m2, shift);
            e10s: i64 = 0;
            while (true) {
                qz := div10_u64(d);
                if (d - qz * 10 != 0) {
                    break;
                }
                d = qz;
                e10s += 1;
            }
            return _fmt_layout(buf, sign, d, e10s);
        }
    }

    even := (m2 & 1) == 0;
    mv := 4 * m2;
    mm_shift: u64 = 0;
    if (ieee_mant != 0 || ieee_exp <= 1) {
        mm_shift = 1;
    }

    e10: i64 = 0;
    q: u64 = 0;
    mul_lo: u64 = 0;
    mul_hi: u64 = 0;
    j: i64 = 0;
    if (e2 >= 0) {
        e2u := e2.cast(u64);
        q = #shr(e2u * 78913, 18);           // floor(e2 * log10(2))
        if (e2u > 3) {
            q -= 1;
        }
        e10 = q.cast(i64);
        k := #shr(q * 1217359, 19) + 125;    // INV_BITCOUNT + pow5bits(q) - 1
        j = q.cast(i64) + k.cast(i64) - e2;
        mul_lo = _RYU_D_POW5_INV_LO[q];
        mul_hi = _RYU_D_POW5_INV_HI[q];
    } else {
        ne2 := (0 - e2).cast(u64);
        q = #shr(ne2 * 732923, 20);          // floor(-e2 * log10(5))
        if (ne2 > 1) {
            q -= 1;
        }
        e10 = q.cast(i64) + e2;
        i5 := ne2 - q;
        k := (#shr(i5 * 1217359, 19) + 1).cast(i64) - 125;   // pow5bits(i5) - BITCOUNT
        j = q.cast(i64) - k;
        mul_lo = _RYU_D_POW5_LO[i5];
        mul_hi = _RYU_D_POW5_HI[i5];
    }

    // (vm, vr, vp) = ((mv - 1 - mm_shift, mv, mv + 2) * mul) >> j from a single
    // 192-bit product (2*m2) * mul plus cheap add/sub corrections
    // (Ryu mulShiftAll64, the variant without native 128-bit ints)
    // low 64-bit halves of the 192-bit product wrap BY DESIGN, and the
    // carry/borrow checks below read the wrapped values - #wrap_add/#wrap_sub/
    // #wrap_mul, never plain + - * (whose default assumes no overflow).
    mtwo := 2 * m2;
    lo := #wrap_mul(mtwo, mul_lo);
    tmp_hi := umul128_hi(mtwo, mul_lo);
    mid := #wrap_add(tmp_hi, #wrap_mul(mtwo, mul_hi));
    hi := umul128_hi(mtwo, mul_hi);
    if (mid < tmp_hi) {
        hi += 1;
    }

    js := (j - 65).cast(u64);   // shift for the 2x-scaled halves; in (0, 64)
    jinv := 64 - js;
    vr := #shl(hi, jinv) | #shr(mid, js);

    lo2 := #wrap_add(lo, mul_lo);
    mid2 := #wrap_add(mid, mul_hi);
    if (lo2 < lo) {
        mid2 = #wrap_add(mid2, 1);
    }
    hi2 := hi;
    if (mid2 < mid) {
        hi2 += 1;
    }
    vp := #shl(hi2, jinv) | #shr(mid2, js);

    vm: u64 = 0;
    if (mm_shift == 1) {
        lo3 := #wrap_sub(lo, mul_lo);
        mid3 := #wrap_sub(mid, mul_hi);
        if (lo3 > lo) {
            mid3 = #wrap_sub(mid3, 1);
        }
        hi3 := hi;
        if (mid3 > mid) {
            hi3 -= 1;
        }
        vm = #shl(hi3, jinv) | #shr(mid3, js);
    } else {
        lo3 := #wrap_add(lo, lo);
        mid3 := #wrap_add(mid, mid);
        if (lo3 < lo) {
            mid3 = #wrap_add(mid3, 1);
        }
        hi3 := hi + hi;
        if (mid3 < mid) {
            hi3 += 1;
        }
        lo4 := #wrap_sub(lo3, mul_lo);
        mid4 := #wrap_sub(mid3, mul_hi);
        if (lo4 > lo3) {
            mid4 = #wrap_sub(mid4, 1);
        }
        hi4 := hi3;
        if (mid4 > mid3) {
            hi4 -= 1;
        }
        js2 := (j - 64).cast(u64);
        vm = #shl(hi4, 64 - js2) | #shr(mid4, js2);
    }

    vm_tz := false;
    vr_tz := false;
    if (e2 >= 0) {
        if (q <= 21) {
            qd := _div5_u64(mv);
            if (mv - qd * 5 == 0) {
                vr_tz = _fmt_multiple_of_pow5(mv, q);
            } else {
                if (even) {
                    vm_tz = _fmt_multiple_of_pow5(mv - 1 - mm_shift, q);
                } else {
                    if (_fmt_multiple_of_pow5(mv + 2, q)) {
                        vp -= 1;
                    }
                }
            }
        }
    } else {
        if (q <= 1) {
            vr_tz = true;
            if (even) {
                vm_tz = mm_shift == 1;
            } else {
                vp -= 1;
            }
        } else {
            if (q < 63) {
                mask := #shl(1 .cast(u64), q) - 1;
                vr_tz = (mv & mask) == 0;
            }
        }
    }

    removed: u64 = 0;
    last_removed: u64 = 0;
    out: u64 = 0;
    if (vm_tz || vr_tz) {
        // rare path: the value sits exactly on decimal boundaries, so trailing
        // zeros must be tracked while removing digits. Jump 8 digits at once
        // first (floor division is monotone, so vp/10^8 > vm/10^8 means all 8
        // single steps would run anyway), then u64 steps, then cheaper u32
        // steps once vp fits in 32 bits.
        while (true) {
            vpd8 := div1e8_u64(vp);
            // vpd8 > vm/10^8 iff vpd8*10^8 > vm: one division + mul-compare
            if (vpd8 * 100000000 <= vm) {
                break;
            }
            vmd8 := div1e8_u64(vm);
            vrd7 := _div1e7_u64(vr);
            vrd8 := div10_u64(vrd7);
            if (vm - vmd8 * 100000000 != 0) {
                vm_tz = false;
            }
            if (last_removed != 0 || vr - vrd7 * 10000000 != 0) {
                vr_tz = false;
            }
            last_removed = vrd7 - vrd8 * 10;
            vr = vrd8;
            vp = vpd8;
            vm = vmd8;
            removed += 8;
        }
        stop := false;
        while (vp >= 4294967296) {
            vpd := div10_u64(vp);
            vmd := div10_u64(vm);
            if (vpd <= vmd) {
                stop = true;
                break;
            }
            vrd := div10_u64(vr);
            if (vm - vmd * 10 != 0) {
                vm_tz = false;
            }
            if (last_removed != 0) {
                vr_tz = false;
            }
            last_removed = vr - vrd * 10;
            vr = vrd;
            vp = vpd;
            vm = vmd;
            removed += 1;
        }
        while (!stop) {
            vpd := div10_u32(vp);
            vmd := div10_u32(vm);
            if (vpd <= vmd) {
                break;
            }
            vrd := div10_u32(vr);
            if (vm - vmd * 10 != 0) {
                vm_tz = false;
            }
            if (last_removed != 0) {
                vr_tz = false;
            }
            last_removed = vr - vrd * 10;
            vr = vrd;
            vp = vpd;
            vm = vmd;
            removed += 1;
        }
        if (vm_tz) {
            while (true) {
                vmd := div10_u64(vm);
                if (vm - vmd * 10 != 0) {
                    break;
                }
                vpd := div10_u64(vp);
                vrd := div10_u64(vr);
                if (last_removed != 0) {
                    vr_tz = false;
                }
                last_removed = vr - vrd * 10;
                vr = vrd;
                vp = vpd;
                vm = vmd;
                removed += 1;
            }
        }
        if (vr_tz && last_removed == 5 && (vr & 1) == 0) {
            last_removed = 4;   // round half to even
        }
        inc: u64 = 0;
        if (last_removed >= 5) {
            inc = 1;
        }
        if (vr == vm && (!even || !vm_tz)) {
            inc = 1;
        }
        out = vr + inc;
    } else {
        // common path. Only vp/vm drive the loop, the digits removed from vr
        // matter only for the final rounding, so vr is divided by 10^removed
        // once at the end instead of every iteration. Same 8-digit jumps, then
        // u64 steps, then u32 steps.
        while (true) {
            vpd8 := div1e8_u64(vp);
            // vpd8 > vm/10^8 iff vpd8*10^8 > vm: one division + mul-compare
            if (vpd8 * 100000000 <= vm) {
                break;
            }
            vp = vpd8;
            vm = div1e8_u64(vm);
            removed += 8;
        }
        stop := false;
        while (vp >= 4294967296) {
            vpd := div10_u64(vp);
            vmd := div10_u64(vm);
            if (vpd <= vmd) {
                stop = true;
                break;
            }
            vp = vpd;
            vm = vmd;
            removed += 1;
        }
        while (!stop) {
            vpd := div10_u32(vp);
            vmd := div10_u32(vm);
            if (vpd <= vmd) {
                break;
            }
            vp = vpd;
            vm = vmd;
            removed += 1;
        }
        round_up := false;
        if (removed != 0) {
            vr_prev := div_pow10(vr, removed - 1);   // vr / 10^(removed-1)
            vrd := div10_u64(vr_prev);
            round_up = vr_prev - vrd * 10 >= 5;
            vr = vrd;
        }
        inc: u64 = 0;
        if (vr == vm || round_up) {
            inc = 1;
        }
        out = vr + inc;
    }
    return _fmt_layout(buf, sign, out, e10 + removed.cast(i64));
}

// ((m * factor) >> shift) where factor is 64-bit, m < 2^26, 32 < shift < 64
fn _f32_mulshift(m: u64, factor: u64, shift: u64): u64 {
    b0 := m * (factor & 4294967295);
    b1 := m * #shr(factor, 32);
    return #shr(#shr(b0, 32) + b1, shift - 32);
}

// Ryu f2s core: shortest round-trip decimal for a f32. Not the f64 shortest,
// that is the point: fewer digits and only 64-bit arithmetic.
fn _format_f32_to_buf(buf: *u8, value: f32): i64 {
    bits := value.^.cast(*u32).*.cast(u64);
    sign := #shr(bits, 31) != 0;
    ieee_exp := #shr(bits, 23) & 255;
    ieee_mant := bits & 8388607;      // 2^23 - 1

    p := buf.cast(u64);
    if (ieee_exp == 255) {
        if (ieee_mant != 0) {
            p.cast(*u8).* = 110;         // "nan"
            (p + 1).cast(*u8).* = 97;
            (p + 2).cast(*u8).* = 110;
            return 3;
        }
        if (sign) {
            p.cast(*u8).* = 45;
            p += 1;
        }
        p.cast(*u8).* = 105;             // "inf"
        (p + 1).cast(*u8).* = 110;
        (p + 2).cast(*u8).* = 102;
        return (p + 3 - buf.cast(u64)).cast(i64);
    }
    if (ieee_exp == 0 && ieee_mant == 0) {
        if (sign) {
            p.cast(*u8).* = 45;
            (p + 1).cast(*u8).* = 48;
            return 2;
        }
        p.cast(*u8).* = 48;
        return 1;
    }

    e2: i64 = -151;
    m2: u64 = ieee_mant;
    if (ieee_exp != 0) {
        e2 = ieee_exp.cast(i64) - 152;
        m2 = 8388608 + ieee_mant;     // 2^23 | mant
    }

    even := (m2 & 1) == 0;
    mv := 4 * m2;
    mp := mv + 2;
    mm_shift: u64 = 0;
    if (ieee_mant != 0 || ieee_exp <= 1) {
        mm_shift = 1;
    }
    mm := mv - 1 - mm_shift;

    vr: u64 = 0;
    vp: u64 = 0;
    vm: u64 = 0;
    e10: i64 = 0;
    q: u64 = 0;
    vm_tz := false;
    vr_tz := false;
    last_removed: u64 = 0;
    if (e2 >= 0) {
        e2u := e2.cast(u64);
        q = #shr(e2u * 78913, 18);
        e10 = q.cast(i64);
        k := #shr(q * 1217359, 19) + 59;    // INV_BITCOUNT + pow5bits(q) - 1
        sh := (q.cast(i64) + k.cast(i64) - e2).cast(u64);
        f := _RYU_F_POW5_INV[q];
        vr = _f32_mulshift(mv, f, sh);
        vp = _f32_mulshift(mp, f, sh);
        vm = _f32_mulshift(mm, f, sh);
        if (q != 0) {
            vpd1 := div10_u32(vp - 1);
            vmd1 := div10_u32(vm);
            if (vpd1 <= vmd1) {
                // one digit will be removed before the loop even runs; peek it
                k1 := #shr((q - 1) * 1217359, 19) + 59;
                sh1 := ((q - 1).cast(i64) + k1.cast(i64) - e2).cast(u64);
                lr := _f32_mulshift(mv, _RYU_F_POW5_INV[q - 1], sh1);
                lrd := div10_u32(lr);
                last_removed = lr - lrd * 10;
            }
        }
        if (q <= 9) {
            qd := _div5_u64(mv);
            if (mv - qd * 5 == 0) {
                vr_tz = _fmt_multiple_of_pow5(mv, q);
            } else {
                if (even) {
                    vm_tz = _fmt_multiple_of_pow5(mm, q);
                } else {
                    if (_fmt_multiple_of_pow5(mp, q)) {
                        vp -= 1;
                    }
                }
            }
        }
    } else {
        ne2 := (0 - e2).cast(u64);
        q = #shr(ne2 * 732923, 20);
        e10 = q.cast(i64) + e2;
        i5 := ne2 - q;
        k := (#shr(i5 * 1217359, 19) + 1).cast(i64) - 61;   // pow5bits(i5) - BITCOUNT
        jj := (q.cast(i64) - k).cast(u64);
        f := _RYU_F_POW5[i5];
        vr = _f32_mulshift(mv, f, jj);
        vp = _f32_mulshift(mp, f, jj);
        vm = _f32_mulshift(mm, f, jj);
        if (q != 0) {
            vpd1 := div10_u32(vp - 1);
            vmd1 := div10_u32(vm);
            if (vpd1 <= vmd1) {
                j1 := q.cast(i64) - 1 - ((#shr((i5 + 1) * 1217359, 19) + 1).cast(i64) - 61);
                lr := _f32_mulshift(mv, _RYU_F_POW5[i5 + 1], j1.cast(u64));
                lrd := div10_u32(lr);
                last_removed = lr - lrd * 10;
            }
        }
        if (q <= 1) {
            vr_tz = true;
            if (even) {
                vm_tz = mm_shift == 1;
            } else {
                vp -= 1;
            }
        } else {
            if (q < 31) {
                mask := #shl(1 .cast(u64), q - 1) - 1;
                vr_tz = (mv & mask) == 0;
            }
        }
    }

    removed: u64 = 0;
    out: u64 = 0;
    if (vm_tz || vr_tz) {
        while (true) {
            vpd := div10_u32(vp);
            vmd := div10_u32(vm);
            if (vpd <= vmd) {
                break;
            }
            vrd := div10_u32(vr);
            if (vm - vmd * 10 != 0) {
                vm_tz = false;
            }
            if (last_removed != 0) {
                vr_tz = false;
            }
            last_removed = vr - vrd * 10;
            vr = vrd;
            vp = vpd;
            vm = vmd;
            removed += 1;
        }
        if (vm_tz) {
            while (true) {
                vmd := div10_u32(vm);
                if (vm - vmd * 10 != 0) {
                    break;
                }
                vpd := div10_u32(vp);
                vrd := div10_u32(vr);
                if (last_removed != 0) {
                    vr_tz = false;
                }
                last_removed = vr - vrd * 10;
                vr = vrd;
                vp = vpd;
                vm = vmd;
                removed += 1;
            }
        }
        if (vr_tz && last_removed == 5 && (vr & 1) == 0) {
            last_removed = 4;   // round half to even
        }
        inc: u64 = 0;
        if (last_removed >= 5) {
            inc = 1;
        }
        if (vr == vm && (!even || !vm_tz)) {
            inc = 1;
        }
        out = vr + inc;
    } else {
        while (true) {
            vpd := div10_u32(vp);
            vmd := div10_u32(vm);
            if (vpd <= vmd) {
                break;
            }
            vrd := div10_u32(vr);
            last_removed = vr - vrd * 10;
            vr = vrd;
            vp = vpd;
            vm = vmd;
            removed += 1;
        }
        inc: u64 = 0;
        if (vr == vm || last_removed >= 5) {
            inc = 1;
        }
        out = vr + inc;
    }
    return _fmt_layout(buf, sign, out, e10 + removed.cast(i64));
}
