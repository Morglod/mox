import "internal.mox";
import "./os_posix.mox";
import "./process_tree_posix.mox";
import "./alloc.mox";
import "./context.mox";

struct Pty {
    master: i32;     // pty master fd (non-blocking)
    pid: i32;        // child pid
    cols: u32;
    rows: u32;
    alive: bool;
    exit: OsWaitResult; // .running until the child is reaped
};

fn _pty_set_winsize(fd: i32, cols: u32, rows: u32): void {
    ws: PosixWinSize = 0;
    ws.ws_col = cols.cast(u16);
    ws.ws_row = rows.cast(u16);
    posix_ioctl(fd, POSIX_TIOCSWINSZ, ws.^.cast(*u8));
}

// spawn `cmd` (NULL-terminated) as `/bin/sh -c cmd` in a cols x rows pty. alloc is not used here (windows keeps its input buffer on it).
fn pty_spawn(cmd: *u8, cols: i64, rows: i64, out: *Pty, alloc: *Alloc = get_context_alloc()): bool {
    out.cols = max(cols, 1).cast(u32);
    out.rows = max(rows, 1).cast(u32);
    out.alive = false;
    out.exit.status = .failed; // a pty that never started
    out.exit.exit_code = 0;
    // set master invalid first, pty_close closes it when it is a valid fd
    out.master = POSIX_NO_FD;
    out.pid = 0;

    master := posix_openpt(POSIX_O_RDWR | POSIX_O_NOCTTY);
    if (master < 0) { return false; }
    posix_fcntl(master, POSIX_F_SETFD, POSIX_FD_CLOEXEC); // other children must not keep the terminal open
    if (posix_grantpt(master) != 0) { posix_close(master); return false; }
    if (posix_unlockpt(master) != 0) { posix_close(master); return false; }
    slave_name := posix_ptsname(master);
    if (slave_name == 0) { posix_close(master); return false; }

    pid := posix_fork();
    if (pid < 0) { posix_close(master); return false; }

    if (pid == 0) {
        // child: new session, slave tty becomes the controlling terminal and all of stdio
        posix_setsid();
        slave := #posix_retry(#ast posix_open(slave_name, POSIX_O_RDWR, 0)).cast(i32);
        if (slave < 0) { posix_exit_now(127); }
        posix_ioctl(slave, POSIX_TIOCSCTTY, nullptr(u8));
        posix_dup2(slave, 0);
        posix_dup2(slave, 1);
        posix_dup2(slave, 2);
        if (slave > 2) { posix_close(slave); }
        posix_close(master);
        _posix_child_close_from_3();

        sh := "/bin/sh";
        dash_c := "-c";
        argv: [4]*u8 = .{ sh.ptr; dash_c.ptr; cmd; nullptr(u8); };
        posix_execvp(sh.ptr, argv.ptr.cast(*u8));
        posix_exit_now(127);
    }

    // parent
    _pty_set_winsize(master, out.cols, out.rows);
    posix_fcntl(master, POSIX_F_SETFL, POSIX_O_NONBLOCK);
    out.master = master;
    out.pid = pid;
    out.alive = true;
    out.exit.status = .running;
    return true;
}

// non-blocking, returns 0 when the child produced nothing yet
fn pty_read(pty: *Pty, buf: *u8, cap: i64): i64 {
    if (pty.master < 0) { return 0; }
    r := posix_read(pty.master, buf, cap.cast(u64));
    if (r <= 0) { return 0; }
    return r;
}

// writes what fits now without blocking: returns the bytes taken (0 = input buffer full, send the rest later), -1 on error
fn pty_write(pty: *Pty, buf: *u8, n: i64): i64 {
    if (n <= 0) { return 0; }
    if (pty.master < 0) { return -1; }
    w := #posix_retry(#ast posix_write(pty.master, buf, n.cast(u64)));
    if (w >= 0) { return w; }
    if (_posix_errno() == POSIX_EAGAIN) { return 0; }
    return -1;
}

// writes all of buf, waiting while the child does not read its input.
// Blocks until the child reads: with echo on, a caller that does not read the output meanwhile can wait forever.
fn pty_write_all(pty: *Pty, buf: *u8, n: i64): bool {
    off: i64 = 0;
    while (off < n) {
        w := pty_write(pty, byte_offset(buf, off), n - off);
        if (w < 0) { return false; }
        if (w == 0) {
            p: PosixPollFd = 0;
            p.fd = pty.master;
            p.events = POSIX_POLLOUT;
            if ((posix_poll(p.^, 1, -1) < 0) && (_posix_errno() != POSIX_EINTR)) { return false; }
            continue;
        }
        off += w;
    }
    return true;
}

// reaps the child once it exits, and keeps its exit code for pty_exit_code
fn pty_alive(pty: *Pty): bool {
    if (!pty.alive) { return false; }
    wr := os_wait_process_exit(pty.pid.cast(u64), 0);
    if (wr.status == .running) { return true; }
    pty.exit = wr;
    pty.alive = false;
    return false;
}

// .running while the child runs; exit_code is 128+signal when it was killed by a signal
fn pty_exit_code(pty: *Pty): OsWaitResult {
    return pty.exit;
}

fn pty_resize(pty: *Pty, cols: i64, rows: i64): void {
    if (!pty.alive) { return; }
    cols_ := max(cols, 1).cast(u32);
    rows_ := max(rows, 1).cast(u32);
    if ((cols_ == pty.cols) && (rows_ == pty.rows)) { return; }
    pty.cols = cols_;
    pty.rows = rows_;
    _pty_set_winsize(pty.master, cols_, rows_);
}

fn pty_close(pty: *Pty): void {
    if (!pty.alive) {
        if (pty.master >= 0) { posix_close(pty.master); pty.master = POSIX_NO_FD; }
        return;
    }
    os_kill_tree(pty.pid.cast(u64)); // the shell and everything it started
    pty.exit = os_wait_process_exit(pty.pid.cast(u64), -1);
    posix_close(pty.master);
    pty.master = POSIX_NO_FD;
    pty.alive = false;
}
