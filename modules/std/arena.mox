import "internal.mox";
import "./alloc.mox";
import "./panic.mox";
import "./os.mox";

enum ArenaFlags : u8 {
    NONE := 0;
    IS_FIXED := 1;
    IS_VIRTUAL := 2;
};

struct Arena {
    interface: Alloc;
    pos: i64;
    commit_pos: i64;
    commit_size: i64;
    reserve_size: i64;
    flags: ArenaFlags;
    last_pos: i64;
    // debug_name: *u8;
    // prev: *Arena;
    // next: *Arena;
};

const ARENA_ALIGN : i64 = 8;
const ARENA_ZERO_ON_POP : bool = false;

fn arena_ptr_at(arena: *Arena, pos: i64): *u8 {
    return arena.cast(*u8) |> byte_offset(pos);
}

fn arena_create_fixed(buf: []u8): *Arena {
    base_pos := align_up(sizeof_type(Arena), ARENA_ALIGN);
    skip := (align_up(buf.ptr.cast(u64), ARENA_ALIGN.cast(u64)) - buf.ptr.cast(u64)).cast(i64);
    size := buf.len - skip;

    if (base_pos >= size) {
        panic("not enough buffer size, even to handle Arena type itself");
    }

    arena := byte_offset(buf.ptr, skip).cast(*Arena);
    arena.pos = base_pos;
    arena.commit_pos = size;
    arena.commit_size = size;
    arena.reserve_size = size;
    arena.flags = .IS_FIXED;
    arena.last_pos = 0;
    arena.interface.func = _arena_alloc_fn.^;

    return arena;
}

fn arena_create_virtual(reserve_size: i64, commit_size: i64): *Arena {
    os_page_size := os_get_memory_page_size();

    reserve_size = align_up(reserve_size, os_page_size);
    commit_size = align_up(commit_size, os_page_size);

    reserved_mem := os_mem_virtual_reserve(reserve_size);
    if (reserved_mem == 0) {
        panic("arena reserve of {} bytes failed", .{ reserve_size; });
    }
    if (!os_mem_virtual_commit(reserved_mem, commit_size)) {
        panic("arena commit of {} bytes failed", .{ commit_size; });
    }

    arena: *Arena = reserved_mem.cast(*Arena);

    arena.commit_pos = commit_size;
    arena.commit_size = commit_size;
    arena.reserve_size = reserve_size;
    arena.flags = .IS_VIRTUAL;
    arena.last_pos = 0;
    arena.interface.func = _arena_alloc_fn.^;

    arena.pos = align_up(sizeof_type(Arena), ARENA_ALIGN);

    return arena;
}

fn arena_destroy(arena: *Arena): void {
    if ((arena.flags & .IS_VIRTUAL) != .NONE) {
        os_mem_virtual_release(arena.cast(*u8), arena.reserve_size);
    }
}

fn _arena_set_pos(arena: *Arena, new_pos: i64, size: i64): void {
    if (new_pos > arena.reserve_size) {
        panic("arena exceeds reserved size. new_pos={} requested_size={} reserve_size={}", .{ new_pos; size; arena.reserve_size; });
    }

    if (new_pos > arena.commit_pos) {
        new_commit_pos := align_up(new_pos, arena.commit_size);
        new_commit_pos = min(new_commit_pos, arena.reserve_size);
        if (!os_mem_virtual_commit(arena |> arena_ptr_at(arena.commit_pos), new_commit_pos - arena.commit_pos)) {
            panic("arena commit of {} bytes failed", .{ new_commit_pos - arena.commit_pos; });
        }
        arena.commit_pos = new_commit_pos;
    }

    arena.pos = new_pos;
}

fn arena_push(arena: *Arena, size: i64, align: u32 = 1): []u8 {
    // aligns the address, not the offset: a fixed arena's base is only ARENA_ALIGN-aligned
    base := arena.cast(u64);
    start_pos := (align_up(base + arena.pos.cast(u64), align.cast(u64)) - base).cast(i64);
    _arena_set_pos(arena, align_up(start_pos + size, ARENA_ALIGN), size);
    arena.last_pos = start_pos;

    s : []u8 = #memory_garbage;
    s.ptr = arena_ptr_at(arena, start_pos);
    s.len = size;

    return s;
}

// The newest block is resized in place.
// Any other block is copied to a new one; its old size is unknown,
// so everything from it up to the top is copied (capped by new_size),
// which is always readable arena memory.
fn arena_realloc(arena: *Arena, old_mem: *u8, new_size: i64, align: u32 = 1): []u8 {
    if (old_mem == nullptr(u8)) {
        return arena_push(arena, new_size, align);
    }

    old_pos := (old_mem.cast(u64) - arena.cast(u64)).cast(i64);
    if (old_pos == arena.last_pos && old_mem.cast(u64) % align.cast(u64) == 0) {
        _arena_set_pos(arena, align_up(old_pos + new_size, ARENA_ALIGN), new_size);
        s : []u8 = #memory_garbage;
        s.ptr = old_mem;
        s.len = new_size;
        return s;
    }

    copy_size := max(min(new_size, arena.pos - old_pos), 0i64);
    out := arena_push(arena, new_size, align);
    mem_copy(out.ptr, old_mem, copy_size);
    return out;
}

// only the newest block gives its memory back, freeing any other block does nothing
fn arena_free(arena: *Arena, mem: *u8): void {
    if (mem == nullptr(u8)) { return; }
    pos := (mem.cast(u64) - arena.cast(u64)).cast(i64);
    if (pos == arena.last_pos) {
        arena.pos = pos;
        arena.last_pos = 0;
    }
}

fn arena_push(arena: *Arena, $T: __type_ptr, align: u32 = 0): *$T {
    if (align == 0) { align = alignof_type(#type $T); }
    ptr := arena_push(arena, sizeof_type($T), align).ptr;
    return ptr.cast(*$T);
}

fn arena_push_copy(arena: *Arena, value: $T, align: u32 = 0): *$T {
    if (align == 0) { align = alignof_type(#type $T); }
    ptr := arena_push(arena, $T, align);
    ptr.* = value;
    return ptr;
}

fn arena_push_slice(arena: *Arena, $T: __type_ptr, len: i64, align: u32 = 0): []$T {
    if (align == 0) { align = alignof_type(#type $T); }
    ptr := arena_push(arena, sizeof_type($T) * len, align).ptr;
    out: []$T = #memory_garbage;
    out.ptr = ptr.cast(*$T);
    out.len = len;
    return out;
}

// copies s onto the arena
fn arena_push_slice_copy(arena: *Arena, s: []$T, align: u32 = 0): []$T {
    if (align == 0) { align = alignof_type($T); }
    elem_size := sizeof_type($T);
    mem := arena_push(arena, elem_size * s.len, align);
    mem_copy(mem.ptr, s.ptr.cast(*u8), elem_size * s.len);
    out: []$T = #memory_garbage;
    out.ptr = mem.ptr.cast(*$T);
    out.len = s.len;
    return out;
}

fn arena_push_str_copy(arena: *Arena, s: []u8): []u8 {
    return arena_push_slice_copy(arena, s, 1);
}

// copies as a C string: NUL-terminated, and the NUL is counted in the returned slice's len
fn arena_push_str_copy_c(arena: *Arena, s: []u8): []u8 {
    mem := arena_push(arena, s.len + 1, 1);
    mem_copy(mem.ptr, s.ptr, s.len);
    mem[s.len] = 0;
    return mem;
}

fn arena_pop_to(arena: *Arena, new_pos: i64, size: i64): void {
    arena.pos = new_pos;
    arena.last_pos = 0;
    #if (ARENA_ZERO_ON_POP) {
        mem_zero(arena_ptr_at(arena, new_pos), size);
    }
}

fn arena_pop_to(arena: *Arena, pos: i64): void {
    if (pos > arena.pos) {
        panic("arena_pop_to received pos over current arena.pos");
    }
    arena_pop_to(arena, pos, arena.pos - pos);
}

fn arena_pop(arena: *Arena, size: i64): void {
    arena_pop_to(arena, arena.pos - size, size);
}

fn arena_current_pos(arena: *Arena): i64 {
    return arena.pos;
}

fn arena_clear(arena: *Arena): void {
    arena.pos = sizeof_type(Arena) |> align_up(ARENA_ALIGN);
    arena.last_pos = 0;
}

fn _arena_alloc_fn(self: *Alloc, mode: AllocatorFnMode, size: i64, align: u32, old_mem: *u8): *u8 {
    arena := self.cast(*Arena);

    if (mode == .alloc) {
        return arena_push(arena, size, align).ptr;
    }
    if (mode == .realloc) {
        return arena_realloc(arena, old_mem, size, align).ptr;
    }
    if (mode == .free) {
        arena_free(arena, old_mem);
    }
    if (mode == .get_arena) {
        return arena.cast(*u8);
    }
    return nullptr(u8);
}

fn arena_as_allocator(arena: *Arena): *Alloc {
    return arena.interface.^;
}

// the arena behind an allocator made by arena_as_allocator; nullptr for any other allocator
fn arena_from_allocator(alloc: *Alloc): *Arena {
    if (alloc == nullptr(Alloc)) { return nullptr(Arena); }
    if (alloc.func != _arena_alloc_fn.^) { return nullptr(Arena); }
    return alloc.cast(*Arena);
}
