// ---- portable OS API ----
// Same signatures as os_posix.mox. Import "./os.mox", it lands the module matching the build target.

// virtual memory pages

fn os_get_memory_page_size(): i64 {
    return win_get_page_size_cached().cast(i64);
}

fn os_mem_virtual_reserve(size: i64): *u8 {
    return win_virtual_alloc(nullptr(u8), size.cast(u64), 8192, 4); // MEM_RESERVE, PAGE_READWRITE
}

fn os_mem_virtual_commit(ptr: *u8, size: i64): bool {
    ok := win_virtual_alloc(ptr, size.cast(u64), 4096, 4); // MEM_COMMIT
    return ok != 0;
}

fn os_mem_virtual_decommit(ptr: *u8, size: i64): bool {
    ok := win_virtual_free(ptr, size.cast(u64), 16384); // MEM_DECOMMIT
    return ok != 0;
}

// size exists only for posix munmap parity.
// MEM_RELEASE requires dwSize == 0 and always frees the whole reserved region; a real size makes VirtualFree fail and free nothing.
fn os_mem_virtual_release(ptr: *u8, size: i64): bool {
    ok := win_virtual_free(ptr, 0, 32768); // MEM_RELEASE, dwSize must be 0
    return ok != 0;
}

// heap

#linkc("_aligned_malloc")  fn win_aligned_malloc(size: u64, align: u64): *u8;
#linkc("_aligned_realloc") fn win_aligned_realloc(mem: *u8, size: u64, align: u64): *u8;
#linkc("_aligned_free")    fn win_aligned_free(mem: *u8): void;
#linkc("ExitProcess")      fn ExitProcess(code: u32): void;

fn os_heap_alloc(size: i64, align: u32): *u8 {
    a := align.cast(u64);
    if (a < 8) { a = 8; }
    return win_aligned_malloc(size.cast(u64), a);
}

fn os_heap_realloc(mem: *u8, new_size: i64, align: u32): *u8 {
    a := align.cast(u64);
    if (a < 8) { a = 8; }
    return win_aligned_realloc(mem, new_size.cast(u64), a);
}

fn os_heap_free(mem: *u8): void {
    win_aligned_free(mem);
}

fn os_abort(): void {
    ExitProcess(3);
}

// thread local storage: one pointer per thread per key.
// FLS instead of TlsAlloc: only FLS runs the destructor on thread exit.

const OsTlsKey  := #type u64;                                  // wraps an FLS index (DWORD)
const OsTlsDtor : __type_ptr = #type *fn(value: *u8): void;    // called on thread exit if slot != null

const FLS_OUT_OF_INDEXES : u32 = 4294967295; // 0xFFFFFFFF

#linkc("FlsAlloc")    fn win_fls_alloc(callback: OsTlsDtor): u32;
#linkc("FlsGetValue") fn win_fls_get_value(index: u32): *u8;
#linkc("FlsSetValue") fn win_fls_set_value(index: u32, data: *u8): i32;
#linkc("FlsFree")     fn win_fls_free(index: u32): i32;

fn os_tls_key_create(key_out: *OsTlsKey, dtor: OsTlsDtor): bool {
    idx := win_fls_alloc(dtor);
    if (idx == FLS_OUT_OF_INDEXES) { return false; }
    key_out.* = idx.cast(u64);
    return true;
}

fn os_tls_key_create_simple(key_out: *OsTlsKey): bool {
    return os_tls_key_create(key_out, nullptr(u8).cast(OsTlsDtor));
}

fn os_tls_get(key: OsTlsKey): *u8 {
    return win_fls_get_value(key.cast(u32));
}

fn os_tls_set(key: OsTlsKey, value: *u8): bool {
    return win_fls_set_value(key.cast(u32), value) != 0;
}

fn os_tls_key_free(key: OsTlsKey): bool {
    return win_fls_free(key.cast(u32)) != 0;
}

#linkc("atexit") fn c_atexit(f: *fn(): void): i32;
#linkc("exit")   fn c_exit(code: i32): void;

// panic state (see panic.mox): 0 = no panic, 1 = panicking, 2 = the panic message was printed at exit
is_panicking: u8 = 0;
panic_message: []u8 = 0;
_os_panic_printer: bool = false;

// runs after every os_atexit handler, so the panic message is the last thing printed even when a handler cleared the screen
fn _os_print_panic_at_exit(): void {
    if (is_panicking != 1) { return; }
    os_stderr_write(panic_message.ptr, panic_message.len);
    nl := "\n";
    os_stderr_write(nl.ptr, nl.len);
    is_panicking = 2;
}

// false when the panic printer could not be registered
fn os_register_panic_printer(): bool {
    if (!_os_panic_printer) { _os_panic_printer = c_atexit(_os_print_panic_at_exit.^) == 0; }
    return _os_panic_printer;
}

// f runs when the process exits through exit(), a return from main or a panic, on the thread that exits it
fn os_atexit(f: *fn(): void): bool {
    os_register_panic_printer();
    return c_atexit(f) == 0;
}

// exits through exit(): os_atexit handlers and the exiting thread's thread_on_exit callbacks run
fn os_exit(code: i32): void {
    c_exit(code);
}

// threads

const OsThreadStart : __type_ptr = #type *fn(arg: *u8): *u8;

#linkc("CreateThread") fn win_thread_create(sec: *u8, stack_size: u64, start: OsThreadStart, arg: *u8, flags: u32, id_out: *u32): WIN_HANDLE;

fn os_thread_create(start: OsThreadStart, arg: *u8, handle_out: *u64): bool {
    h := win_thread_create(nullptr(u8), 0, start, arg, 0, nullptr(u32));
    if (h == 0) { return false; }
    handle_out.* = h.cast(u64);
    return true;
}

fn os_thread_join(handle: u64): bool {
    h := handle.cast(WIN_HANDLE);
    if (WaitForSingleObject(h, INFINITE) != 0) { return false; }
    return CloseHandle(h) != 0;
}

// console

_os_console_saved: bool = false;
_os_console_atexit: bool = false;
_os_saved_in_mode: u32 = 0;
_os_saved_out_mode: u32 = 0;
_os_saved_out_is_console: bool = false;
_os_saved_out_cp: u32 = 0;

// raw input (window + mouse events, no line/echo/quick-edit) + VT output + UTF-8. false when stdin is not a console: nothing is changed then.
// The first call saves the console state for os_console_restore, which also runs at process exit and after a panic (not after _exit or os_abort).
fn os_console_setup_raw(): bool {
    hin := GetStdHandle(STD_INPUT_HANDLE);
    hout := GetStdHandle(STD_OUTPUT_HANDLE);
    in_mode: u32 = 0;
    if (GetConsoleMode(hin, in_mode.^) == 0) { return false; }
    out_mode: u32 = 0;
    out_is_console := GetConsoleMode(hout, out_mode.^) != 0;

    // a second setup keeps the state saved by the first, so restore still goes back to the original
    if (!_os_console_saved) {
        _os_saved_in_mode = in_mode;
        _os_saved_out_mode = out_mode;
        _os_saved_out_is_console = out_is_console;
        _os_saved_out_cp = GetConsoleOutputCP();
        _os_console_saved = true;
        if (!_os_console_atexit) { _os_console_atexit = os_atexit(os_console_restore.^); }
    }

    if (SetConsoleMode(hin, ConsoleInMode.window.cast(u32) | ConsoleInMode.mouse.cast(u32) | ConsoleInMode.extended.cast(u32)) == 0) { return false; }
    if (out_is_console) { SetConsoleMode(hout, out_mode | ConsoleOutMode.processed.cast(u32) | ConsoleOutMode.vt.cast(u32)); }
    SetConsoleOutputCP(CP_UTF8);
    return true;
}

// puts back what the first os_console_setup_raw saved; does nothing when nothing is saved
fn os_console_restore(): void {
    if (!_os_console_saved) { return; }
    _os_console_saved = false;
    SetConsoleMode(GetStdHandle(STD_INPUT_HANDLE), _os_saved_in_mode);
    if (_os_saved_out_is_console) { SetConsoleMode(GetStdHandle(STD_OUTPUT_HANDLE), _os_saved_out_mode); }
    if (_os_saved_out_cp != 0) { SetConsoleOutputCP(_os_saved_out_cp); }
}

fn os_console_size(cols: *u32, rows: *u32): bool {
    info: CONSOLE_SCREEN_BUFFER_INFO = #memory_garbage;
    if (GetConsoleScreenBufferInfo(GetStdHandle(STD_OUTPUT_HANDLE), info.^) == 0) { return false; }
    cols.* = (info.srWindow.Right - info.srWindow.Left + 1).cast(u32);
    rows.* = (info.srWindow.Bottom - info.srWindow.Top + 1).cast(u32);
    return true;
}

fn os_stdout_write(buf: *u8, len: i64): void {
    win_write_all(GetStdHandle(STD_OUTPUT_HANDLE), buf, len);
}

fn os_stderr_write(buf: *u8, len: i64): void {
    win_write_all(GetStdHandle(STD_ERROR_HANDLE), buf, len);
}

// waits up to ms for input on stdin, negative = no limit
fn os_stdin_wait(ms: i64): void {
    wait: u32 = INFINITE;
    if (ms >= 0) { wait = min(ms, 4294967294).cast(u32); }
    WaitForSingleObject(GetStdHandle(STD_INPUT_HANDLE), wait);
}

// clipboard: UTF-8 text in and out, stored as CF_UNICODETEXT

// another program may hold the clipboard for a moment
fn _win_clipboard_open(): bool {
    for (i : it_range(10i64)) {
        if (OpenClipboard(nullptr(u8)) != 0) { return true; }
        win_Sleep(10);
    }
    return false;
}

// false when the clipboard could not be opened or set; the old content is kept unless it was emptied for the new one
fn os_clipboard_set(text: []u8): bool {
    t := scratch_begin();
    defer scratch_end(t);
    wide := utf8_to_utf16(text, t.alloc); // NULL-terminated
    bytes := (wide.len + 1) * 2;
    hmem := GlobalAlloc(GMEM_MOVEABLE, bytes.cast(u64));
    if (hmem == nullptr(u8)) { return false; }
    dst := GlobalLock(hmem);
    if (dst == nullptr(u8)) {
        GlobalFree(hmem);
        return false;
    }
    mem_copy(dst, wide.ptr.cast(*u8), bytes);
    GlobalUnlock(hmem);

    if (!_win_clipboard_open()) {
        GlobalFree(hmem);
        return false;
    }
    EmptyClipboard();
    ok := SetClipboardData(CF_UNICODETEXT, hmem) != nullptr(u8);
    CloseClipboard();
    if (!ok) { GlobalFree(hmem); } // the clipboard owns hmem only after a successful SetClipboardData
    return ok;
}

// the clipboard text as UTF-8 on alloc; empty when there is no text or the clipboard could not be opened
fn os_clipboard_get(alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    if (!_win_clipboard_open()) { return empty_slice(u8); }
    out := empty_slice(u8);
    hdata := GetClipboardData(CF_UNICODETEXT);
    if (hdata != nullptr(u8)) {
        src := GlobalLock(hdata);
        if (src != nullptr(u8)) {
            wsrc := src.cast(*u16);
            cap := (GlobalSize(hdata) / 2).cast(i64); // bounds the scan when the data has no NULL
            n: i64 = 0;
            while ((n < cap) && (type_offset(wsrc, n).* != 0)) { n += 1; }
            out = utf16_to_utf8(slice(wsrc, n), alloc, false);
            GlobalUnlock(hdata);
        }
    }
    CloseClipboard();
    return out;
}

// ---- UTF-16 paths ----
// Win32 takes UTF-16, mox strings are UTF-8: every path, env and command line string is converted at the call.

const _WIN_LONG_PATH_UNKNOWN : i32 = 0;
const _WIN_LONG_PATH_NO      : i32 = 1;
const _WIN_LONG_PATH_YES     : i32 = 2;
_win_long_path_state: i32 = 0;

const _RtlAreLongPathsEnabledFn : __type_ptr = #type fn(): u8;

// true when Win32 takes paths over 260 chars as they are: needs LongPathsEnabled in the registry AND longPathAware in the exe manifest.
// RtlAreLongPathsEnabled answers exactly that; it is missing before Windows 10 1607, then the answer is false.
// Computed once; two threads computing it at the same time get the same answer.
fn has_long_path_support(): bool {
    if (_win_long_path_state == _WIN_LONG_PATH_UNKNOWN) {
        state := _WIN_LONG_PATH_NO;
        ntdll := GetModuleHandleA("ntdll.dll".ptr);
        if (ntdll != nullptr(u8)) {
            f := GetProcAddress(ntdll, "RtlAreLongPathsEnabled".ptr);
            if (f != nullptr(u8)) {
                rtl_fn := f.cast(*_RtlAreLongPathsEnabledFn);
                if (rtl_fn() != 0) { state = _WIN_LONG_PATH_YES; }
            }
        }
        _win_long_path_state = state;
    }
    return _win_long_path_state == _WIN_LONG_PATH_YES;
}

fn _win_is_sep(c: u8): bool {
    return c == char("\\") || c == char("/");
}

// An absolute drive path of 248+ bytes gets the \\?\ prefix so Win32 takes it over 260 chars.
// The prefix turns off Win32 path cleanup, so "/" becomes "\", "." segments are dropped and ".." removes the previous segment.
// Unchanged: long path support on, short paths, relative paths, UNC and already prefixed paths.
fn _fix_long_path(path: []u8, alloc: *Alloc): []u8 {
    if (path.len < 248 || has_long_path_support()) { return path; }
    if (_win_is_sep(path[0]) && _win_is_sep(path[1])) { return path; }
    if (path[1] != char(":") || !_win_is_sep(path[2]) || !is_letter_char(path[0])) { return path; }

    prefix: []u8 = "\\\\?\\";
    out := mem_alloc_slice(alloc, u8, prefix.len + path.len + 1, 1);
    mem_copy(out.ptr, prefix.ptr, prefix.len);
    out[prefix.len] = path[0];
    out[prefix.len + 1] = char(":");
    root_end := prefix.len + 2;   // just after "C:"
    w := root_end;
    r: i64 = 2;
    while (r < path.len) {
        if (_win_is_sep(path[r])) {
            r += 1;
            continue;
        }
        start := r;
        while (r < path.len && !_win_is_sep(path[r])) { r += 1; }
        seg := slice(path, start, r - start);
        if (seg == ".") { continue; }
        if (seg == "..") {
            while (w > root_end && out[w - 1] != char("\\")) { w -= 1; }
            if (w > root_end) { w -= 1; }
            continue;
        }
        out[w] = char("\\");
        w += 1;
        mem_copy(type_offset(out.ptr, w), seg.ptr, seg.len);
        w += seg.len;
    }
    // a root needs its trailing separator
    if (w == root_end) {
        out[w] = char("\\");
        w += 1;
    }
    out[w] = 0;
    return slice(out, 0, w);
}

// NULL-terminated UTF-16 path for Win32 with long paths fixed, on the scratch arena until the end of the caller's block
fn #temp_win_path(path: []u8): *u16 {
    t := scratch_begin();
    defer scratch_end(t);
    return utf8_to_utf16(_fix_long_path(path, t.alloc), t.alloc).ptr;
}

// files, handle model: u64, 0 = invalid/failed

fn os_file_open_read(path: []u8): OsFile {
    h := CreateFileW(#temp_win_path(path), GENERIC_READ, FILE_SHARE_READ, nullptr(u8), OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr(u8));
    if (h.cast(u64) == INVALID_HANDLE_VALUE) { return 0; }
    return h.cast(u64);
}

// create/truncate for writing
fn os_file_open_write(path: []u8): OsFile {
    h := CreateFileW(#temp_win_path(path), GENERIC_WRITE, 0, nullptr(u8), CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr(u8));
    if (h.cast(u64) == INVALID_HANDLE_VALUE) { return 0; }
    return h.cast(u64);
}

fn os_file_size(h: OsFile): i64 {
    sz: i64 = 0;
    if (GetFileSizeEx(h.cast(*u8), sz.^) == 0) { return 0; }
    if (sz < 0) { return 0; }
    return sz;
}

// reads up to n bytes in one call, returns bytes read, 0 = EOF or error. A single call caps at 2 GiB.
fn os_file_read(h: OsFile, buf: *u8, n: i64): i64 {
    if (h == 0) { return 0; }
    chunk: u32 = 2147483647; // 0x7FFFFFFF, max bytes per call
    if (n < chunk.cast(i64)) { chunk = n.cast(u32); }
    got: u32 = 0;
    if (ReadFile(h.cast(*u8), buf, chunk, got.^, nullptr(u8)) == 0) { return 0; }
    return got.cast(i64);
}

// writes all n bytes, returns how many went out (== n on success)
fn os_file_write(h: OsFile, buf: *u8, n: i64): i64 {
    if (h == 0) { return 0; }
    return win_write_all(h.cast(*u8), buf, n);
}

fn os_file_close(h: OsFile): void {
    if (h != 0) { CloseHandle(h.cast(*u8)); }
}

fn os_file_delete(path: []u8): bool {
    return DeleteFileW(#temp_win_path(path)) != 0;
}

// stdout as a writable OsFile
fn os_stdout_file(): OsFile {
    return GetStdHandle(STD_OUTPUT_HANDLE).cast(u64);
}

// writes the cwd NULL-terminated into buf, returns the length without the NULL, 0 = failed or does not fit. Separators become "/".
fn os_cwd(buf: *u8, cap: i64): i64 {
    need := GetCurrentDirectoryW(0, nullptr(u16));   // size with the NULL
    if (need == 0) { return 0; }
    wbuf := #temp_buffer(need.cast(i64) * 2).ptr.cast(*u16);
    n := GetCurrentDirectoryW(need, wbuf);
    if ((n == 0) || (n >= need)) { return 0; }
    len := utf16_to_utf8_buf(slice(wbuf, n.cast(i64)), slice(buf, cap));
    if (len <= 0) { return 0; }
    replace_inplace(slice(buf, len), char("\\"), char("/"));
    return len;
}

// writes the absolute form of path NULL-terminated into buf, returns the length without the NULL, 0 = failed or does not fit. Separators become "/".
// Works on the text only, the file does not need to exist: a relative path is joined to the cwd, "." and ".." segments are resolved.
fn os_path_abs(buf: *u8, cap: i64, path: []u8): i64 {
    if (path.len == 0) { return 0; }
    wpath := #temp_utf8_to_utf16(path).ptr;
    need := GetFullPathNameW(wpath, 0, nullptr(u16), nullptr(*u16));   // size with the NULL
    if (need == 0) { return 0; }
    wbuf := #temp_buffer(need.cast(i64) * 2).ptr.cast(*u16);
    n := GetFullPathNameW(wpath, need, wbuf, nullptr(*u16));
    if ((n == 0) || (n >= need)) { return 0; }
    len := utf16_to_utf8_buf(slice(wbuf, n.cast(i64)), slice(buf, cap));
    if (len <= 0) { return 0; }
    replace_inplace(slice(buf, len), char("\\"), char("/"));
    return len;
}

// directory listing: os_dir_open(it, "<dir>") then os_dir_next(it) until false. "." and ".." are included.

struct OsDirIter {
    handle: u64;
    pending: bool;      // fd holds the FindFirstFileW entry, not returned yet
    is_dir: bool;       // false for a symlink or junction to a directory: walks do not follow links
    is_symlink: bool;   // a symlink or junction
    name: []u8;         // view into name_buf, valid until the next os_dir_next; copy to keep
    fd: WIN32_FIND_DATAW;
    name_buf: [781]u8;  // fd.cFileName as UTF-8: 260 units, at most 3 bytes each, plus NULL
};

fn os_dir_open(it: *OsDirIter, dir_path: []u8): bool {
    // build "<dir>/*", Win32 accepts "/" separators and _fix_long_path turns them into "\"
    pat := #temp_buffer(dir_path.len + 2); // separator + '*'
    n := dir_path.len;
    mem_copy(pat.ptr, dir_path.ptr, n);
    if (n > 0) {
        last := pat[n - 1];
        if ((last != char("\\")) && (last != char("/"))) {
            pat[n] = char("/");
            n += 1;
        }
    }
    pat[n] = char("*");
    n += 1;

    h := FindFirstFileW(#temp_win_path(slice(pat, 0, n)), it.fd.^);
    if (h.cast(u64) == INVALID_HANDLE_VALUE) {
        it.handle = 0;
        return false;
    }
    it.handle = h.cast(u64);
    it.pending = true;
    return true;
}

// a symlink or junction. Other reparse points (OneDrive placeholders, dedup) are real files and directories.
fn _win_is_link(fd: *WIN32_FIND_DATAW): bool {
    if ((fd.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) == 0) { return false; }
    tag := fd.dwReserved0; // the reparse tag when FILE_ATTRIBUTE_REPARSE_POINT is set
    return (tag == IO_REPARSE_TAG_SYMLINK) || (tag == IO_REPARSE_TAG_MOUNT_POINT);
}

fn os_dir_next(it: *OsDirIter): bool {
    if (it.handle == 0) { return false; }
    if (!it.pending) {
        if (FindNextFileW(it.handle.cast(*u8), it.fd.^) == 0) { return false; }
    }
    it.pending = false;

    wname := slice(it.fd.cFileName.ptr, utf16_len(it.fd.cFileName.ptr));
    it.name.ptr = it.name_buf.ptr;
    it.name.len = utf16_to_utf8_buf(wname, slice(it.name_buf.^));
    it.is_symlink = _win_is_link(it.fd.^);
    it.is_dir = ((it.fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0) && !it.is_symlink; // as on posix, a link to a directory is not one
    return true;
}

fn os_dir_close(it: *OsDirIter): void {
    if (it.handle != 0) {
        FindClose(it.handle.cast(*u8));
        it.handle = 0;
    }
}

// terminal input: os_term_input_init once, then os_term_poll per frame (non-blocking, false = nothing pending).
// Events use the shared model from vt_input.mox, decoded from native console input records; resize arrives as a window_buffer_size record.

struct OsTermInput {
    hin: WIN_HANDLE;
    prev_button_state: u32;
    high_surrogate: u16; // first half of a UTF-16 pair, waiting for the second record
};

fn os_term_input_init(ti: *OsTermInput): void {
    ti.hin = GetStdHandle(STD_INPUT_HANDLE);
    ti.prev_button_state = 0;
    ti.high_surrogate = 0;
}

fn _os_bit(flags: u32, f: $E): bool {
    return (flags & f.cast(u32)) != 0;
}

fn _os_vk_to_keycode(vk: u16): KeyCode {
    if (vk == 13)  { return .enter; }
    if (vk == 27)  { return .escape; }
    if (vk == 9)   { return .tab; }
    if (vk == 8)   { return .backspace; }
    if (vk == 46)  { return .delete; }
    if (vk == 32)  { return .space; }
    if (vk == 38)  { return .up; }
    if (vk == 40)  { return .down; }
    if (vk == 37)  { return .left; }
    if (vk == 39)  { return .right; }
    if (vk == 36)  { return .home; }
    if (vk == 35)  { return .end; }
    if (vk == 33)  { return .page_up; }
    if (vk == 34)  { return .page_down; }
    if (vk == 45)  { return .insert; }
    if (vk == 112) { return .f1; }
    if (vk == 113) { return .f2; }
    if (vk == 114) { return .f3; }
    if (vk == 115) { return .f4; }
    if (vk == 116) { return .f5; }
    if (vk == 117) { return .f6; }
    if (vk == 118) { return .f7; }
    if (vk == 119) { return .f8; }
    if (vk == 120) { return .f9; }
    if (vk == 121) { return .f10; }
    if (vk == 122) { return .f11; }
    if (vk == 123) { return .f12; }
    return .char;
}

fn _os_decode_mods(cks: u32): u8 {
    m: u8 = 0;
    if (_os_bit(cks, ControlKeyMask.shift)) { m += MOD_SHIFT; }
    if (_os_bit(cks, ControlKeyMask.ctrl)) { m += MOD_CTRL; }
    if (_os_bit(cks, ControlKeyMask.alt)) { m += MOD_ALT; }
    return m;
}

fn _os_changed_button(now: u32, was: u32): MouseButton {
    if (_os_bit(now, MouseButtonBit.left) && !_os_bit(was, MouseButtonBit.left)) { return .left; }
    if (_os_bit(now, MouseButtonBit.right) && !_os_bit(was, MouseButtonBit.right)) { return .right; }
    if (_os_bit(now, MouseButtonBit.middle) && !_os_bit(was, MouseButtonBit.middle)) { return .middle; }
    return .none;
}

const _OS_VK_SHIFT : u16 = 16;
const _OS_VK_CTRL  : u16 = 17;
const _OS_VK_ALT   : u16 = 18;
const _OS_VK_LWIN  : u16 = 91;
const _OS_VK_RWIN  : u16 = 92;

fn _os_vk_is_modifier(vk: u16): bool {
    return (vk == _OS_VK_SHIFT) || (vk == _OS_VK_CTRL) || (vk == _OS_VK_ALT) || (vk == _OS_VK_LWIN) || (vk == _OS_VK_RWIN) || ((vk >= 160) && (vk <= 165)); // 160..165: left/right shift, ctrl, alt
}

fn _os_decode_input_record(rec: *INPUT_RECORD, prev_button: *u32, high_surrogate: *u16, ev: *Event): bool {
    et := rec.EventType;
    ev.repeat = 1;

    if (et == .key) {
        kr := rec.Event.ptr.cast(*KEY_EVENT_RECORD);
        vk := kr.wVirtualKeyCode;
        ch := kr.UnicodeChar.cast(u32);
        packed := false;
        if (kr.bKeyDown == 0) {
            // a character that is not on the keyboard (emoji, paste, Alt+Numpad) arrives on the Alt key-up; other key-ups are ignored
            if ((vk != _OS_VK_ALT) || (ch == 0)) { return false; }
            packed = true;
        } else if (_os_vk_is_modifier(vk)) {
            return false; // a modifier going down types nothing; terminals on posix do not report it either, mods carries it
        }

        // UTF-16 comes one unit per record: a high surrogate waits for its low half, so one event carries the whole code point
        if ((ch >= 55296) && (ch <= 56319)) { // D800..DBFF
            high_surrogate.* = ch.cast(u16);
            return false;
        }
        high := high_surrogate.*.cast(u32);
        high_surrogate.* = 0; // a high half without its low half is dropped
        if ((ch >= 56320) && (ch <= 57343)) { // DC00..DFFF
            if (high == 0) {
                ch = 65533; // U+FFFD for a lone low half
            } else {
                ch = 65536 + #shl(high - 55296, 10) + (ch - 56320);
            }
        }

        ev.kind = .key;
        ev.vk = vk;
        ev.code = _os_vk_to_keycode(vk);
        ev.mods = _os_decode_mods(kr.dwControlKeyState);
        ev.ch = ch; // carry the char for every key, typing needs it
        if (packed) {
            // only the character: the Alt that carried it is not a modifier of it
            ev.vk = 0;
            ev.code = .char;
            ev.mods = 0;
        }
        if (kr.wRepeatCount > 1) { ev.repeat = kr.wRepeatCount; } // held key: one record, N repeats
        return true;
    }

    if (et == .mouse) {
        mr := rec.Event.ptr.cast(*MOUSE_EVENT_RECORD);
        ev.kind = .mouse;
        ev.x = mr.dwMousePosition.X.cast(u32);
        ev.y = mr.dwMousePosition.Y.cast(u32);
        ev.mods = _os_decode_mods(mr.dwControlKeyState);
        ev.button = .none;
        ev.wheel = 0;
        flags := mr.dwEventFlags;

        if (_os_bit(flags, MouseEventFlag.moved)) {
            ev.action = .move;
            prev_button.* = mr.dwButtonState;
            return true;
        }
        if (_os_bit(flags, MouseEventFlag.wheeled)) { // signed wheel delta in high word
            ev.action = .wheel;
            hw := #shr(mr.dwButtonState, 16);
            if (hw > 32767) { ev.wheel = hw.cast(i32) - 65536; }
            else { ev.wheel = hw.cast(i32); }
            prev_button.* = mr.dwButtonState;
            return true;
        }

        bs := mr.dwButtonState;
        pv := prev_button.*;
        pressed := _os_changed_button(bs, pv);
        if (pressed != .none) {
            ev.action = .press;
            ev.button = pressed;
        } else {
            ev.action = .release;
            ev.button = _os_changed_button(pv, bs);
        }
        prev_button.* = bs;
        return true;
    }

    if (et == .window_buffer_size) {
        wr := rec.Event.ptr.cast(*WINDOW_BUFFER_SIZE_RECORD);
        ev.kind = .resize;
        ev.w = wr.dwSize.X.cast(u32);
        ev.h = wr.dwSize.Y.cast(u32);
        return true;
    }

    return false;
}

fn os_term_poll(ti: *OsTermInput, ev: *Event): bool {
    n: u32 = 0;
    while (true) {
        if (GetNumberOfConsoleInputEvents(ti.hin, n.^) == 0) { return false; }
        if (n == 0) { return false; }

        rec: INPUT_RECORD = #memory_garbage;
        read: u32 = 0;
        if (ReadConsoleInputW(ti.hin, rec.^, 1, read.^) == 0) { return false; }
        if (read == 0) { return false; }

        if (_os_decode_input_record(rec.^, ti.prev_button_state.^, ti.high_surrogate.^, ev)) {
            return true;
        }
        // skipped record, read the next one
    }
    return false;
}

// raw stdin bytes, for terminal query replies. Under ConPTY a VT reply arrives as KEY_EVENT records, collect their chars. Never blocks.
fn os_stdin_read_bytes(ti: *OsTermInput, buf: *u8, cap: i64): i64 {
    pos: i64 = 0;
    while (pos < cap) {
        queued: u32 = 0;
        if (GetNumberOfConsoleInputEvents(ti.hin, queued.^) == 0) { return pos; }
        if (queued == 0) { return pos; }
        rec: INPUT_RECORD = #memory_garbage;
        read: u32 = 0;
        if (ReadConsoleInputW(ti.hin, rec.^, 1, read.^) == 0) { return pos; }
        if (read == 0) { return pos; }
        if (rec.EventType == .key) {
            kr := rec.Event.ptr.cast(*KEY_EVENT_RECORD);
            if ((kr.bKeyDown != 0) && (kr.UnicodeChar != 0)) {
                type_offset(buf, pos).* = kr.UnicodeChar.cast(u8);
                pos += 1;
            }
        }
    }
    return pos;
}

// Keep in sync with os_posix.mox.

fn os_stdin_read_bytes(ti: *OsTermInput, buf: []u8): i64 { return os_stdin_read_bytes(ti, buf.ptr, buf.len); }

fn os_file_open_read(path: *u8): OsFile {
    return os_file_open_read(slice(path, c_strlen(path)));
}
fn os_file_open_write(path: *u8): OsFile {
    return os_file_open_write(slice(path, c_strlen(path)));
}
fn os_file_delete(path: *u8): bool {
    return os_file_delete(slice(path, c_strlen(path)));
}

// one level; false when it already exists or the parent is missing
fn os_make_dir(path: []u8): bool {
    return CreateDirectoryW(#temp_win_path(path), nullptr(u8)) != 0;
}

// the directory must be empty
fn os_delete_dir(path: []u8): bool {
    return RemoveDirectoryW(#temp_win_path(path)) != 0;
}

// files and (same-volume) directories; an existing `to` file is replaced
fn os_rename(from: []u8, to: []u8): bool {
    return MoveFileExW(#temp_win_path(from), #temp_win_path(to), MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED) != 0;
}

fn os_copy_file(from: []u8, to: []u8): bool {
    return CopyFileW(#temp_win_path(from), #temp_win_path(to), 0) != 0;
}

// "file" means any non-directory entry

fn os_path_exists(path: []u8): bool {
    return GetFileAttributesW(#temp_win_path(path)) != INVALID_FILE_ATTRIBUTES;
}
fn os_dir_exists(path: []u8): bool {
    attrs := GetFileAttributesW(#temp_win_path(path));
    if (attrs == INVALID_FILE_ATTRIBUTES) { return false; }
    return (attrs & FILE_ATTRIBUTE_DIRECTORY) != 0;
}
fn os_file_exists(path: []u8): bool {
    attrs := GetFileAttributesW(#temp_win_path(path));
    if (attrs == INVALID_FILE_ATTRIBUTES) { return false; }
    return (attrs & FILE_ATTRIBUTE_DIRECTORY) == 0;
}

// os_is_dir / os_is_file / os_is_symlink describe path itself, like the OsDirIter flags: a link is neither a dir nor a file.
// os_dir_exists / os_file_exists above follow links.

// attributes of path itself; is_link_out = symlink or junction. false = it does not exist
fn _win_path_kind(path: []u8, attrs_out: *u32, is_link_out: *bool): bool {
    attrs := GetFileAttributesW(#temp_win_path(path));
    if (attrs == INVALID_FILE_ATTRIBUTES) { return false; }
    attrs_out.* = attrs;
    is_link_out.* = false;
    if ((attrs & FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
        fd: WIN32_FIND_DATAW = #memory_garbage;
        h := FindFirstFileW(#temp_win_path(path), fd.^); // without wildcards it describes path itself, reparse tag included
        if (h.cast(u64) != INVALID_HANDLE_VALUE) {
            FindClose(h);
            is_link_out.* = _win_is_link(fd.^);
        }
    }
    return true;
}

fn os_is_dir(path: []u8): bool {
    attrs: u32 = 0;
    link := false;
    if (!_win_path_kind(path, attrs.^, link.^)) { return false; }
    return ((attrs & FILE_ATTRIBUTE_DIRECTORY) != 0) && !link;
}
fn os_is_file(path: []u8): bool {
    attrs: u32 = 0;
    link := false;
    if (!_win_path_kind(path, attrs.^, link.^)) { return false; }
    return ((attrs & FILE_ATTRIBUTE_DIRECTORY) == 0) && !link;
}
// a symlink or junction
fn os_is_symlink(path: []u8): bool {
    attrs: u32 = 0;
    link := false;
    if (!_win_path_kind(path, attrs.^, link.^)) { return false; }
    return link;
}

// writable NULL-terminated UTF-16 command line, as CreateProcessW wants it.
// /s strips exactly the outer quotes added here, so cmd reaches the shell unchanged; /d skips the AutoRun registry commands.
fn _win_shell_cmdline(cmd: []u8, alloc: *Alloc): *u16 {
    prefix: []u8 = "cmd.exe /d /s /c \"";
    full := mem_alloc_slice(alloc, u8, prefix.len + cmd.len + 1, 1);
    mem_copy(full.ptr, prefix.ptr, prefix.len);
    mem_copy(full.ptr |> byte_offset(prefix.len), cmd.ptr, cmd.len);
    full[full.len - 1] = char("\"");
    return utf8_to_utf16(full, alloc).ptr;
}

// full path of System32\cmd.exe, so a cmd.exe in the exe folder or the current folder is never picked. nullptr = failed.
fn _win_shell_app(alloc: *Alloc): *u16 {
    name: []u8 = "\\cmd.exe";
    n := GetSystemDirectoryW(nullptr(u16), 0);   // size with the NULL
    if (n == 0) { return nullptr(u16); }
    buf := mem_alloc_slice(alloc, u16, n.cast(i64) + name.len);
    got := GetSystemDirectoryW(buf.ptr, n).cast(i64);
    if ((got == 0) || (got >= n.cast(i64))) { return nullptr(u16); }
    for (i : it_range(name.len)) { buf[got + i] = name[i].cast(u16); }
    buf[got + name.len] = 0;
    return buf.ptr;
}

// runs cmd through the platform shell, waits, returns its exit code. -1 = could not start or its status could not be read; a real exit code -1 looks the same, os_exec_ex tells them apart.
fn os_exec(cmd: []u8): i32 {
    opts: ExecOptions = 0;
    r := os_exec_ex(cmd, opts);
    if (!r.exited) { return -1; }
    return r.exit_code;
}

fn os_monotonic_ms(): i64 {
    return GetTickCount64().cast(i64);
}

_os_qpc_freq: i64 = 0;

fn os_monotonic_ns(): i64 {
    if (_os_qpc_freq == 0) {
        win_QueryPerformanceFrequency(_os_qpc_freq.^);
    }
    c: i64 = 0;
    win_QueryPerformanceCounter(c.^);
    // split so c * 1e9 cannot overflow
    sec := c / _os_qpc_freq;
    rem := c - sec * _os_qpc_freq;
    return sec * 1000000000 + rem * 1000000000 / _os_qpc_freq;
}

fn os_unix_time_ms(): i64 {
    ft: u64 = 0; // FILETIME as one u64
    win_GetSystemTimeAsFileTime(ft.^);
    return ((ft - 116444736000000000) / 10000).cast(i64); // 1601 -> 1970, 100ns -> ms
}

fn os_sleep_ms(ms: i64): void {
    if (ms <= 0) { return; }
    ms = min(ms, 4294967294); // Sleep takes a u32; INFINITE (max u32) must not be reachable
    win_Sleep(ms.cast(u32));
}

// writes the temp directory into buf (with a trailing separator, NULL-terminated), returns the length, 0 = failed or does not fit.
// Separators become "/".
fn os_temp_dir(buf: *u8, cap: i64): i64 {
    wbuf: [261]u16 = #memory_garbage;   // GetTempPathW never returns more than MAX_PATH + 1 units
    n := GetTempPathW(261, wbuf.ptr);
    if ((n == 0) || (n > 261)) { return 0; }
    len := utf16_to_utf8_buf(slice(wbuf.ptr, n.cast(i64)), slice(buf, cap));
    if (len <= 0) { return 0; }
    replace_inplace(slice(buf, len), char("\\"), char("/"));
    return len;
}

enum OsExecStreamMode : u8 {
    inherit := 0; // share the parent's handle
    buffer  := 1; // stdin: fed from ExecOptions.stdin_data, then closed; stdout/stderr: captured into ExecResult
    null    := 2; // NUL / /dev/null
    file    := 3; // the OsFile in ExecOptions.*_file (opened by the caller, stays open)
    merge   := 4; // stderr only: goes wherever stdout goes
};

struct ExecOptions {
    stdin_mode: OsExecStreamMode;
    stdin_data: []u8;   // written to the child when stdin_mode == .buffer, then its stdin is closed
    stdin_file: OsFile;
    stdout_mode: OsExecStreamMode;
    stdout_file: OsFile;
    stderr_mode: OsExecStreamMode;
    stderr_file: OsFile;
    cwd: []u8;          // empty = inherit
    timeout_ms: i64;    // 0 = wait forever; on expiry the child and every process it started are killed and timed_out is set. Posix: with a timeout the child runs in its own process group, so Ctrl+C in the terminal does not reach it and reading from the terminal stops it
    no_window: bool;    // windows only: CREATE_NO_WINDOW, no console flashes up from a GUI parent
    inherit_handles: bool; // false = the child gets only its stdin/stdout/stderr; true = also every inheritable handle (windows) / every fd without close-on-exec (posix)
};

struct ExecResult {
    started: bool;      // false = the command could not be started, nothing else is meaningful
    ok: bool;
    timed_out: bool;
    exited: bool;       // exit_code is the child's own code; false when not started or its status could not be read
    exit_code: i32;     // only meaningful when exited; 128+signal when killed by a signal on posix (also after a timeout kill)
    stdout: []u8;       // on arena, filled only when stdout_mode == .buffer
    stderr: []u8;       // on arena, filled only when stderr_mode == .buffer
};

const OsProcess := #type u64; // process handle

enum OsWaitStatus : u8 {
    exited  := 0; // exit_code is the process's code
    running := 1; // timeout_ms passed first
    failed  := 2; // its status can not be read
};

struct OsWaitResult {
    status: OsWaitStatus;
    exit_code: i32; // only meaningful when status == .exited, 0 otherwise
};

_win_pipe_counter: u64 = 0; #thread_local

// pipe with an async (overlapped) end for us and a normal blocking end for the other side. Both are non-inheritable.
// Named because anonymous pipes can not do overlapped I/O; pid + thread id + counter keeps the name unique.
fn _win_async_pipe(child_reads: bool, alloc: *Alloc, child_out: *u64, ours_out: *u64): bool {
    _win_pipe_counter += 1;
    sb: StringBuilder = #memory_garbage;
    init(sb.^, alloc);
    push(sb.^, "\\\\.\\pipe\\mox-pipe-"); // format would read these backslashes as escapes
    format(sb.^, "{}-{}-{}", .{ GetCurrentProcessId(); GetCurrentThreadId(); _win_pipe_counter; });
    name := utf8_to_utf16(finalize(sb.^, alloc, false), alloc).ptr;

    access := PIPE_ACCESS_INBOUND;
    child_access := GENERIC_WRITE | FILE_READ_ATTRIBUTES;
    if (child_reads) {
        access = PIPE_ACCESS_OUTBOUND;
        child_access = GENERIC_READ | FILE_WRITE_ATTRIBUTES;
    }
    // FIRST_PIPE_INSTANCE: fail instead of joining a pipe that someone else created with this name first
    ours := CreateNamedPipeW(name, access | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE, PIPE_REJECT_REMOTE_CLIENTS, 1, _WIN_ASYNC_PIPE_BUF, _WIN_ASYNC_PIPE_BUF, 0, nullptr(u8));
    if (ours.cast(u64) == INVALID_HANDLE_VALUE) { return false; }
    child := CreateFileW(name, child_access, 0, nullptr(u8), OPEN_EXISTING, 0, nullptr(u8));
    if (child.cast(u64) == INVALID_HANDLE_VALUE) {
        CloseHandle(ours);
        return false;
    }
    child_out.* = child.cast(u64);
    ours_out.* = ours.cast(u64);
    return true;
}

// resolves the child's handle for one standard stream from its option. Every handle made here is non-inheritable.
// child_out: what the child gets; ours_out: our end of the pipe (0 = none); owned_out: child_out is ours to close after CreateProcess.
fn _win_exec_child_handle(mode: OsExecStreamMode, std_id: u32, file: OsFile, child_reads: bool, alloc: *Alloc, child_out: *u64, ours_out: *u64, owned_out: *bool): bool {
    child_out.* = 0;
    ours_out.* = 0;
    owned_out.* = false;
    if (mode == .buffer) {
        if (!_win_async_pipe(child_reads, alloc, child_out, ours_out)) { return false; }
        owned_out.* = true;
        return true;
    }
    if (mode == .null) {
        h := CreateFileW(#temp_utf8_to_utf16("NUL").ptr, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr(u8), OPEN_EXISTING, 0, nullptr(u8));
        if (h.cast(u64) == INVALID_HANDLE_VALUE) { return false; }
        child_out.* = h.cast(u64);
        owned_out.* = true;
        return true;
    }
    if (mode == .file) {
        if (file == 0) { return false; }
        child_out.* = file;
        return true;
    }
    child_out.* = GetStdHandle(std_id).cast(u64);
    return true;
}

// inheritable copy of h for the child, closed by us after CreateProcess. h = 0 (no such stream) gives 0.
fn _win_inheritable_copy(h: u64, out: *u64): bool {
    out.* = 0;
    if ((h == 0) || (h == INVALID_HANDLE_VALUE)) { return true; }
    return DuplicateHandle(GetCurrentProcess(), h.cast(*u8), GetCurrentProcess(), out, 0, 1, DUPLICATE_SAME_ACCESS) != 0;
}

fn _win_close_if(h: u64): void {
    if (h != 0) { CloseHandle(h.cast(*u8)); }
}

// our async end of a pipe, with at most one overlapped read or write in flight
struct _WinAsyncIo {
    h: u64;         // 0 = closed
    ev: u64;        // signaled when the op in flight finishes
    ov: OVERLAPPED;
    pending: bool;
    buf: []u8;      // read target, or the bytes a writer keeps in flight (empty when the caller's data is used)
};

// takes over h (closed by _win_async_io_close even when this fails). buf_size > 0 gives it a buffer on alloc.
fn _win_async_io_init(io: *_WinAsyncIo, h: u64, buf_size: i64, alloc: *Alloc): bool {
    io.h = h;
    io.ev = 0;
    io.pending = false;
    io.buf = 0;
    if (h == 0) { return true; }
    ev := CreateEventW(nullptr(u8), 1, 0, nullptr(u16));
    if (ev == 0) { return false; }
    io.ev = ev.cast(u64);
    if (buf_size > 0) { io.buf = mem_alloc_slice(alloc, u8, buf_size, 1); }
    return true;
}

fn _win_async_io_reset_ov(io: *_WinAsyncIo): void {
    ov: OVERLAPPED = 0;
    ov.hEvent = io.ev.cast(*u8);
    io.ov = ov;
}

// stops the op in flight and waits until the system is done with ov and buf. Returns the bytes it moved when it finished before the cancel, else -1.
fn _win_async_io_cancel(io: *_WinAsyncIo): i64 {
    if (!io.pending) { return -1; }
    CancelIoEx(io.h.cast(*u8), io.ov.^);
    got: u32 = 0;
    ok := GetOverlappedResult(io.h.cast(*u8), io.ov.^, got.^, 1);
    io.pending = false;
    if (ok == 0) { return -1; }
    return got.cast(i64);
}

fn _win_async_io_close(io: *_WinAsyncIo): void {
    _win_async_io_cancel(io);
    _win_close_if(io.h);
    _win_close_if(io.ev);
    io.h = 0;
    io.ev = 0;
}

// result of the op that signaled io.ev: bytes moved, -1 = EOF / the other end is gone
fn _win_async_io_finish(io: *_WinAsyncIo): i64 {
    io.pending = false;
    got: u32 = 0;
    if (GetOverlappedResult(io.h.cast(*u8), io.ov.^, got.^, 0) == 0) { return -1; }
    return got.cast(i64);
}

// queues the next read; on failure (EOF included) the stream is closed
fn _win_async_read_start(io: *_WinAsyncIo): void {
    _win_async_io_reset_ov(io);
    if ((ReadFile(io.h.cast(*u8), io.buf.ptr, io.buf.len.cast(u32), nullptr(u32), io.ov.^.cast(*u8)) != 0) || (GetLastError() == ERROR_IO_PENDING)) {
        io.pending = true;
        return;
    }
    _win_async_io_close(io);
}

// queues the next chunk of data from off; on failure (the child closed its stdin) the stream is closed
fn _win_async_write_start(io: *_WinAsyncIo, data: []u8, off: i64): void {
    _win_async_io_reset_ov(io);
    n := min(data.len - off, _WIN_ASYNC_PIPE_BUF.cast(i64));
    if ((WriteFile(io.h.cast(*u8), data.ptr |> byte_offset(off), n.cast(u32), nullptr(u32), io.ov.^.cast(*u8)) != 0) || (GetLastError() == ERROR_IO_PENDING)) {
        io.pending = true;
        return;
    }
    _win_async_io_close(io);
}

// after a kill: takes what the pipe already holds without waiting for more
fn _win_exec_drain(io: *_WinAsyncIo, sb: *StringBuilder): void {
    while (io.h != 0) {
        if (!io.pending) {
            _win_async_read_start(io);
            if (io.h == 0) { return; }
        }
        if (WaitForSingleObject(io.ev.cast(*u8), 0) != 0) {
            got := _win_async_io_cancel(io);
            if (got > 0) { push_copy(sb, slice(io.buf.ptr, got)); }
            return;
        }
        got := _win_async_io_finish(io);
        if (got < 0) { return; }
        if (got > 0) { push_copy(sb, slice(io.buf.ptr, got)); }
    }
}

// waits up to timeout_ms for the process to end: 0 = only check, -1 = no limit
fn os_wait_process_exit(proc: OsProcess, timeout_ms: i64): OsWaitResult {
    res: OsWaitResult = 0;
    ms: u32 = INFINITE;
    if (timeout_ms >= 0) { ms = min(timeout_ms, 4294967294).cast(u32); }
    w := WaitForSingleObject(proc.cast(*u8), ms);
    if (w == WAIT_TIMEOUT) {
        res.status = .running;
        return res;
    }
    // only an ended wait proves the process is gone: GetExitCodeProcess alone cannot tell STILL_ACTIVE from a real exit code 259
    code: u32 = 0;
    if ((w != WAIT_OBJECT_0) || (GetExitCodeProcess(proc.cast(*u8), code.^) == 0)) {
        res.status = .failed;
        return res;
    }
    res.status = .exited;
    res.exit_code = code.cast(i32);
    return res;
}

// with a timeout the child runs in a job, so the kill also reaches every process it started
fn _win_exec_kill(proc: WIN_HANDLE, job: WIN_HANDLE): void {
    if ((job != 0) && (TerminateJobObject(job, 1) != 0)) { return; }
    TerminateProcess(proc, 1);
}

// runs cmd through the platform shell (cmd.exe /C here, /bin/sh -c on posix) with options
// Captured output lives on alloc.
fn os_exec_ex(cmd: []u8, opts: ExecOptions, alloc: *Alloc = get_context_temp_arena_as_alloc()): ExecResult {
    res: ExecResult = 0;

    scratch := scratch_begin(alloc);
    defer scratch_end(scratch);

    app := _win_shell_app(scratch.alloc);
    if (app == 0) { return res; }
    full := _win_shell_cmdline(cmd, scratch.alloc);
    cwd := nullptr(u16);
    if (opts.cwd.len > 0) { cwd = utf8_to_utf16(opts.cwd, scratch.alloc).ptr; }

    in_child: u64 = 0;  in_ours: u64 = 0;  in_owned := false;
    out_child: u64 = 0; out_ours: u64 = 0; out_owned := false;
    err_child: u64 = 0; err_ours: u64 = 0; err_owned := false;

    ok := _win_exec_child_handle(opts.stdin_mode, STD_INPUT_HANDLE, opts.stdin_file, true, scratch.alloc, in_child.^, in_ours.^, in_owned.^);
    if (ok) { ok = _win_exec_child_handle(opts.stdout_mode, STD_OUTPUT_HANDLE, opts.stdout_file, false, scratch.alloc, out_child.^, out_ours.^, out_owned.^); }
    if (ok) {
        if (opts.stderr_mode == .merge) {
            err_child = out_child; // same handle, closed once through out_owned
        } else {
            ok = _win_exec_child_handle(opts.stderr_mode, STD_ERROR_HANDLE, opts.stderr_file, false, scratch.alloc, err_child.^, err_ours.^, err_owned.^);
        }
    }

    // our pipe ends move into these, which close them
    io_in: _WinAsyncIo = 0;
    io_out: _WinAsyncIo = 0;
    io_err: _WinAsyncIo = 0;
    if (!_win_async_io_init(io_in.^, in_ours, 0, scratch.alloc)) { ok = false; }
    if (!_win_async_io_init(io_out.^, out_ours, _WIN_ASYNC_PIPE_BUF.cast(i64), scratch.alloc)) { ok = false; }
    if (!_win_async_io_init(io_err.^, err_ours, _WIN_ASYNC_PIPE_BUF.cast(i64), scratch.alloc)) { ok = false; }

    // only these copies are inheritable, and only for the moment of CreateProcess
    in_dup: u64 = 0; out_dup: u64 = 0; err_dup: u64 = 0;
    if (ok) { ok = _win_inheritable_copy(in_child, in_dup.^); }
    if (ok) { ok = _win_inheritable_copy(out_child, out_dup.^); }
    if (ok) {
        if (opts.stderr_mode == .merge) {
            err_dup = out_dup;
        } else {
            ok = _win_inheritable_copy(err_child, err_dup.^);
        }
    }

    // by default the handle list limits inheritance to the 3 copies, so handles other threads made inheritable stay out
    handles: [3]u64 = 0;
    handles_n: i64 = 0;
    if (in_dup != 0)  { handles[handles_n] = in_dup;  handles_n += 1; }
    if (out_dup != 0) { handles[handles_n] = out_dup; handles_n += 1; }
    if ((err_dup != 0) && (err_dup != out_dup)) { handles[handles_n] = err_dup; handles_n += 1; }
    inherit: i32 = 1;
    attr := nullptr(u8);
    if (ok && !opts.inherit_handles) {
        if (handles_n == 0) {
            inherit = 0;
        } else {
            attr_size: u64 = 0;
            InitializeProcThreadAttributeList(nullptr(u8), 1, 0, attr_size.^); // first call always fails, it only fills attr_size
            attr = mem_alloc(scratch.alloc, attr_size.cast(i64), 8);
            if (InitializeProcThreadAttributeList(attr, 1, 0, attr_size.^) == 0) {
                attr = nullptr(u8);
                ok = false;
            } else {
                ok = UpdateProcThreadAttribute(attr, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, handles.ptr.cast(*u8), (handles_n * 8).cast(u64), nullptr(u8), nullptr(u64)) != 0;
            }
        }
    }

    // started suspended and resumed once inside the job, so nothing it starts escapes the job
    job: WIN_HANDLE = 0;
    if (ok && (opts.timeout_ms > 0)) { job = CreateJobObjectW(nullptr(u8), nullptr(u16)); }

    pi: PROCESS_INFORMATION = 0;
    if (ok) {
        si: STARTUPINFOEXW = 0;
        si.StartupInfo.cb = sizeof_type(STARTUPINFOW).cast(u32);
        si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
        si.StartupInfo.hStdInput = in_dup.cast(*u8);
        si.StartupInfo.hStdOutput = out_dup.cast(*u8);
        si.StartupInfo.hStdError = err_dup.cast(*u8);
        flags: u32 = 0;
        if (opts.no_window) { flags = CREATE_NO_WINDOW; }
        if (job != 0) { flags = flags | CREATE_SUSPENDED; }
        if (attr != 0) {
            si.StartupInfo.cb = sizeof_type(STARTUPINFOEXW).cast(u32);
            si.lpAttributeList = attr;
            flags = flags | EXTENDED_STARTUPINFO_PRESENT;
        }
        ok = CreateProcessW(app, full, nullptr(u8), nullptr(u8), inherit, flags, nullptr(u8), cwd, si.^, pi.^) != 0;
    }
    if (ok && (job != 0)) {
        if (AssignProcessToJobObject(job, pi.hProcess) == 0) {
            CloseHandle(job); // the timeout then kills only the child
            job = 0;
        }
        if (ResumeThread(pi.hThread) == 0xFFFFFFFF) {
            TerminateProcess(pi.hProcess, 1);
            CloseHandle(pi.hProcess);
            CloseHandle(pi.hThread);
            ok = false;
        }
    }

    // the child holds its own copies now (or never started)
    if (attr != 0) { DeleteProcThreadAttributeList(attr); }
    _win_close_if(in_dup);
    _win_close_if(out_dup);
    if (err_dup != out_dup) { _win_close_if(err_dup); }
    if (in_owned)  { CloseHandle(in_child.cast(*u8)); }
    if (out_owned) { CloseHandle(out_child.cast(*u8)); }
    if (err_owned) { CloseHandle(err_child.cast(*u8)); }
    if (!ok) {
        if (job != 0) { CloseHandle(job); }
        _win_async_io_close(io_in.^);
        _win_async_io_close(io_out.^);
        _win_async_io_close(io_err.^);
        return res;
    }
    res.started = true;

    out_sb: StringBuilder = #memory_garbage;
    err_sb: StringBuilder = #memory_garbage;
    init(out_sb.^, scratch.alloc);
    init(err_sb.^, scratch.alloc);

    deadline: i64 = 0;
    if (opts.timeout_ms > 0) { deadline = #wrap_add(os_monotonic_ms(), opts.timeout_ms); } // wraps for huge timeouts, #wrap_sub below gets the time left back

    in_off: i64 = 0;
    if (io_in.h != 0) {
        if (opts.stdin_data.len == 0) {
            _win_async_io_close(io_in.^); // nothing to feed: EOF for the child right away
        } else {
            _win_async_write_start(io_in.^, opts.stdin_data, 0);
        }
    }
    if (io_out.h != 0) { _win_async_read_start(io_out.^); }
    if (io_err.h != 0) { _win_async_read_start(io_err.^); }

    // one wait on every op in flight plus the process; runs until EOF on all pipes, also after the child exits:
    // a process it started may still hold a write end. Only the timeout ends it early.
    exited := false;
    killed := false;
    while ((io_in.h != 0) || (io_out.h != 0) || (io_err.h != 0)) {
        waits: [4]u64 = 0;
        who: [4]i64 = 0;
        n: u32 = 0;
        if (io_in.h != 0)  { waits[n] = io_in.ev;  who[n] = 0; n += 1; }
        if (io_out.h != 0) { waits[n] = io_out.ev; who[n] = 1; n += 1; }
        if (io_err.h != 0) { waits[n] = io_err.ev; who[n] = 2; n += 1; }
        if (!exited) { waits[n] = pi.hProcess.cast(u64); who[n] = 3; n += 1; }
        wait_ms: u32 = INFINITE;
        if (deadline != 0) { wait_ms = min(max(#wrap_sub(deadline, os_monotonic_ms()), 0), 4294967294).cast(u32); } // INFINITE (max u32) must not be reachable

        r := WaitForMultipleObjects(n, waits.ptr, 0, wait_ms);
        if (r >= n) {
            // timeout, or the wait itself failed: stop the child rather than hang
            _win_exec_kill(pi.hProcess, job);
            if (r == WAIT_TIMEOUT) { res.timed_out = true; }
            killed = true;
            break;
        }
        k := who[r];
        if (k == 3) {
            exited = true;
            continue;
        }
        if (k == 0) {
            got := _win_async_io_finish(io_in.^);
            if (got < 0) {
                _win_async_io_close(io_in.^); // the child closed its stdin, the rest of the data is not wanted
                continue;
            }
            in_off += got;
            if (in_off >= opts.stdin_data.len) {
                _win_async_io_close(io_in.^); // all fed: EOF for the child
            } else {
                _win_async_write_start(io_in.^, opts.stdin_data, in_off);
            }
            continue;
        }
        io := io_out.^;
        sb := out_sb.^;
        if (k == 2) {
            io = io_err.^;
            sb = err_sb.^;
        }
        got := _win_async_io_finish(io);
        if (got < 0) {
            _win_async_io_close(io);
            continue;
        }
        if (got > 0) { push_copy(sb, slice(io.buf.ptr, got)); }
        _win_async_read_start(io);
    }
    if (killed) {
        _win_exec_drain(io_out.^, out_sb.^);
        _win_exec_drain(io_err.^, err_sb.^);
    }
    _win_async_io_close(io_in.^);
    _win_async_io_close(io_out.^);
    _win_async_io_close(io_err.^);

    // the child may outlive its pipes (closed stdout early); wait for it with whatever time is left
    remaining: i64 = -1;
    if (deadline != 0) { remaining = max(#wrap_sub(deadline, os_monotonic_ms()), 0); }
    wr := os_wait_process_exit(pi.hProcess.cast(u64), remaining);
    if (wr.status == .running) {
        _win_exec_kill(pi.hProcess, job);
        res.timed_out = true;
        wr = os_wait_process_exit(pi.hProcess.cast(u64), -1);
    } else if (wr.status == .failed) {
        _win_exec_kill(pi.hProcess, job); // the wait failed: stop the child rather than leave it running
    }
    if (job != 0) { CloseHandle(job); } // no kill-on-close: what outlived the call without a timeout kill keeps running
    res.exited = wr.status == .exited;
    res.exit_code = wr.exit_code;
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);

    if (opts.stdout_mode == .buffer) { res.stdout = finalize(out_sb.^, alloc, false); }
    if (opts.stderr_mode == .buffer) { res.stderr = finalize(err_sb.^, alloc, false); }
    res.ok = res.started && res.exited && (res.exit_code == 0);
    return res;
}

// runs cmd through the platform shell, waits, returns everything it wrote to stdout (on alloc).
// Empty when the command could not start (or printed nothing). stdin and stderr stay inherited; append "2>&1" to capture stderr too.
fn os_exec_output(cmd: []u8, alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    opts: ExecOptions = 0;
    opts.stdout_mode = .buffer;
    return os_exec_ex(cmd, opts, alloc).stdout;
}

fn os_stdout_write(buf: []u8): void { os_stdout_write(buf.ptr, buf.len); }
fn os_stderr_write(buf: []u8): void { os_stderr_write(buf.ptr, buf.len); }
fn os_file_read(h: OsFile, buf: []u8): i64 { return os_file_read(h, buf.ptr, buf.len); }
fn os_file_write(h: OsFile, buf: []u8): i64 { return os_file_write(h, buf.ptr, buf.len); }
fn os_cwd(buf: []u8): i64 { return os_cwd(buf.ptr, buf.len); }
fn os_temp_dir(buf: []u8): i64 { return os_temp_dir(buf.ptr, buf.len); }
fn os_path_abs(buf: []u8, path: []u8): i64 { return os_path_abs(buf.ptr, buf.len, path); }

#linkc("GetEnvironmentVariableW") fn win_GetEnvironmentVariableW(name: *u16, buffer: *u16, size: u32): u32;
#linkc("SetEnvironmentVariableW") fn win_SetEnvironmentVariableW(name: *u16, value: *u16): i32;

fn os_get_env(name: []u8, alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    name_w := #temp_utf8_to_utf16(name, alloc).ptr;
    need := win_GetEnvironmentVariableW(name_w, nullptr(u16), 0);   // size with the NULL
    if (need == 0) {
        return empty_slice(u8);
    }
    wbuf := #temp_buffer(need.cast(i64) * 2, alloc).ptr.cast(*u16);
    n := win_GetEnvironmentVariableW(name_w, wbuf, need);
    if (n == 0 || n >= need) {
        return empty_slice(u8);
    }
    return utf16_to_utf8(slice(wbuf, n.cast(i64)), alloc);
}

fn os_set_env(name: []u8, value: []u8): void {
    win_SetEnvironmentVariableW(#temp_utf8_to_utf16(name).ptr, #temp_utf8_to_utf16(value).ptr);
}

fn os_delete_env(name: []u8): void {
    win_SetEnvironmentVariableW(#temp_utf8_to_utf16(name).ptr, nullptr(u16));
}
