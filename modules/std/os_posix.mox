import "internal.mox";
import "./slice.mox";
import "./vt_input.mox"; // shared Event model + the VT byte parser
import "./context.mox";
import "./c_interop.mox";
import "./arena.mox";
import "./alloc.mox";
import "./string.mox";

// Stored as fd+1
const OsFile := #type u64;

// Signatures must match the portable section of os_win.mox exactly.
// macOS needs different values for some constants, not done yet.

// libc declarations

#linkc("getpagesize") fn posix_getpagesize(): i32;
#linkc("mmap")     fn posix_mmap(addr: *u8, len: u64, prot: i32, flags: i32, fd: i32, off: i64): *u8;
#linkc("munmap")   fn posix_munmap(addr: *u8, len: u64): i32;
#linkc("mprotect") fn posix_mprotect(addr: *u8, len: u64, prot: i32): i32;
#linkc("madvise")  fn posix_madvise(addr: *u8, len: u64, advice: i32): i32;

#linkc("open")   fn posix_open(path: *u8, flags: i32, mode: u32): i32;
#linkc("close")  fn posix_close(fd: i32): i32;
#linkc("read")   fn posix_read(fd: i32, buf: *u8, n: u64): i64;
#linkc("write")  fn posix_write(fd: i32, buf: *u8, n: u64): i64;
#linkc("lseek")  fn posix_lseek(fd: i32, off: i64, whence: i32): i64;
#linkc("unlink") fn posix_unlink(path: *u8): i32;
#linkc("getcwd") fn posix_getcwd(buf: *u8, size: u64): *u8;
#linkc("fcntl")  fn posix_fcntl(fd: i32, cmd: i32, arg: i32): i32;
#linkc("ioctl")  fn posix_ioctl(fd: i32, req: u64, arg: *u8): i32;

struct PosixPollFd { fd: i32; events: i16; revents: i16; };
#linkc("poll") fn posix_poll(fds: *PosixPollFd, nfds: u64, timeout_ms: i32): i32;

// struct termios: 60 bytes on glibc, opaque blob
#linkc("tcgetattr")  fn posix_tcgetattr(fd: i32, t: *u8): i32;
#linkc("tcsetattr")  fn posix_tcsetattr(fd: i32, actions: i32, t: *u8): i32;
#linkc("cfmakeraw")  fn posix_cfmakeraw(t: *u8): void;

// glibc x86_64 dirent64: d_name at offset 19
struct PosixDirent {
    d_ino: u64;
    d_off: i64;
    d_reclen: u16;
    d_type: u8;
    d_name: [256]u8;
};
#linkc("opendir")  fn posix_opendir(path: *u8): *u8;
#linkc("access")   fn posix_access(path: *u8, mode: i32): i32; // mode 0 = F_OK
#linkc("readdir")  fn posix_readdir(d: *u8): *PosixDirent;
#linkc("closedir") fn posix_closedir(d: *u8): i32;

#linkc("posix_openpt") fn posix_openpt(flags: i32): i32;
#linkc("grantpt")  fn posix_grantpt(fd: i32): i32;
#linkc("unlockpt") fn posix_unlockpt(fd: i32): i32;
#linkc("ptsname")  fn posix_ptsname(fd: i32): *u8;
#linkc("pipe")     fn posix_pipe(fds: *i32): i32; // fds: int[2], [0] = read end, [1] = write end
#linkc("fork")     fn posix_fork(): i32;
#linkc("setsid")   fn posix_setsid(): i32;
#linkc("setpgid")  fn posix_setpgid(pid: i32, pgid: i32): i32;
#linkc("dup2")     fn posix_dup2(oldfd: i32, newfd: i32): i32;
#linkc("execvp")   fn posix_execvp(file: *u8, argv: *u8): i32; // argv: char* const argv[]
#linkc("_exit")    fn posix_exit_now(code: i32): void;
#linkc("kill")     fn posix_kill(pid: i32, sig: i32): i32;
#linkc("waitpid")  fn posix_waitpid(pid: i32, status: *i32, options: i32): i32;
#linkc("chdir")    fn posix_chdir(path: *u8): i32;
#linkc("signal")   fn posix_signal(sig: i32, handler: *u8): *u8; // returns the previous handler

struct PosixTimespec { tv_sec: i64; tv_nsec: i64; };
#linkc("clock_gettime") fn posix_clock_gettime(clock_id: i32, ts: *PosixTimespec): i32;
#linkc("mkdir")    fn posix_mkdir(path: *u8, mode: u32): i32;
#linkc("rmdir")    fn posix_rmdir(path: *u8): i32;
#linkc("rename")   fn posix_rename(from: *u8, to: *u8): i32;
#linkc("readlink") fn posix_readlink(path: *u8, buf: *u8, size: u64): i64;
#linkc("getenv")   fn posix_getenv(name: *u8): *u8;
#linkc("setenv")   fn posix_setenv(name: *u8, value: *u8, overwrite: i32): i32;
#linkc("unsetenv") fn posix_unsetenv(name: *u8): i32;

// linux/x86_64 constants

const POSIX_PROT_NONE        : i32 = 0;
const POSIX_PROT_RW          : i32 = 3;    // PROT_READ|PROT_WRITE
const POSIX_MAP_PRIVATE_ANON : i32 = 34;   // MAP_PRIVATE|MAP_ANONYMOUS
const POSIX_MADV_DONTNEED    : i32 = 4;
const POSIX_NO_FD            : i32 = -1;

const POSIX_O_RDONLY  : i32 = 0;
const POSIX_O_WRONLY_CREAT_TRUNC : i32 = 577; // O_WRONLY|O_CREAT|O_TRUNC
const POSIX_O_RDWR    : i32 = 2;
const POSIX_O_NOCTTY  : i32 = 256;
const POSIX_O_NONBLOCK: i32 = 2048;
const POSIX_MODE_0644 : u32 = 420;

const POSIX_SEEK_SET : i32 = 0;
const POSIX_SEEK_CUR : i32 = 1;
const POSIX_SEEK_END : i32 = 2;

const POSIX_F_SETFL  : i32 = 4;
const POSIX_F_SETFD  : i32 = 2;
const POSIX_FD_CLOEXEC : i32 = 1;
const POSIX_EINTR    : i32 = 4;

#if (MOX_OS == .Darwin) {
    const POSIX_O_CLOEXEC       : i32 = 16777216; // 0x1000000
    const POSIX_F_DUPFD_CLOEXEC : i32 = 67;
    const POSIX_EAGAIN          : i32 = 35;
    #linkc("__error") fn _posix_errno_ptr(): *i32;

    // Darwin keeps reading d_type only; its dirent/stat layouts belong to the macOS constants work
    fn _posix_entry_mode(d: *u8, name: *u8): u32 { return 0; }

    // the file type of path itself, made up without stat (see above); 0 = it does not exist
    fn _posix_path_mode(path: []u8): u32 {
        b: [1]u8 = 0;
        if (posix_readlink(#temp_c_string(path), b.ptr, 1) >= 0) { return POSIX_S_IFLNK; }
        if (os_dir_exists(path)) { return POSIX_S_IFDIR; }
        if (os_path_exists(path)) { return POSIX_S_IFREG; }
        return 0;
    }
} else {
    const POSIX_O_CLOEXEC       : i32 = 524288;   // 0x80000
    const POSIX_F_DUPFD_CLOEXEC : i32 = 1030;
    const POSIX_EAGAIN          : i32 = 11;
    const POSIX_SYS_CLOSE_RANGE : i64 = 436;
    #linkc("__errno_location") fn _posix_errno_ptr(): *i32;
    #linkc("pipe2")   fn posix_pipe2(fds: *i32, flags: i32): i32;
    #linkc("syscall") fn posix_syscall4(n: i64, a: i64, b: i64, c: i64, d: i64): i64;

    // x86_64 Linux struct stat (144 bytes)
    struct _PosixStat {
        st_dev: u64;
        st_ino: u64;
        st_nlink: u64;
        st_mode: u32;
        st_uid: u32;
        st_gid: u32;
        _pad0: u32;
        st_rdev: u64;
        st_size: i64;
        st_blksize: i64;
        st_blocks: i64;
        st_times: [6]i64; // atime, mtime, ctime as sec + nsec
        _reserved: [3]i64;
    };
    #linkc("fstat")     fn posix_fstat(fd: i32, st: *_PosixStat): i32;
    #linkc("fstatat")   fn posix_fstatat(dirfd: i32, path: *u8, st: *_PosixStat, flags: i32): i32;
    #linkc("dirfd")     fn posix_dirfd(d: *u8): i32;
    const POSIX_AT_SYMLINK_NOFOLLOW : i32 = 256; // 0x100

    const POSIX_AT_FDCWD : i32 = -100;

    // st_mode of an entry whose d_type is DT_UNKNOWN, asked without following a symlink; 0 when it can not be read
    fn _posix_entry_mode(d: *u8, name: *u8): u32 {
        st: _PosixStat = 0;
        if (posix_fstatat(posix_dirfd(d), name, st.^, POSIX_AT_SYMLINK_NOFOLLOW) != 0) { return 0; }
        return st.st_mode;
    }

    // st_mode of path itself (lstat); 0 = it does not exist or can not be read
    fn _posix_path_mode(path: []u8): u32 {
        st: _PosixStat = 0;
        if (posix_fstatat(POSIX_AT_FDCWD, #temp_c_string(path), st.^, POSIX_AT_SYMLINK_NOFOLLOW) != 0) { return 0; }
        return st.st_mode;
    }
}

fn _posix_errno(): i32 {
    return _posix_errno_ptr().*;
}

// calls again while it fails with EINTR: a signal handler ran before the call did anything
fn #posix_retry(call: __ast_ptr): i64 {
    while (true) {
        r := (`#land_ast call).cast(i64); // the call returns i32 or i64
        if ((r >= 0) || (_posix_errno() != POSIX_EINTR)) { return r; }
    }
    return -1;
}

// both ends close on exec
fn _posix_pipe_cloexec(fds: *i32): bool {
    #if (MOX_OS == .Darwin) {
        if (posix_pipe(fds) != 0) { return false; }
        posix_fcntl(fds.*, POSIX_F_SETFD, POSIX_FD_CLOEXEC);
        posix_fcntl(type_offset(fds, 1).*, POSIX_F_SETFD, POSIX_FD_CLOEXEC);
        return true;
    } else {
        return posix_pipe2(fds, POSIX_O_CLOEXEC) == 0;
    }
}

// child side, after fork: closes every fd above 2. Linux only (an old kernel without close_range skips it);
// elsewhere the fds std opens are close-on-exec, fds other code opened without it still reach the child.
fn _posix_child_close_from_3(): void {
    #if (MOX_OS != .Darwin) {
        posix_syscall4(POSIX_SYS_CLOSE_RANGE, 3, 4294967295, 0, 0);
    }
}

const POSIX_TCSANOW      : i32 = 0;
const POSIX_TIOCGWINSZ   : u64 = 21523; // 0x5413
const POSIX_TIOCSWINSZ   : u64 = 21524; // 0x5414
const POSIX_TIOCSCTTY    : u64 = 21518; // 0x540E
const POSIX_POLLIN       : i16 = 1;
const POSIX_POLLOUT      : i16 = 4;
const POSIX_POLLERR      : i16 = 8;
const POSIX_POLLHUP      : i16 = 16;
const POSIX_POLLNVAL     : i16 = 32;

const POSIX_WNOHANG : i32 = 1;
const POSIX_SIGKILL : i32 = 9;
const POSIX_SIGPIPE : i32 = 13;
const POSIX_SIG_IGN : u64 = 1;          // (sighandler_t)1
const POSIX_CLOCK_MONOTONIC : i32 = 1;
const POSIX_CLOCK_REALTIME  : i32 = 0;
const POSIX_MODE_0755 : u32 = 493;

const _POSIX_EXEC_READ_BUF     : i64 = 65536; // read block per pump call, as big as a Linux pipe
const _POSIX_EXEC_WRITE_CHUNK  : i64 = 4096;  // = PIPE_BUF: POLLOUT only promises that much room, a bigger write on our blocking pipe could block
const POSIX_DT_UNKNOWN : u8 = 0; // the filesystem does not fill d_type (some XFS, NFS, FUSE)
const POSIX_DT_DIR  : u8 = 4;
const POSIX_DT_LNK  : u8 = 10;
const POSIX_S_IFMT  : u32 = 61440; // 0o170000
const POSIX_S_IFDIR : u32 = 16384; // 0o040000
const POSIX_S_IFLNK : u32 = 40960; // 0o120000
const POSIX_S_IFREG : u32 = 32768; // 0o100000

const POSIX_MAP_FAILED : u64 = 18446744073709551615; // (void*)-1

struct PosixWinSize { ws_row: u16; ws_col: u16; ws_xpixel: u16; ws_ypixel: u16; };

// ---- portable OS API ----

// virtual memory pages

fn os_get_memory_page_size(): i64 {
    return posix_getpagesize().cast(i64);
}

fn os_mem_virtual_reserve(size: i64): *u8 {
    p := posix_mmap(nullptr(u8), size.cast(u64), POSIX_PROT_NONE, POSIX_MAP_PRIVATE_ANON, POSIX_NO_FD, 0);
    if (p.cast(u64) == POSIX_MAP_FAILED) { return nullptr(u8); }
    return p;
}

fn os_mem_virtual_commit(ptr: *u8, size: i64): bool {
    return posix_mprotect(ptr, size.cast(u64), POSIX_PROT_RW) == 0;
}

fn os_mem_virtual_decommit(ptr: *u8, size: i64): bool {
    posix_madvise(ptr, size.cast(u64), POSIX_MADV_DONTNEED);
    return posix_mprotect(ptr, size.cast(u64), POSIX_PROT_NONE) == 0;
}

fn os_mem_virtual_release(ptr: *u8, size: i64): bool {
    return posix_munmap(ptr, size.cast(u64)) == 0;
}

// heap

#linkc("posix_memalign")     fn posix_memalign(out_mem: **u8, align: u64, size: u64): i32;
#linkc("malloc_usable_size") fn posix_malloc_usable_size(mem: *u8): u64;
#linkc("free")               fn posix_free(mem: *u8): void;
#linkc("abort")              fn posix_abort(): void;

fn os_heap_alloc(size: i64, align: u32): *u8 {
    a := align.cast(u64);
    if (a < 8) { a = 8; }
    mem: *u8 = nullptr(u8);
    if (posix_memalign(mem.^, a, size.cast(u64)) != 0) { return nullptr(u8); }
    return mem;
}

fn os_heap_realloc(mem: *u8, new_size: i64, align: u32): *u8 {
    if (mem == nullptr(u8)) { return os_heap_alloc(new_size, align); }
    nm := os_heap_alloc(new_size, align);
    if (nm == nullptr(u8)) { return nullptr(u8); }
    old_size := posix_malloc_usable_size(mem).cast(i64);
    n := old_size;
    if (new_size < n) { n = new_size; }
    mem_copy(nm, mem, n);
    posix_free(mem);
    return nm;
}

fn os_heap_free(mem: *u8): void {
    posix_free(mem);
}

fn os_abort(): void {
    posix_abort();
}

// thread local storage: one pointer per thread per key, via pthread keys.
// The destructor runs on thread exit if the slot holds a non-null pointer.

const OsTlsKey  := #type u64;                                  // wraps a pthread_key_t (u32 on linux/glibc)
const OsTlsDtor : __type_ptr = #type *fn(value: *u8): void;

#linkc("pthread_key_create")  fn posix_pthread_key_create(key_out: *u32, dtor: OsTlsDtor): i32;
#linkc("pthread_key_delete")  fn posix_pthread_key_delete(key: u32): i32;
#linkc("pthread_getspecific") fn posix_pthread_getspecific(key: u32): *u8;
#linkc("pthread_setspecific") fn posix_pthread_setspecific(key: u32, value: *u8): i32;

fn os_tls_key_create(key_out: *OsTlsKey, dtor: OsTlsDtor): bool {
    k: u32 = 0;
    if (posix_pthread_key_create(k.^, dtor) != 0) { return false; }
    key_out.* = k.cast(u64);
    return true;
}

fn os_tls_key_create_simple(key_out: *OsTlsKey): bool {
    return os_tls_key_create(key_out, nullptr(u8).cast(OsTlsDtor));
}

fn os_tls_get(key: OsTlsKey): *u8 {
    return posix_pthread_getspecific(key.cast(u32));
}

fn os_tls_set(key: OsTlsKey, value: *u8): bool {
    return posix_pthread_setspecific(key.cast(u32), value) == 0;
}

fn os_tls_key_free(key: OsTlsKey): bool {
    return posix_pthread_key_delete(key.cast(u32)) == 0;
}

#linkc("atexit") fn c_atexit(f: *fn(): void): i32;
#linkc("exit")   fn c_exit(code: i32): void;

// panic state (see panic.mox): 0 = no panic, 1 = panicking, 2 = the panic message was printed at exit
is_panicking: u8 = 0;
panic_message: []u8 = 0;
_os_panic_printer: bool = false;

// runs after every os_atexit handler, so the panic message is the last thing printed even when a handler cleared the screen
fn _os_print_panic_at_exit(): void {
    if (is_panicking != 1) { return; }
    os_stderr_write(panic_message.ptr, panic_message.len);
    nl := "\n";
    os_stderr_write(nl.ptr, nl.len);
    is_panicking = 2;
}

// false when the panic printer could not be registered
fn os_register_panic_printer(): bool {
    if (!_os_panic_printer) { _os_panic_printer = c_atexit(_os_print_panic_at_exit.^) == 0; }
    return _os_panic_printer;
}

// f runs when the process exits through exit(), a return from main or a panic, on the thread that exits it
fn os_atexit(f: *fn(): void): bool {
    os_register_panic_printer();
    return c_atexit(f) == 0;
}

// exits through exit(): os_atexit handlers and the exiting thread's thread_on_exit callbacks run
fn os_exit(code: i32): void {
    c_exit(code);
}

// threads

const OsThreadStart : __type_ptr = #type *fn(arg: *u8): *u8;

#linkc("pthread_create") fn posix_thread_create(th_out: *u64, attr: *u8, start: OsThreadStart, arg: *u8): i32;
#linkc("pthread_join")   fn posix_thread_join(th: u64, ret_out: **u8): i32;

fn os_thread_create(start: OsThreadStart, arg: *u8, handle_out: *u64): bool {
    th: u64 = 0;
    if (posix_thread_create(th.^, nullptr(u8), start, arg) != 0) { return false; }
    handle_out.* = th;
    return true;
}

fn os_thread_join(handle: u64): bool {
    return posix_thread_join(handle, nullptr(*u8)) == 0;
}

// console

const _POSIX_TERMIOS_BUF : i64 = 128; // struct termios: 60 bytes on Linux, 72 on Darwin
_os_saved_termios: [128]u8 = #memory_garbage;
_os_termios_saved: bool = false;
_os_console_atexit: bool = false;

// raw mode on the controlling tty (fd 0); output is plain VT, no setup needed. false when fd 0 is not a tty: nothing is changed then.
// The first call saves the tty state for os_console_restore, which also runs at process exit and after a panic (not after _exit or os_abort).
fn os_console_setup_raw(): bool {
    cur: [128]u8 = #memory_garbage;
    if (posix_tcgetattr(0, cur.ptr) != 0) { return false; }
    // a second setup keeps the state saved by the first, so restore still goes back to the original
    if (!_os_termios_saved) {
        mem_copy(_os_saved_termios.ptr, cur.ptr, _POSIX_TERMIOS_BUF);
        _os_termios_saved = true;
        if (!_os_console_atexit) { _os_console_atexit = os_atexit(os_console_restore.^); }
    }
    posix_cfmakeraw(cur.ptr);
    return #posix_retry(#ast posix_tcsetattr(0, POSIX_TCSANOW, cur.ptr)) == 0;
}

// puts back what the first os_console_setup_raw saved; does nothing when nothing is saved
fn os_console_restore(): void {
    if (!_os_termios_saved) { return; }
    _os_termios_saved = false;
    #posix_retry(#ast posix_tcsetattr(0, POSIX_TCSANOW, _os_saved_termios.ptr));
}

fn os_console_size(cols: *u32, rows: *u32): bool {
    ws: PosixWinSize = 0;
    if (posix_ioctl(1, POSIX_TIOCGWINSZ, ws.^.cast(*u8)) != 0) { return false; }
    if ((ws.ws_col == 0) || (ws.ws_row == 0)) { return false; }
    cols.* = ws.ws_col.cast(u32);
    rows.* = ws.ws_row.cast(u32);
    return true;
}

fn _posix_write_all(fd: i32, buf: *u8, len: i64): void {
    // write() can return short (2 GiB single-call cap); loop until all bytes are out
    total: i64 = 0;
    while (total < len) {
        p := buf |> byte_offset(total);
        r := #posix_retry(#ast posix_write(fd, p, (len - total).cast(u64)));
        if (r <= 0) { break; }
        total += r;
    }
}

fn os_stdout_write(buf: *u8, len: i64): void {
    _posix_write_all(1, buf, len);
}

fn os_stderr_write(buf: *u8, len: i64): void {
    _posix_write_all(2, buf, len);
}

// waits up to ms for input on stdin, negative = no limit
fn os_stdin_wait(ms: i64): void {
    pfd: PosixPollFd = 0;
    pfd.fd = 0;
    pfd.events = POSIX_POLLIN;
    wait: i32 = -1;
    if (ms >= 0) { wait = min(ms, 2147483647).cast(i32); }
    posix_poll(pfd.^, 1, wait);
}

// clipboard: stubs, a bare tty has no clipboard

fn os_clipboard_set(text: []u8): bool {
    return false;
}

fn os_clipboard_get(alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    return empty_slice(u8);
}

// files, handle model: u64, 0 = invalid/failed, fd stored as fd+1

fn os_file_open_read(path: *u8): OsFile {
    fd := #posix_retry(#ast posix_open(path, POSIX_O_RDONLY | POSIX_O_CLOEXEC, 0)).cast(i32);
    if (fd < 0) { return 0; }
    return (fd + 1).cast(u64);
}

// create/truncate for writing
fn os_file_open_write(path: *u8): OsFile {
    fd := #posix_retry(#ast posix_open(path, POSIX_O_WRONLY_CREAT_TRUNC | POSIX_O_CLOEXEC, POSIX_MODE_0644)).cast(i32);
    if (fd < 0) { return 0; }
    return (fd + 1).cast(u64);
}

fn os_file_size(h: OsFile): i64 {
    if (h == 0) { return 0; }
    fd := (h.cast(i64) - 1).cast(i32);
    cur := posix_lseek(fd, 0, POSIX_SEEK_CUR);
    end := posix_lseek(fd, 0, POSIX_SEEK_END);
    posix_lseek(fd, cur, POSIX_SEEK_SET);
    if (end < 0) { return 0; }
    return end;
}

// reads up to n bytes in one syscall, returns bytes read, 0 = EOF or error. A single read() transfer caps at 2 GiB.
fn os_file_read(h: OsFile, buf: *u8, n: i64): i64 {
    if (h == 0) { return 0; }
    fd := (h.cast(i64) - 1).cast(i32);
    r := #posix_retry(#ast posix_read(fd, buf, n.cast(u64)));
    if (r <= 0) { return 0; }
    return r;
}

// writes all n bytes, returns how many went out (== n on success)
fn os_file_write(h: OsFile, buf: *u8, n: i64): i64 {
    if (h == 0) { return 0; }
    fd := (h.cast(i64) - 1).cast(i32);
    total: i64 = 0;
    while (total < n) {
        p := buf |> byte_offset(total);
        r := #posix_retry(#ast posix_write(fd, p, (n - total).cast(u64)));
        if (r <= 0) { break; }
        total += r;
    }
    return total;
}

fn os_file_close(h: OsFile): void {
    if (h == 0) { return; }
    fd := (h.cast(i64) - 1).cast(i32);
    posix_close(fd);
}

fn os_file_delete(path: *u8): bool {
    return posix_unlink(path) == 0;
}

// stdout as a writable OsFile
fn os_stdout_file(): OsFile {
    return 2; // fd 1, stored as fd+1
}

// writes the cwd NULL-terminated into buf, returns the length without the NULL
fn os_cwd(buf: *u8, cap: i64): i64 {
    if (posix_getcwd(buf, cap.cast(u64)) == 0) { return 0; }
    n: i64 = 0;
    while (n < cap) {
        if (type_offset(buf, n).* == 0) { break; }
        n += 1;
    }
    return n;
}

// writes the absolute form of path NULL-terminated into buf, returns the length without the NULL, 0 = failed or does not fit.
// Works on the text only, the file does not need to exist and symlinks are not followed: a relative path is joined to the cwd, "." and ".." segments are resolved.
fn os_path_abs(buf: *u8, cap: i64, path: []u8): i64 {
    if (path.len == 0) { return 0; }
    out := slice(buf, cap);
    w: i64 = 0;   // out holds "/seg" parts, so the root is empty until the end
    if (path[0] != char("/")) {
        w = os_cwd(buf, cap);
        if (w == 0) { return 0; }
        if (out[w - 1] == char("/")) { w -= 1; }
    }
    r: i64 = 0;
    while (r < path.len) {
        if (path[r] == char("/")) {
            r += 1;
            continue;
        }
        start := r;
        while (r < path.len && path[r] != char("/")) { r += 1; }
        seg := slice(path, start, r - start);
        if (seg == ".") { continue; }
        if (seg == "..") {
            while (w > 0 && out[w - 1] != char("/")) { w -= 1; }
            if (w > 0) { w -= 1; }
            continue;
        }
        if (w + 1 + seg.len >= cap) { return 0; }
        out[w] = char("/");
        mem_copy(type_offset(buf, w + 1), seg.ptr, seg.len);
        w += 1 + seg.len;
    }
    // the root, or a trailing separator kept like Windows keeps it
    if ((w == 0) || (path[path.len - 1] == char("/"))) {
        if (w + 1 >= cap) { return 0; }
        out[w] = char("/");
        w += 1;
    }
    out[w] = 0;
    return w;
}

// directory listing: os_dir_open(it, "<dir>") then os_dir_next(it) until false. "." and ".." are included.

struct OsDirIter {
    handle: u64;    // DIR*
    pending: bool;  // unused, matches the os_win struct shape
    is_dir: bool;   // false for a symlink to a directory: walks do not follow links
    is_symlink: bool;
    name: []u8;     // view into the readdir entry, valid until the next os_dir_next; copy to keep
};

fn os_dir_open(it: *OsDirIter, dir_path: []u8): bool {
    d := posix_opendir(#temp_c_string(dir_path));
    if (d == 0) {
        it.handle = 0;
        return false;
    }
    it.handle = d.cast(u64);
    it.pending = false;
    return true;
}

fn os_dir_next(it: *OsDirIter): bool {
    if (it.handle == 0) { return false; }
    e := posix_readdir(it.handle.cast(*u8));
    if (e == 0) { return false; }

    // The entry only occupies d_reclen bytes; the [256] on d_name is the header's upper bound, not real storage.
    // Bound the scan by d_reclen (d_name starts 19 bytes in) so a missing NULL cannot walk past the entry.
    name_cap := min(e.d_reclen.cast(i64) - 19, 256);
    it.name.ptr = e.d_name.ptr;
    it.name.len = c_strlen(e.d_name.ptr, name_cap);
    it.is_dir = e.d_type == POSIX_DT_DIR;
    it.is_symlink = e.d_type == POSIX_DT_LNK;
    if (e.d_type == POSIX_DT_UNKNOWN) {
        kind := _posix_entry_mode(it.handle.cast(*u8), e.d_name.ptr) & POSIX_S_IFMT;
        it.is_dir = kind == POSIX_S_IFDIR;
        it.is_symlink = kind == POSIX_S_IFLNK;
    }
    return true;
}

fn os_dir_close(it: *OsDirIter): void {
    if (it.handle != 0) {
        posix_closedir(it.handle.cast(*u8));
        it.handle = 0;
    }
}

// terminal input: os_term_input_init once, then os_term_poll per frame (non-blocking, false = nothing pending).
// Events use the shared model from vt_input.mox. Resize is found by polling the tty size, no SIGWINCH handler.

struct OsTermInput {
    parser: VtParser;
    last_w: u32;
    last_h: u32;
};

fn os_term_input_init(ti: *OsTermInput): void {
    vt_parser_init(ti.parser.^);
    w: u32 = 0;
    h: u32 = 0;
    os_console_size(w.^, h.^);
    ti.last_w = w;
    ti.last_h = h;
}

fn _os_stdin_readable(): bool {
    pfd: PosixPollFd = 0;
    pfd.fd = 0;
    pfd.events = POSIX_POLLIN;
    return posix_poll(pfd.^, 1, 0) > 0;
}

// raw stdin bytes, for terminal query replies. Never blocks.
fn os_stdin_read_bytes(ti: *OsTermInput, buf: *u8, cap: i64): i64 {
    if (!_os_stdin_readable()) { return 0; }
    r := posix_read(0, buf, cap.cast(u64));
    if (r <= 0) { return 0; }
    return r;
}

fn os_term_poll(ti: *OsTermInput, ev: *Event): bool {
    // buffered bytes may already hold a full event
    if (vt_next(ti.parser.^, false, ev)) { return true; }

    // pull whatever stdin has, only as much as the parser has room for, so every byte read gets fed
    tmp: [VT_BUF_CAP]u8 = #memory_garbage;
    n := os_stdin_read_bytes(ti, tmp.ptr, (VT_BUF_CAP - ti.parser.len).cast(i64));
    while (n > 0) {
        vt_feed_bytes(ti.parser.^, tmp.ptr, n);
        if (vt_next(ti.parser.^, false, ev)) { return true; }
        n = os_stdin_read_bytes(ti, tmp.ptr, (VT_BUF_CAP - ti.parser.len).cast(i64));
    }

    // undecided tail (lone ESC or split sequence): wait briefly for the rest, then flush so a lone ESC becomes the escape key
    if (ti.parser.len > 0) {
        os_stdin_wait(10);
        n = os_stdin_read_bytes(ti, tmp.ptr, (VT_BUF_CAP - ti.parser.len).cast(i64));
        if (n > 0) {
            vt_feed_bytes(ti.parser.^, tmp.ptr, n);
            if (vt_next(ti.parser.^, false, ev)) { return true; }
        }
        if (vt_next(ti.parser.^, true, ev)) { return true; }
    }

    // resize: poll the tty size
    w: u32 = 0;
    h: u32 = 0;
    if (os_console_size(w.^, h.^)) {
        if ((w != ti.last_w) || (h != ti.last_h)) {
            ti.last_w = w;
            ti.last_h = h;
            ev.kind = .resize;
            ev.w = w;
            ev.h = h;
            ev.repeat = 1;
            return true;
        }
    }
    return false;
}

// Keep in sync with os_win.mox.

fn os_stdin_read_bytes(ti: *OsTermInput, buf: []u8): i64 { return os_stdin_read_bytes(ti, buf.ptr, buf.len); }

fn os_file_open_read(path: []u8): OsFile {
    return os_file_open_read(#temp_c_string(path));
}
fn os_file_open_write(path: []u8): OsFile {
    return os_file_open_write(#temp_c_string(path));
}
fn os_file_delete(path: []u8): bool {
    return os_file_delete(#temp_c_string(path));
}

// one level; false when it already exists or the parent is missing
fn os_make_dir(path: []u8): bool {
    return posix_mkdir(#temp_c_string(path), POSIX_MODE_0755) == 0;
}

// the directory must be empty
fn os_delete_dir(path: []u8): bool {
    return posix_rmdir(#temp_c_string(path)) == 0;
}

// files and (same-volume) directories; an existing `to` file is replaced
fn os_rename(from: []u8, to: []u8): bool {
    return posix_rename(#temp_c_string(from), #temp_c_string(to)) == 0;
}

#if (MOX_OS == .Darwin) {
    // <copyfile.h>: int copyfile(const char* from, const char* to, copyfile_state_t state, copyfile_flags_t flags)
    #linkc("copyfile") fn darwin_copyfile(from: *u8, to: *u8, state: *u8, flags: u32): i32;
    const DARWIN_COPYFILE_ALL: u32 = 15; // COPYFILE_ACL | COPYFILE_STAT | COPYFILE_XATTR | COPYFILE_DATA

    fn os_copy_file(from: []u8, to: []u8): bool {
        return darwin_copyfile(#temp_c_string(from), #temp_c_string(to), nullptr(u8), DARWIN_COPYFILE_ALL) == 0;
    }
} else {
    // ssize_t copy_file_range(int fd_in, off64_t* off_in, int fd_out, off64_t* off_out, size_t len, unsigned flags)
    #linkc("copy_file_range") fn posix_copy_file_range(fd_in: i32, off_in: *i64, fd_out: i32, off_out: *i64, len: u64, flags: u32): i64;

    #linkc("ftruncate") fn posix_ftruncate(fd: i32, len: i64): i32;
    #linkc("fchmod")    fn posix_fchmod(fd: i32, mode: u32): i32;
    const _POSIX_O_WRONLY_CREAT : i32 = 65; // O_WRONLY|O_CREAT
    const _POSIX_COPY_BUF       : i64 = 65536;

    // copies the rest of fd_in with plain read/write
    fn _posix_copy_rw(fd_in: i32, fd_out: i32): bool {
        t := scratch_begin();
        defer scratch_end(t);
        buf := mem_alloc(t.alloc, _POSIX_COPY_BUF, 1);
        while (true) {
            r := #posix_retry(#ast posix_read(fd_in, buf, _POSIX_COPY_BUF.cast(u64)));
            if (r == 0) { return true; }
            if (r < 0) { return false; }
            off: i64 = 0;
            while (off < r) {
                w := #posix_retry(#ast posix_write(fd_out, byte_offset(buf, off), (r - off).cast(u64)));
                if (w < 0) { return false; }
                off += w;
            }
        }
        return true;
    }

    // copies the data and the permission bits (without setuid/setgid/sticky), also onto an existing file.
    // Copying a file onto itself (same path, hard link or symlink) fails and leaves it untouched.
    fn os_copy_file(from: []u8, to: []u8): bool {
        from_z := #temp_c_string(from);
        fd_in := #posix_retry(#ast posix_open(from_z, POSIX_O_RDONLY | POSIX_O_CLOEXEC, 0)).cast(i32);
        if (fd_in < 0) { return false; }
        defer posix_close(fd_in);
        st_in: _PosixStat = 0;
        if (posix_fstat(fd_in, st_in.^) != 0) { return false; }
        mode := st_in.st_mode & 511; // 0777

        // no O_TRUNC before the same-file check, it would empty the source
        to_z := #temp_c_string(to);
        fd_out := #posix_retry(#ast posix_open(to_z, _POSIX_O_WRONLY_CREAT | POSIX_O_CLOEXEC, mode)).cast(i32);
        if (fd_out < 0) { return false; }
        defer posix_close(fd_out);
        st_out: _PosixStat = 0;
        if (posix_fstat(fd_out, st_out.^) != 0) { return false; }
        if ((st_in.st_dev == st_out.st_dev) && (st_in.st_ino == st_out.st_ino)) { return false; }
        if (#posix_retry(#ast posix_ftruncate(fd_out, 0)) != 0) { return false; }
        posix_fchmod(fd_out, mode); // some filesystems (FAT, some network mounts) refuse it, the data is copied anyway

        // copy_file_range fails across some filesystems, on special files and on old kernels: read/write goes on from where it stopped
        copied: i64 = 0;
        while (true) {
            r := #posix_retry(#ast posix_copy_file_range(fd_in, nullptr(i64), fd_out, nullptr(i64), 1073741824, 0));
            if (r < 0) { return _posix_copy_rw(fd_in, fd_out); }
            if (r == 0) { break; }
            copied += r;
        }
        if (copied == 0) { return _posix_copy_rw(fd_in, fd_out); } // procfs-like files report size 0 and copy_file_range copies nothing
        return true;
    }
}

// "file" means any non-directory entry

fn os_path_exists(path: []u8): bool {
    return posix_access(#temp_c_string(path), 0) == 0; // F_OK
}
fn os_dir_exists(path: []u8): bool {
    d := posix_opendir(#temp_c_string(path));
    if (d == 0) { return false; }
    posix_closedir(d);
    return true;
}
fn os_file_exists(path: []u8): bool {
    if (!os_path_exists(path)) { return false; }
    return !os_dir_exists(path);
}

// os_is_dir / os_is_file / os_is_symlink describe path itself, like the OsDirIter flags: a link is neither a dir nor a file.
// os_dir_exists / os_file_exists above follow links.
fn os_is_dir(path: []u8): bool {
    return (_posix_path_mode(path) & POSIX_S_IFMT) == POSIX_S_IFDIR;
}
fn os_is_file(path: []u8): bool {
    mode := _posix_path_mode(path);
    kind := mode & POSIX_S_IFMT;
    return (mode != 0) && (kind != POSIX_S_IFDIR) && (kind != POSIX_S_IFLNK);
}
fn os_is_symlink(path: []u8): bool {
    return (_posix_path_mode(path) & POSIX_S_IFMT) == POSIX_S_IFLNK;
}

// runs cmd through the platform shell, waits, returns its exit code. -1 = could not start or its status could not be read; a real exit code -1 looks the same, os_exec_ex tells them apart.
fn os_exec(cmd: []u8): i32 {
    opts: ExecOptions = 0;
    r := os_exec_ex(cmd, opts);
    if (!r.exited) { return -1; }
    return r.exit_code;
}

fn os_monotonic_ms(): i64 {
    ts: PosixTimespec = 0;
    posix_clock_gettime(POSIX_CLOCK_MONOTONIC, ts.^);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

fn os_monotonic_ns(): i64 {
    ts: PosixTimespec = 0;
    posix_clock_gettime(POSIX_CLOCK_MONOTONIC, ts.^);
    return ts.tv_sec * 1000000000 + ts.tv_nsec;
}

fn os_unix_time_ms(): i64 {
    ts: PosixTimespec = 0;
    posix_clock_gettime(POSIX_CLOCK_REALTIME, ts.^);
    return ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
}

fn os_sleep_ms(ms: i64): void {
    deadline := #wrap_add(os_monotonic_ms(), max(ms, 0));
    while (true) {
        left := #wrap_sub(deadline, os_monotonic_ms());
        if (left <= 0) { return; }
        _posix_sleep_ms(min(left, 2147483647).cast(i32)); // a signal handler can end it early
    }
}

// writes the temp directory into buf (with a trailing separator), returns the length, 0 = failed
fn os_temp_dir(buf: *u8, cap: i64): i64 {
    dir := os_get_env("TMPDIR", #temp_arena_as_alloc());
    if (dir.len == 0) { dir = "/tmp"; }
    has_sep := dir[dir.len - 1] == char("/");
    n := dir.len + (!has_sep).cast(i64);
    if (n >= cap) { return 0; }
    mem_copy(buf, dir.ptr, dir.len);
    if (!has_sep) { type_offset(buf, dir.len).* = char("/"); }
    return n;
}

enum OsExecStreamMode : u8 {
    inherit := 0; // share the parent's handle
    buffer  := 1; // stdin: fed from ExecOptions.stdin_data, then closed; stdout/stderr: captured into ExecResult
    null    := 2; // NULL / /dev/null
    file    := 3; // the OsFile in ExecOptions.*_file (opened by the caller, stays open)
    merge   := 4; // stderr only: goes wherever stdout goes
};

struct ExecOptions {
    stdin_mode: OsExecStreamMode;
    stdin_data: []u8;   // written to the child when stdin_mode == .buffer, then its stdin is closed
    stdin_file: OsFile;
    stdout_mode: OsExecStreamMode;
    stdout_file: OsFile;
    stderr_mode: OsExecStreamMode;
    stderr_file: OsFile;
    cwd: []u8;          // empty = inherit
    timeout_ms: i64;    // 0 = wait forever; on expiry the child and every process it started are killed and timed_out is set. Posix: with a timeout the child runs in its own process group, so Ctrl+C in the terminal does not reach it and reading from the terminal stops it
    no_window: bool;    // windows only: CREATE_NO_WINDOW, no console flashes up from a GUI parent
    inherit_handles: bool; // false = the child gets only its stdin/stdout/stderr; true = also every inheritable handle (windows) / every fd without close-on-exec (posix)
};

struct ExecResult {
    started: bool;      // false = the command could not be started, nothing else is meaningful
    ok: bool;
    timed_out: bool;
    exited: bool;       // exit_code is the child's own code; false when not started or its status could not be read
    exit_code: i32;     // only meaningful when exited; 128+signal when killed by a signal on posix (also after a timeout kill)
    stdout: []u8;       // on arena, filled only when stdout_mode == .buffer
    stderr: []u8;       // on arena, filled only when stderr_mode == .buffer
};

const OsProcess := #type u64; // pid

enum OsWaitStatus : u8 {
    exited  := 0; // exit_code is the process's code
    running := 1; // timeout_ms passed first
    failed  := 2; // its status can not be read
};

struct OsWaitResult {
    status: OsWaitStatus;
    exit_code: i32; // only meaningful when status == .exited, 0 otherwise
};

// resolves the child's fd for one standard stream from its option.
// child_out: what the child dup2's onto 0/1/2 (-1 = inherit, or .merge which the child does itself); ours_out: our end of the pipe (-1 = none);
// owned_out: child_out was created here and is closed by the parent after fork.
fn _posix_exec_child_fd(mode: OsExecStreamMode, file: OsFile, child_reads: bool, child_out: *i32, ours_out: *i32, owned_out: *bool): bool {
    child_out.* = POSIX_NO_FD;
    ours_out.* = POSIX_NO_FD;
    owned_out.* = false;
    if (mode == .buffer) {
        fds: [2]i32 = 0;
        if (!_posix_pipe_cloexec(fds.ptr)) { return false; }
        if (child_reads) {
            child_out.* = fds[0];
            ours_out.* = fds[1];
        } else {
            child_out.* = fds[1];
            ours_out.* = fds[0];
        }
        owned_out.* = true;
        return true;
    }
    if (mode == .null) {
        devnull := "/dev/null";
        fd := #posix_retry(#ast posix_open(devnull.ptr, POSIX_O_RDWR | POSIX_O_CLOEXEC, 0)).cast(i32);
        if (fd < 0) { return false; }
        child_out.* = fd;
        owned_out.* = true;
        return true;
    }
    if (mode == .file) {
        if (file == 0) { return false; }
        child_out.* = (file.cast(i64) - 1).cast(i32);
        return true;
    }
    return true;
}

fn _posix_close_if(fd: i32): void {
    if (fd >= 0) { posix_close(fd); }
}

fn _posix_close_extra(fd: i32): void {
    if (fd > 2) { posix_close(fd); }
}

// reads what is ready on fd straight into a 64 KB scratch block, then shrinks it in place to what was read
// (alloc must be the scratch arena: only its newest block resizes without a copy). At EOF the fd is closed and set to -1.
fn _posix_exec_pump(fd: *i32, sb: *StringBuilder, alloc: *Alloc): void {
    fdv := fd.*;
    chunk := mem_alloc(alloc, _POSIX_EXEC_READ_BUF, 1);
    r := #posix_retry(#ast posix_read(fdv, chunk, _POSIX_EXEC_READ_BUF.cast(u64)));
    if (r <= 0) {
        mem_free(alloc, chunk);
        posix_close(fdv);
        fd.* = POSIX_NO_FD;
        return;
    }
    push(sb, slice(mem_realloc(alloc, chunk, r, 1), r));
}

// child side: a close-on-exec copy of fd above 2, so routing onto 0/1/2 can not overwrite an fd that is still needed. -1 stays -1.
fn _posix_child_lift_fd(fd: i32): i32 {
    if (fd < 0) { return POSIX_NO_FD; }
    hi := posix_fcntl(fd, POSIX_F_DUPFD_CLOEXEC, 3);
    if (hi < 0) { posix_exit_now(126); }
    return hi;
}

// waits up to timeout_ms for the process to end: 0 = only check, -1 = no limit. exit_code is 128+signal when it was killed by a signal.
// .exited reaps it, so a second call gives .failed; so does a process reaped elsewhere (for example SIGCHLD is ignored).
fn os_wait_process_exit(proc: OsProcess, timeout_ms: i64): OsWaitResult {
    res: OsWaitResult = 0;
    pid := proc.cast(i32);
    flags: i32 = 0;
    if (timeout_ms >= 0) { flags = POSIX_WNOHANG; } // waitpid has no timeout: check, sleep, check again
    deadline := #wrap_add(os_monotonic_ms(), max(timeout_ms, 0)); // wraps for huge timeouts, #wrap_sub below gets the time left back
    st: i32 = 0;
    while (true) {
        r := #posix_retry(#ast posix_waitpid(pid, st.^, flags)).cast(i32);
        if (r == pid) {
            res.status = .exited;
            res.exit_code = _posix_status_to_exit_code(st);
            return res;
        }
        if (r < 0) {
            res.status = .failed;
            return res;
        }
        left := #wrap_sub(deadline, os_monotonic_ms());
        if (left <= 0) {
            res.status = .running;
            return res;
        }
        _posix_sleep_ms(min(left, 10).cast(i32));
    }
    return res;
}

fn _posix_status_to_exit_code(status: i32): i32 {
    sig := status & 127;
    if (sig != 0) { return 128 + sig; }           // killed by a signal, 128+sig shell convention
    return #shr(status, 8) & 255;                 // WEXITSTATUS
}

// runs cmd through the platform shell (/bin/sh -c here, cmd.exe /C on win) with options
// Captured output lives on alloc.
// with a timeout the child leads its own process group, so the kill also reaches every process it started
fn _posix_exec_kill(pid: i32): void {
    if (posix_kill(-pid, POSIX_SIGKILL) == 0) { return; }
    posix_kill(pid, POSIX_SIGKILL);
}

fn os_exec_ex(cmd: []u8, opts: ExecOptions, alloc: *Alloc = get_context_temp_arena_as_alloc()): ExecResult {
    res: ExecResult = 0;

    scratch := scratch_begin(alloc);
    defer scratch_end(scratch);

    cmd_z := arena_push_str_copy_c(scratch.arena, cmd).ptr;
    cwd_z := nullptr(u8);
    if (opts.cwd.len > 0) { cwd_z = arena_push_str_copy_c(scratch.arena, opts.cwd).ptr; }

    in_child: i32 = POSIX_NO_FD;  in_ours: i32 = POSIX_NO_FD;  in_owned := false;
    out_child: i32 = POSIX_NO_FD; out_ours: i32 = POSIX_NO_FD; out_owned := false;
    err_child: i32 = POSIX_NO_FD; err_ours: i32 = POSIX_NO_FD; err_owned := false;

    ok := _posix_exec_child_fd(opts.stdin_mode, opts.stdin_file, true, in_child.^, in_ours.^, in_owned.^);
    if (ok) { ok = _posix_exec_child_fd(opts.stdout_mode, opts.stdout_file, false, out_child.^, out_ours.^, out_owned.^); }
    if (ok) { ok = _posix_exec_child_fd(opts.stderr_mode, opts.stderr_file, false, err_child.^, err_ours.^, err_owned.^); } // .merge: no fd, the child copies 1 onto 2

    pid: i32 = -1;
    if (ok) { pid = posix_fork(); }

    if (pid == 0) {
        // child: route 0/1/2 (dup2 clears close-on-exec on them), drop the rest, move to cwd, exec the shell.
        // Our pipe ends and the lifted copies are close-on-exec, exec drops them.
        if (opts.timeout_ms > 0) { posix_setpgid(0, 0); }
        in_hi := _posix_child_lift_fd(in_child);
        out_hi := _posix_child_lift_fd(out_child);
        err_hi := _posix_child_lift_fd(err_child);
        if (in_hi >= 0)  { posix_dup2(in_hi, 0); }
        if (out_hi >= 0) { posix_dup2(out_hi, 1); }
        if (err_hi >= 0) { posix_dup2(err_hi, 2); }
        if (opts.stderr_mode == .merge) { posix_dup2(1, 2); } // like 2>&1: whatever fd 1 is now, also when stdout is inherited
        if (!opts.inherit_handles) {
            _posix_close_extra(in_child);
            _posix_close_extra(out_child);
            _posix_close_extra(err_child);
            _posix_child_close_from_3();
        }
        if (cwd_z != 0) {
            if (posix_chdir(cwd_z) != 0) { posix_exit_now(126); }
        }
        sh := "/bin/sh";
        dash_c := "-c";
        argv: [4]*u8 = .{ sh.ptr; dash_c.ptr; cmd_z; nullptr(u8); };
        posix_execvp(sh.ptr, argv.ptr.cast(*u8));
        posix_exit_now(127);
    }

    // parent (or the fork failed): the child ends are its now
    if (in_owned)  { posix_close(in_child); }
    if (out_owned) { posix_close(out_child); }
    if (err_owned) { posix_close(err_child); }
    if (pid < 0) {
        _posix_close_if(in_ours);
        _posix_close_if(out_ours);
        _posix_close_if(err_ours);
        return res;
    }
    res.started = true;
    // also done here, so a kill right after fork cannot miss a child that has not called it yet
    if (opts.timeout_ms > 0) { posix_setpgid(pid, pid); }

    // nothing to feed: the child sees EOF right away
    if ((in_ours >= 0) && (opts.stdin_data.len == 0)) {
        posix_close(in_ours);
        in_ours = POSIX_NO_FD;
    }
    // a child that exits before reading all of its stdin would otherwise SIGPIPE us on write
    prev_sigpipe := nullptr(u8);
    sigpipe_ignored := false;
    if (in_ours >= 0) {
        prev_sigpipe = posix_signal(POSIX_SIGPIPE, POSIX_SIG_IGN.cast(*u8));
        sigpipe_ignored = true;
    }

    out_sb: StringBuilder = #memory_garbage;
    err_sb: StringBuilder = #memory_garbage;
    init(out_sb.^, scratch.alloc);
    init(err_sb.^, scratch.alloc);

    deadline: i64 = 0;
    if (opts.timeout_ms > 0) { deadline = #wrap_add(os_monotonic_ms(), opts.timeout_ms); } // wraps for huge timeouts, #wrap_sub below gets the time left back
    in_off: i64 = 0;

    while ((in_ours >= 0) || (out_ours >= 0) || (err_ours >= 0)) {
        wait_ms: i32 = -1;
        if (deadline != 0) {
            left := #wrap_sub(deadline, os_monotonic_ms());
            if (left <= 0) {
                _posix_exec_kill(pid);
                res.timed_out = true;
                break;
            }
            wait_ms = min(left, 2147483647).cast(i32); // a negative poll timeout would mean no limit
        }

        pfds: [3]PosixPollFd = 0;
        n: i64 = 0;
        if (in_ours >= 0)  { p: PosixPollFd = 0; p.fd = in_ours;  p.events = POSIX_POLLOUT; pfds[n] = p; n += 1; }
        if (out_ours >= 0) { p: PosixPollFd = 0; p.fd = out_ours; p.events = POSIX_POLLIN;  pfds[n] = p; n += 1; }
        if (err_ours >= 0) { p: PosixPollFd = 0; p.fd = err_ours; p.events = POSIX_POLLIN;  pfds[n] = p; n += 1; }

        r := posix_poll(pfds.ptr, n.cast(u64), wait_ms);
        if (r <= 0) { continue; } // timeout (handled at the top) or EINTR

        i: i64 = 0;
        while (i < n) {
            p := pfds[i];
            i += 1;
            if (p.revents == 0) { continue; }
            if (p.fd == in_ours) {
                if ((p.revents & (POSIX_POLLERR | POSIX_POLLHUP | POSIX_POLLNVAL)) != 0) {
                    posix_close(in_ours); // child closed its stdin, the rest of the data is not wanted
                    in_ours = POSIX_NO_FD;
                    continue;
                }
                chunk := min(opts.stdin_data.len - in_off, _POSIX_EXEC_WRITE_CHUNK);
                w := #posix_retry(#ast posix_write(in_ours, opts.stdin_data.ptr |> byte_offset(in_off), chunk.cast(u64)));
                if (w > 0) { in_off += w; }
                if ((w <= 0) || (in_off >= opts.stdin_data.len)) {
                    posix_close(in_ours); // all fed (or write failed): EOF for the child
                    in_ours = POSIX_NO_FD;
                }
            } else if (p.fd == out_ours) {
                _posix_exec_pump(out_ours.^, out_sb.^, scratch.alloc);
            } else {
                _posix_exec_pump(err_ours.^, err_sb.^, scratch.alloc);
            }
        }
    }
    _posix_close_if(in_ours);
    _posix_close_if(out_ours);
    _posix_close_if(err_ours);
    if (sigpipe_ignored) { posix_signal(POSIX_SIGPIPE, prev_sigpipe); }

    // the child may outlive its pipes (closed stdout early); wait for it with whatever time is left
    remaining: i64 = -1;
    if ((deadline != 0) && (!res.timed_out)) { remaining = max(#wrap_sub(deadline, os_monotonic_ms()), 0); }
    wr := os_wait_process_exit(pid.cast(u64), remaining);
    if (wr.status == .running) {
        _posix_exec_kill(pid);
        res.timed_out = true;
        wr = os_wait_process_exit(pid.cast(u64), -1);
    }
    res.exited = wr.status == .exited;
    res.exit_code = wr.exit_code;

    if (opts.stdout_mode == .buffer) { res.stdout = finalize(out_sb.^, alloc, false); }
    if (opts.stderr_mode == .buffer) { res.stderr = finalize(err_sb.^, alloc, false); }
    res.ok = res.started && res.exited && (res.exit_code == 0);
    return res;
}

// poll with no fds is a plain sleep
fn _posix_sleep_ms(ms: i32): void {
    posix_poll(nullptr(PosixPollFd), 0, ms);
}

// runs cmd through the platform shell, waits, returns everything it wrote to stdout (on alloc).
// Empty when the command could not start (or printed nothing). stdin and stderr stay inherited; append "2>&1" to capture stderr too.
fn os_exec_output(cmd: []u8, alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    opts: ExecOptions = 0;
    opts.stdout_mode = .buffer;
    return os_exec_ex(cmd, opts, alloc).stdout;
}

fn os_stdout_write(buf: []u8): void { os_stdout_write(buf.ptr, buf.len); }
fn os_stderr_write(buf: []u8): void { os_stderr_write(buf.ptr, buf.len); }
fn os_file_read(h: OsFile, buf: []u8): i64 { return os_file_read(h, buf.ptr, buf.len); }
fn os_file_write(h: OsFile, buf: []u8): i64 { return os_file_write(h, buf.ptr, buf.len); }
fn os_cwd(buf: []u8): i64 { return os_cwd(buf.ptr, buf.len); }
fn os_temp_dir(buf: []u8): i64 { return os_temp_dir(buf.ptr, buf.len); }
fn os_path_abs(buf: []u8, path: []u8): i64 { return os_path_abs(buf.ptr, buf.len, path); }

fn os_get_env(name: []u8, alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    name_c := #temp_c_string(name, alloc);
    env := posix_getenv(name_c);
    if (env == 0) {
        return empty_slice(u8);
    }
    env_len := c_strlen(env);
    buf := mem_alloc_slice(alloc, u8, env_len);
    mem_copy(buf.ptr, env, env_len);
    return buf;
}

fn os_set_env(name: []u8, value: []u8): void {
    posix_setenv(#temp_c_string(name), #temp_c_string(value), 1);
}

fn os_delete_env(name: []u8): void {
    posix_unsetenv(#temp_c_string(name));
}
