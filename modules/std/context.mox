import "internal.mox";
import "./alloc.mox";
import "./arena.mox";
import "./panic.mox";
import "./slice.mox";
import "./threads.mox";

// SCRATCH_ARENA_COUNT per thread, slot 0 is the context temp arena.
const SCRATCH_ARENA_COUNT: i64 = 2;
const SCRATCH_ARENA_RESERVE: i64 = GIGABYTE;
const SCRATCH_ARENA_COMMIT: i64 = 64 * KILOBYTE;

struct _ArenaContext {
    arena: *Arena;
    arena_as_alloc: *Alloc;
};

struct _ScratchContext {
    arenas: [SCRATCH_ARENA_COUNT]_ArenaContext;
};

struct ScratchTemp {
    arena: *Arena;
    alloc: *Alloc;
    pos: i64;
};

_context_is_init: bool = false; #thread_local
_context_alloc: *Alloc = 0; #thread_local
_context_scratch: _ScratchContext = 0; #thread_local
_context_own_arenas: [SCRATCH_ARENA_COUNT]*Arena = 0; #thread_local   // created here, destroyed on thread exit even if replaced

fn init_default_context() {
    _context_alloc = default_alloc();

    i: i64 = 0;
    while (i < SCRATCH_ARENA_COUNT) {
        if (_context_scratch.arenas[i].arena == 0) {
            arena := arena_create_virtual(SCRATCH_ARENA_RESERVE, SCRATCH_ARENA_COMMIT);
            _context_own_arenas[i] = arena;
            set_context_scratch_arena(i, arena);
        }
        i += 1;
    }
}

fn _require_context_init() {
    if (!_context_is_init) {
        init_default_context();
        _context_is_init = true;
        thread_on_exit(_context_free_thread.^, nullptr(u8));
    }
}

fn _context_free_thread(data: *u8): void {
    i: i64 = 0;
    while (i < SCRATCH_ARENA_COUNT) {
        if (_context_own_arenas[i] != 0) {
            arena_destroy(_context_own_arenas[i]);
            _context_own_arenas[i] = 0;
        }
        i += 1;
    }
    empty: _ScratchContext = 0;
    _context_scratch = empty;
    _context_alloc = 0;
    _context_is_init = false;
}

fn get_context_alloc(): *Alloc {
    _require_context_init();
    return _context_alloc;
}


fn set_context_alloc(alloc: *Alloc): *Alloc {
    _require_context_init();
    old := _context_alloc;
    _context_alloc = alloc;
    return old;
}

fn _check_scratch_index(i: i64): void {
    if (i < 0 || i >= SCRATCH_ARENA_COUNT) {
        panic("scratch arena index {} is out of range (SCRATCH_ARENA_COUNT = {})", .{ i; SCRATCH_ARENA_COUNT; });
    }
}

fn get_context_scratch_arena(i: i64): *Arena {
    _require_context_init();
    _check_scratch_index(i);
    return _context_scratch.arenas[i].arena;
}

fn get_context_scratch_arena_as_alloc(i: i64): *Alloc {
    _require_context_init();
    _check_scratch_index(i);
    return _context_scratch.arenas[i].arena_as_alloc;
}

fn set_context_scratch_arena(i: i64, arena: *Arena): _ArenaContext {
    return set_context_scratch_arena(i, arena, arena_as_allocator(arena));
}

fn set_context_scratch_arena(i: i64, arena: *Arena, arena_as_alloc: *Alloc): _ArenaContext {
    _check_scratch_index(i);
    prev := _context_scratch.arenas[i];
    ctx_value: _ArenaContext = .{
        arena = arena;
        arena_as_alloc = arena_as_alloc;
    };
    _context_scratch.arenas[i] = ctx_value;
    return prev;
}

fn get_context_temp_arena(): *Arena {
    return get_context_scratch_arena(0);
}

fn get_context_temp_arena_as_alloc(): *Alloc {
    return get_context_scratch_arena_as_alloc(0);
}

fn set_context_temp_arena(arena: *Arena): _ArenaContext {
    return set_context_scratch_arena(0, arena);
}

fn set_context_temp_arena(arena: *Arena, arena_as_alloc: *Alloc): _ArenaContext {
    return set_context_scratch_arena(0, arena, arena_as_alloc);
}

fn _scratch_begin(conflict: *Arena): ScratchTemp {
    _require_context_init();
    i: i64 = 0;
    while (i < SCRATCH_ARENA_COUNT) {
        slot := _context_scratch.arenas[i];
        if (slot.arena != conflict) {
            t: ScratchTemp = .{
                arena = slot.arena;
                alloc = slot.arena_as_alloc;
                pos = arena_current_pos(slot.arena);
            };
            return t;
        }
        i += 1;
    }
    panic("scratch_begin: all {} scratch arenas are the conflict arena", .{ SCRATCH_ARENA_COUNT; });
    none: ScratchTemp = 0;
    return none;
}

fn scratch_begin(): ScratchTemp {
    return _scratch_begin(nullptr(Arena));
}

fn scratch_begin(conflict: *Alloc): ScratchTemp {
    return _scratch_begin(get_alloc_backing_arena(conflict));
}

fn scratch_end(t: ScratchTemp): void {
    arena_pop_to(t.arena, t.pos);
}

fn #temp_arena(): *Arena {
    t := scratch_begin();
    defer scratch_end(t);
    return t.arena;
}

fn #temp_arena(conflict: *Alloc): *Arena {
    t := scratch_begin(conflict);
    defer scratch_end(t);
    return t.arena;
}

fn #temp_arena_as_alloc(): *Alloc {
    t := scratch_begin();
    defer scratch_end(t);
    return t.alloc;
}

fn #temp_arena_as_alloc(conflict: *Alloc): *Alloc {
    t := scratch_begin(conflict);
    defer scratch_end(t);
    return t.alloc;
}

fn #temp_buffer(size: i64): []u8 {
    t := scratch_begin();
    tmp := arena_push(t.arena, size);
    defer scratch_end(t);
    return tmp;
}

fn #temp_buffer(size: i64, conflict: *Alloc): []u8 {
    t := scratch_begin(conflict);
    tmp := arena_push(t.arena, size);
    defer scratch_end(t);
    return tmp;
}
