// Wrapper over HANDLE
const OsFile := #type u64;

// Win32 HANDLE, pointer sized
const WIN_HANDLE := #type *u8;

#linkc("VirtualAlloc") fn win_virtual_alloc(ptr: *u8, size: u64, allocation_type: u32, protect: u32): *u8;
#linkc("VirtualFree") fn win_virtual_free(ptr: *u8, size: u64, allocation_type: u32): u8;

struct WIN_SystemInfo {
    wProcessorArchitecture: u16;
    wReserved: u16;

    dwPageSize: u32;
    lpMinimumApplicationAddress: *u8;
    lpMaximumApplicationAddress: *u8;
    dwActiveProcessorMask: *u32;
    dwNumberOfProcessors: u32;
    dwProcessorType: u32;
    dwAllocationGranularity: u32;
    wProcessorLevel: u16;
    wProcessorRevision: u16;
};

#linkc("GetSystemInfo") fn win_get_system_info(system_info: *WIN_SystemInfo): void;

system_info_cached: WIN_SystemInfo = #memory_garbage;

fn win_get_system_info_cached(): WIN_SystemInfo {
    if (system_info_cached.dwPageSize == 0) {
        win_get_system_info(system_info_cached.^);
    }
    return system_info_cached;
}

fn win_get_page_size_cached(): u32 {
    return win_get_system_info_cached().dwPageSize;
}

// console (xterm-256color terminal UI)

const STD_INPUT_HANDLE  : u32 = 4294967286; // (DWORD)-10
const STD_OUTPUT_HANDLE : u32 = 4294967285; // (DWORD)-11
const STD_ERROR_HANDLE  : u32 = 4294967284; // (DWORD)-12

#linkc("GetStdHandle") fn GetStdHandle(nStdHandle: u32): WIN_HANDLE;
#linkc("GetConsoleMode") fn GetConsoleMode(h: WIN_HANDLE, mode_out: *u32): i32;
#linkc("SetConsoleMode") fn SetConsoleMode(h: WIN_HANDLE, mode: u32): i32;
#linkc("GetNumberOfConsoleInputEvents") fn GetNumberOfConsoleInputEvents(h: WIN_HANDLE, count_out: *u32): i32;
#linkc("ReadFile") fn ReadFile(h: WIN_HANDLE, buf: *u8, n: u32, read_out: *u32, overlapped: *u8): i32;
#linkc("WaitForSingleObject") fn WaitForSingleObject(h: WIN_HANDLE, ms: u32): u32;
#linkc("SetConsoleOutputCP") fn SetConsoleOutputCP(cp: u32): i32;

// INPUT_RECORD.EventType
enum WinEventType : u16 {
    key                := 1;
    mouse              := 2;
    window_buffer_size := 4;
};

// SetConsoleMode bits for the input handle
enum ConsoleInMode : u32 {
    window   := 8;    // ENABLE_WINDOW_INPUT
    mouse    := 16;   // ENABLE_MOUSE_INPUT
    extended := 128;  // ENABLE_EXTENDED_FLAGS (also disables quick-edit)
};

// SetConsoleMode bits for the output handle
enum ConsoleOutMode : u32 {
    processed := 1;   // ENABLE_PROCESSED_OUTPUT
    vt        := 4;   // ENABLE_VIRTUAL_TERMINAL_PROCESSING
};

// MOUSE_EVENT_RECORD.dwEventFlags
enum MouseEventFlag : u32 {
    moved        := 1;
    double_click := 2;
    wheeled      := 4;
};

// MOUSE_EVENT_RECORD.dwButtonState bits
enum MouseButtonBit : u32 {
    left   := 1;   // FROM_LEFT_1ST_BUTTON_PRESSED
    right  := 2;   // RIGHTMOST_BUTTON_PRESSED
    middle := 4;   // FROM_LEFT_2ND_BUTTON_PRESSED
};

// control key state masks, left and right variants OR-ed together
enum ControlKeyMask : u32 {
    shift := 16;  // SHIFT_PRESSED
    ctrl  := 12;  // LEFT_CTRL_PRESSED | RIGHT_CTRL_PRESSED
    alt   := 3;   // LEFT_ALT_PRESSED | RIGHT_ALT_PRESSED
};

struct COORD { X: i16; Y: i16; };
struct SMALL_RECT { Left: i16; Top: i16; Right: i16; Bottom: i16; };

struct KEY_EVENT_RECORD {
    bKeyDown: i32;
    wRepeatCount: u16;
    wVirtualKeyCode: u16;
    wVirtualScanCode: u16;
    UnicodeChar: u16;
    dwControlKeyState: u32;
};

struct MOUSE_EVENT_RECORD {
    dwMousePosition: COORD;
    dwButtonState: u32;
    dwControlKeyState: u32;
    dwEventFlags: u32;
};

struct WINDOW_BUFFER_SIZE_RECORD { dwSize: COORD; };

// Win32 tagged union: EventType picks which *_EVENT_RECORD lives in the 16 byte Event blob, cast its address.
struct INPUT_RECORD {
    EventType: WinEventType;
    _pad: u16;
    Event: [16]u8;
};

struct CONSOLE_SCREEN_BUFFER_INFO {
    dwSize: COORD;
    dwCursorPosition: COORD;
    wAttributes: u16;
    srWindow: SMALL_RECT;
    dwMaximumWindowSize: COORD;
};

#linkc("ReadConsoleInputW") fn ReadConsoleInputW(h: WIN_HANDLE, buf: *INPUT_RECORD, len: u32, read_out: *u32): i32;
#linkc("GetConsoleScreenBufferInfo") fn GetConsoleScreenBufferInfo(h: WIN_HANDLE, info_out: *CONSOLE_SCREEN_BUFFER_INFO): i32;
#linkc("WriteFile") fn WriteFile(h: WIN_HANDLE, buf: *u8, n: u32, written_out: *u32, overlapped: *u8): i32;

// writes all n bytes in 2 GiB chunks (WriteFile counts in a DWORD), returns how many went out (== n on success)
fn win_write_all(h: WIN_HANDLE, buf: *u8, n: i64): i64 {
    total: i64 = 0;
    while (total < n) {
        remaining := n - total;
        chunk: u32 = 2147483647; // 0x7FFFFFFF, max bytes per call
        if (remaining < chunk.cast(i64)) { chunk = remaining.cast(u32); }
        written: u32 = 0;
        p := buf |> byte_offset(total);
        if (WriteFile(h, p, chunk, written.^, nullptr(u8)) == 0) { break; }
        total += written.cast(i64);
        if (written < chunk) { break; } // short write
    }
    return total;
}

const INVALID_HANDLE_VALUE : u64 = 18446744073709551615; // (HANDLE)-1
const CP_UTF8              : u32 = 65001;

// clipboard, needs -luser32 at link time
