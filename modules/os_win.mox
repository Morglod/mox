// files + directory listing

const GENERIC_READ            : u32 = 2147483648; // 0x80000000
const GENERIC_WRITE           : u32 = 1073741824; // 0x40000000
const FILE_SHARE_READ         : u32 = 1;
const FILE_SHARE_WRITE        : u32 = 2;
