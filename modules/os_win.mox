// ---- portable OS API ----
// Same signatures as os_posix.mox. Import "./os.mox", it lands the module matching the build target.

// virtual memory pages

fn os_get_memory_page_size(): i64 {
    return win_get_page_size_cached().cast(i64);
}

fn os_mem_virtual_reserve(size: i64): *u8 {
    return win_virtual_alloc(nullptr(u8), size.cast(u64), 8192, 4); // MEM_RESERVE, PAGE_READWRITE
}

fn os_mem_virtual_commit(ptr: *u8, size: i64): bool {
    ok := win_virtual_alloc(ptr, size.cast(u64), 4096, 4); // MEM_COMMIT
    return ok != 0;
}

fn os_mem_virtual_decommit(ptr: *u8, size: i64): bool {
    ok := win_virtual_free(ptr, size.cast(u64), 16384); // MEM_DECOMMIT
    return ok != 0;
}

// size exists only for posix munmap parity.
// MEM_RELEASE requires dwSize == 0 and always frees the whole reserved region; a real size makes VirtualFree fail and free nothing.
fn os_mem_virtual_release(ptr: *u8, size: i64): bool {
    ok := win_virtual_free(ptr, 0, 32768); // MEM_RELEASE, dwSize must be 0
    return ok != 0;
}

// heap

#linkc("_aligned_malloc")  fn win_aligned_malloc(size: u64, align: u64): *u8;
#linkc("_aligned_realloc") fn win_aligned_realloc(mem: *u8, size: u64, align: u64): *u8;
#linkc("_aligned_free")    fn win_aligned_free(mem: *u8): void;
#linkc("ExitProcess")      fn ExitProcess(code: u32): void;

fn os_heap_alloc(size: i64, align: u32): *u8 {
    a := align.cast(u64);
    if (a < 8) { a = 8; }
    return win_aligned_malloc(size.cast(u64), a);
}

fn os_heap_realloc(mem: *u8, new_size: i64, align: u32): *u8 {
    a := align.cast(u64);
    if (a < 8) { a = 8; }
    return win_aligned_realloc(mem, new_size.cast(u64), a);
}

fn os_heap_free(mem: *u8): void {
    win_aligned_free(mem);
}

fn os_abort(): void {
    ExitProcess(3);
}

// thread local storage: one pointer per thread per key.
// FLS instead of TlsAlloc: only FLS runs the destructor on thread exit.

const OsTlsKey  := #type u64;                                  // wraps an FLS index (DWORD)
const OsTlsDtor : __type_ptr = #type *fn(value: *u8): void;    // called on thread exit if slot != null

const FLS_OUT_OF_INDEXES : u32 = 4294967295; // 0xFFFFFFFF

#linkc("FlsAlloc")    fn win_fls_alloc(callback: OsTlsDtor): u32;
#linkc("FlsGetValue") fn win_fls_get_value(index: u32): *u8;
#linkc("FlsSetValue") fn win_fls_set_value(index: u32, data: *u8): i32;
#linkc("FlsFree")     fn win_fls_free(index: u32): i32;

fn os_tls_key_create(key_out: *OsTlsKey, dtor: OsTlsDtor): bool {
    idx := win_fls_alloc(dtor);
    if (idx == FLS_OUT_OF_INDEXES) { return false; }
    key_out.* = idx.cast(u64);
    return true;
}

fn os_tls_key_create_simple(key_out: *OsTlsKey): bool {
    return os_tls_key_create(key_out, nullptr(u8).cast(OsTlsDtor));
}

fn os_tls_get(key: OsTlsKey): *u8 {
    return win_fls_get_value(key.cast(u32));
}

fn os_tls_set(key: OsTlsKey, value: *u8): bool {
    return win_fls_set_value(key.cast(u32), value) != 0;
}

fn os_tls_key_free(key: OsTlsKey): bool {
    return win_fls_free(key.cast(u32)) != 0;
}

// console

_os_saved_in_mode: u32 = 0;
_os_saved_out_mode: u32 = 0;

// raw input (window + mouse events, no line/echo/quick-edit) + VT output + UTF-8
fn os_console_setup_raw(): bool {
    hin := GetStdHandle(STD_INPUT_HANDLE);
    hout := GetStdHandle(STD_OUTPUT_HANDLE);
    if ((hin.cast(u64) == INVALID_HANDLE_VALUE) || (hout.cast(u64) == INVALID_HANDLE_VALUE)) {
        return false;
    }

    in_mode: u32 = 0;
    out_mode: u32 = 0;
    GetConsoleMode(hin, in_mode.^);
    GetConsoleMode(hout, out_mode.^);
    _os_saved_in_mode = in_mode;
    _os_saved_out_mode = out_mode;

    SetConsoleMode(hin, ConsoleInMode.window.cast(u32) | ConsoleInMode.mouse.cast(u32) | ConsoleInMode.extended.cast(u32));
    SetConsoleMode(hout, out_mode | ConsoleOutMode.processed.cast(u32) | ConsoleOutMode.vt.cast(u32));
    SetConsoleOutputCP(CP_UTF8);
    return true;
}

fn os_console_restore(): void {
    SetConsoleMode(GetStdHandle(STD_INPUT_HANDLE), _os_saved_in_mode);
    SetConsoleMode(GetStdHandle(STD_OUTPUT_HANDLE), _os_saved_out_mode);
}

fn os_console_size(cols: *u32, rows: *u32): bool {
    info: CONSOLE_SCREEN_BUFFER_INFO = #memory_garbage;
    if (GetConsoleScreenBufferInfo(GetStdHandle(STD_OUTPUT_HANDLE), info.^) == 0) { return false; }
    cols.* = (info.srWindow.Right - info.srWindow.Left + 1).cast(u32);
    rows.* = (info.srWindow.Bottom - info.srWindow.Top + 1).cast(u32);
    return true;
}

fn os_stdout_write(buf: *u8, len: i64): void {
    win_write_all(GetStdHandle(STD_OUTPUT_HANDLE), buf, len);
}

fn os_stdin_wait(ms: u32): void {
    WaitForSingleObject(GetStdHandle(STD_INPUT_HANDLE), ms);
}

// clipboard: text goes out as CF_UNICODETEXT; input is ASCII, so byte to u16 widening is exact

fn os_clipboard_set(text: *u8, a: u32, b: u32): void {
    n: u32 = b - a;
    if (OpenClipboard(nullptr(u8)) == 0) { return; }
    EmptyClipboard();
    hmem := GlobalAlloc(GMEM_MOVEABLE, ((n + 1) * 2).cast(u64));
    if (hmem != nullptr(u8)) {
        dst := GlobalLock(hmem);
        if (dst != nullptr(u8)) {
            wdst := dst.cast(*u16);
            src := text |> byte_offset(a.cast(i64));
            for (i : it_range(n.cast(i64))) {
                ty_offset(wdst, i).* = ty_offset(src, i).*.cast(u16);
            }
            ty_offset(wdst, n.cast(i64)).* = 0;
            GlobalUnlock(hmem);
            SetClipboardData(CF_UNICODETEXT, hmem); // clipboard owns hmem now
        }
    }
    CloseClipboard();
}

// reads at most cap-1 bytes, non-ASCII chars are dropped
fn os_clipboard_get(buf: *u8, cap: u32): u32 {
    if (cap == 0) { return 0; } // cap - 1 below would underflow the u32
    n: u32 = 0;
    if (OpenClipboard(nullptr(u8)) == 0) { return 0; }
    hdata := GetClipboardData(CF_UNICODETEXT);
    if (hdata != nullptr(u8)) {
        src := GlobalLock(hdata);
        if (src != nullptr(u8)) {
            wsrc := src.cast(*u16);
            i: i64 = 0;
            while (n < (cap - 1)) {
                c := ty_offset(wsrc, i).*;
                if (c == 0) { break; }
                if (c < 128) {
                    ty_offset(buf, n.cast(i64)).* = c.cast(u8);
                    n += 1;
                }
                i += 1;
            }
            GlobalUnlock(hdata);
        }
    }
    CloseClipboard();
    return n;
}

// files, handle model: u64, 0 = invalid/failed

fn os_file_open_read(path: *u8): OsFile {
    h := CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, nullptr(u8), OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr(u8));
    if (h.cast(u64) == INVALID_HANDLE_VALUE) { return 0; }
    return h.cast(u64);
}

// create/truncate for writing
fn os_file_open_write(path: *u8): OsFile {
    h := CreateFileA(path, GENERIC_WRITE, 0, nullptr(u8), CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr(u8));
    if (h.cast(u64) == INVALID_HANDLE_VALUE) { return 0; }
    return h.cast(u64);
}

fn os_file_size(h: OsFile): i64 {
    sz: i64 = 0;
    if (GetFileSizeEx(h.cast(*u8), sz.^) == 0) { return 0; }
    if (sz < 0) { return 0; }
    return sz;
}

// reads up to n bytes in one call, returns bytes read, 0 = EOF or error. A single call caps at 2 GiB.
fn os_file_read(h: OsFile, buf: *u8, n: i64): i64 {
    if (h == 0) { return 0; }
    chunk: u32 = 2147483647; // 0x7FFFFFFF, max bytes per call
    if (n < chunk.cast(i64)) { chunk = n.cast(u32); }
    got: u32 = 0;
    if (ReadFile(h.cast(*u8), buf, chunk, got.^, nullptr(u8)) == 0) { return 0; }
    return got.cast(i64);
}

// writes all n bytes, returns how many went out (== n on success)
fn os_file_write(h: OsFile, buf: *u8, n: i64): i64 {
    if (h == 0) { return 0; }
    return win_write_all(h.cast(*u8), buf, n);
}

fn os_file_close(h: OsFile): void {
    if (h != 0) { CloseHandle(h.cast(*u8)); }
}

fn os_file_delete(path: *u8): bool {
    return DeleteFileA(path) != 0;
}

// stdout as a writable OsFile
fn os_stdout_file(): OsFile {
    return GetStdHandle(STD_OUTPUT_HANDLE).cast(u64);
}

// writes the cwd NUL-terminated into buf, returns the length without the NUL. Separators become "/".
fn os_cwd(buf: *u8, cap: i64): i64 {
    n := GetCurrentDirectoryA(cap.cast(u32), buf);
    // n >= cap: buffer too small, GetCurrentDirectoryA returns the required size and leaves buf untouched
    if ((n == 0) || (n.cast(i64) >= cap)) { return 0; }
    replace_inplace(slice(buf, n.cast(i64)), char("\\"), char("/"));
    return n.cast(i64);
}

// directory listing: os_dir_open(it, "<dir>") then os_dir_next(it) until false. "." and ".." are included.

struct OsDirIter {
    handle: u64;
    pending: bool;      // fd holds the FindFirstFileA entry, not returned yet
    is_dir: bool;
    name: []u8;         // view into fd.cFileName, valid until the next os_dir_next; copy to keep
    fd: WIN32_FIND_DATAA;
};

fn os_dir_open(it: *OsDirIter, dir_path: []u8): bool {
    // build "<dir>/*" with a trailing NUL, Win32 accepts "/" separators
    pat := #temp_buffer(dir_path.len + 3); // separator + '*' + NUL
    n := dir_path.len;
    mem_copy(pat.ptr, dir_path.ptr, n);
    if (n > 0) {
        last := pat[n - 1];
        if ((last != char("\\")) && (last != char("/"))) {
            pat[n] = char("/");
            n += 1;
        }
    }
    pat[n] = char("*");
    pat[n + 1] = 0;

    h := FindFirstFileA(pat.ptr, it.fd.^);
    if (h.cast(u64) == INVALID_HANDLE_VALUE) {
        it.handle = 0;
        return false;
    }
    it.handle = h.cast(u64);
    it.pending = true;
    return true;
}

fn os_dir_next(it: *OsDirIter): bool {
    if (it.handle == 0) { return false; }
    if (!it.pending) {
        if (FindNextFileA(it.handle.cast(*u8), it.fd.^) == 0) { return false; }
    }
    it.pending = false;

    it.name.ptr = it.fd.cFileName.ptr;
    it.name.len = c_strlen(it.fd.cFileName.ptr, 260);
    it.is_dir = (it.fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
    return true;
}

fn os_dir_close(it: *OsDirIter): void {
    if (it.handle != 0) {
        FindClose(it.handle.cast(*u8));
        it.handle = 0;
    }
}

// terminal input: os_term_input_init once, then os_term_poll per frame (non-blocking, false = nothing pending).
// Events use the shared model from vt_input.mox, decoded from native console input records; resize arrives as a window_buffer_size record.

struct OsTermInput {
    hin: WIN_HANDLE;
    prev_button_state: u32;
};

fn os_term_input_init(ti: *OsTermInput): void {
    ti.hin = GetStdHandle(STD_INPUT_HANDLE);
    ti.prev_button_state = 0;
}

fn _os_bit(flags: u32, f: $E): bool {
    return (flags & f.cast(u32)) != 0;
}

fn _os_vk_to_keycode(vk: u16): KeyCode {
    if (vk == 13)  { return .enter; }
    if (vk == 27)  { return .escape; }
    if (vk == 9)   { return .tab; }
    if (vk == 8)   { return .backspace; }
    if (vk == 46)  { return .delete; }
    if (vk == 32)  { return .space; }
    if (vk == 38)  { return .up; }
    if (vk == 40)  { return .down; }
    if (vk == 37)  { return .left; }
    if (vk == 39)  { return .right; }
    if (vk == 36)  { return .home; }
    if (vk == 35)  { return .end; }
    if (vk == 33)  { return .page_up; }
    if (vk == 34)  { return .page_down; }
    if (vk == 45)  { return .insert; }
    if (vk == 112) { return .f1; }
    if (vk == 113) { return .f2; }
    if (vk == 114) { return .f3; }
    if (vk == 115) { return .f4; }
    if (vk == 116) { return .f5; }
    if (vk == 117) { return .f6; }
    if (vk == 118) { return .f7; }
    if (vk == 119) { return .f8; }
    if (vk == 120) { return .f9; }
    if (vk == 121) { return .f10; }
    if (vk == 122) { return .f11; }
    if (vk == 123) { return .f12; }
    return .char;
}

fn _os_decode_mods(cks: u32): u8 {
    m: u8 = 0;
    if (_os_bit(cks, ControlKeyMask.shift)) { m += MOD_SHIFT; }
    if (_os_bit(cks, ControlKeyMask.ctrl)) { m += MOD_CTRL; }
    if (_os_bit(cks, ControlKeyMask.alt)) { m += MOD_ALT; }
    return m;
}

fn _os_changed_button(now: u32, was: u32): MouseButton {
    if (_os_bit(now, MouseButtonBit.left) && !_os_bit(was, MouseButtonBit.left)) { return .left; }
    if (_os_bit(now, MouseButtonBit.right) && !_os_bit(was, MouseButtonBit.right)) { return .right; }
    if (_os_bit(now, MouseButtonBit.middle) && !_os_bit(was, MouseButtonBit.middle)) { return .middle; }
    return .none;
}

fn _os_decode_input_record(rec: *INPUT_RECORD, prev_button: *u32, ev: *Event): bool {
    et := rec.EventType;
    ev.repeat = 1;

    if (et == .key) {
        kr := rec.Event.ptr.cast(*KEY_EVENT_RECORD);
        if (kr.bKeyDown == 0) { return false; } // ignore key-up
        ev.kind = .key;
        ev.vk = kr.wVirtualKeyCode;
        ev.code = _os_vk_to_keycode(kr.wVirtualKeyCode);
        ev.mods = _os_decode_mods(kr.dwControlKeyState);
        ev.ch = kr.UnicodeChar.cast(u32); // carry the char for every key, typing needs it
        if (kr.wRepeatCount > 1) { ev.repeat = kr.wRepeatCount; } // held key: one record, N repeats
        return true;
    }

    if (et == .mouse) {
        mr := rec.Event.ptr.cast(*MOUSE_EVENT_RECORD);
        ev.kind = .mouse;
        ev.x = mr.dwMousePosition.X.cast(u32);
        ev.y = mr.dwMousePosition.Y.cast(u32);
        ev.mods = _os_decode_mods(mr.dwControlKeyState);
        ev.button = .none;
        ev.wheel = 0;
        flags := mr.dwEventFlags;

        if (_os_bit(flags, MouseEventFlag.moved)) {
            ev.action = .move;
            prev_button.* = mr.dwButtonState;
            return true;
        }
        if (_os_bit(flags, MouseEventFlag.wheeled)) { // signed wheel delta in high word
            ev.action = .wheel;
            hw := #shr(mr.dwButtonState, 16);
            if (hw > 32767) { ev.wheel = hw.cast(i32) - 65536; }
            else { ev.wheel = hw.cast(i32); }
            prev_button.* = mr.dwButtonState;
            return true;
        }

        bs := mr.dwButtonState;
        pv := prev_button.*;
        pressed := _os_changed_button(bs, pv);
        if (pressed != .none) {
            ev.action = .press;
            ev.button = pressed;
        } else {
            ev.action = .release;
            ev.button = _os_changed_button(pv, bs);
        }
        prev_button.* = bs;
        return true;
    }

    if (et == .window_buffer_size) {
        wr := rec.Event.ptr.cast(*WINDOW_BUFFER_SIZE_RECORD);
        ev.kind = .resize;
        ev.w = wr.dwSize.X.cast(u32);
        ev.h = wr.dwSize.Y.cast(u32);
        return true;
    }

    return false;
}

fn os_term_poll(ti: *OsTermInput, ev: *Event): bool {
    n: u32 = 0;
    while (true) {
        if (GetNumberOfConsoleInputEvents(ti.hin, n.^) == 0) { return false; }
        if (n == 0) { return false; }

        rec: INPUT_RECORD = #memory_garbage;
        read: u32 = 0;
        if (ReadConsoleInputW(ti.hin, rec.^, 1, read.^) == 0) { return false; }
        if (read == 0) { return false; }

        if (_os_decode_input_record(rec.^, ti.prev_button_state.^, ev)) {
            return true;
        }
        // skipped record, read the next one
    }
    return false;
}

// raw stdin bytes, for terminal query replies. Under ConPTY a VT reply arrives as KEY_EVENT records, collect their chars. Never blocks.
fn os_stdin_read_bytes(ti: *OsTermInput, buf: *u8, cap: i64): i64 {
    pos: i64 = 0;
    while (pos < cap) {
        queued: u32 = 0;
        if (GetNumberOfConsoleInputEvents(ti.hin, queued.^) == 0) { return pos; }
        if (queued == 0) { return pos; }
        rec: INPUT_RECORD = #memory_garbage;
        read: u32 = 0;
        if (ReadConsoleInputW(ti.hin, rec.^, 1, read.^) == 0) { return pos; }
        if (read == 0) { return pos; }
        if (rec.EventType == .key) {
            kr := rec.Event.ptr.cast(*KEY_EVENT_RECORD);
            if ((kr.bKeyDown != 0) && (kr.UnicodeChar != 0)) {
                ty_offset(buf, pos).* = kr.UnicodeChar.cast(u8);
                pos += 1;
            }
        }
    }
    return pos;
}

// Slice variants that cannot live in os.mox: OsTermInput differs per platform, and #temp_c_string needs c_interp.mox which os.mox cannot import.
// Keep in sync with os_posix.mox.

fn os_stdin_read_bytes(ti: *OsTermInput, buf: []u8): i64 { return os_stdin_read_bytes(ti, buf.ptr, buf.len); }

fn os_file_open_read(path: []u8): OsFile {
    return os_file_open_read(#temp_c_string(path));
}
fn os_file_open_write(path: []u8): OsFile {
    return os_file_open_write(#temp_c_string(path));
}
fn os_file_delete(path: []u8): bool {
    return os_file_delete(#temp_c_string(path));
}

// one level; false when it already exists or the parent is missing
fn os_make_dir(path: []u8): bool {
    return CreateDirectoryA(#temp_c_string(path), nullptr(u8)) != 0;
}

// the directory must be empty
fn os_delete_dir(path: []u8): bool {
    return RemoveDirectoryA(#temp_c_string(path)) != 0;
}

// files and (same-volume) directories; an existing `to` file is replaced
fn os_rename(from: []u8, to: []u8): bool {
    return MoveFileExA(#temp_c_string(from), #temp_c_string(to), MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED) != 0;
}

fn os_copy_file(from: []u8, to: []u8): bool {
    return CopyFileA(#temp_c_string(from), #temp_c_string(to), 0) != 0;
}

// "file" means any non-directory entry

fn os_path_exists(path: []u8): bool {
    return GetFileAttributesA(#temp_c_string(path)) != INVALID_FILE_ATTRIBUTES;
}
fn os_dir_exists(path: []u8): bool {
    attrs := GetFileAttributesA(#temp_c_string(path));
    if (attrs == INVALID_FILE_ATTRIBUTES) { return false; }
    return (attrs & FILE_ATTRIBUTE_DIRECTORY) != 0;
}
fn os_file_exists(path: []u8): bool {
    attrs := GetFileAttributesA(#temp_c_string(path));
    if (attrs == INVALID_FILE_ATTRIBUTES) { return false; }
    return (attrs & FILE_ATTRIBUTE_DIRECTORY) == 0;
}

// runs cmd through the platform shell (cmd.exe /C here, /bin/sh -c on posix), waits, returns its exit code. -1 = could not start.

fn _win_shell_cmdline(cmd: []u8, arena: *Arena): *u8 {
    prefix: []u8 = "cmd.exe /C ";
    full := arena_push(arena, prefix.len + cmd.len + 1);
    mem_copy(full.ptr, prefix.ptr, prefix.len);
    mem_copy(full.ptr |> byte_offset(prefix.len), cmd.ptr, cmd.len);
    full[prefix.len + cmd.len] = 0;
    return full.ptr;
}

fn os_exec(cmd: []u8): i32 {
    full := _win_shell_cmdline(cmd, #temp_arena());

    si: STARTUPINFOEXA = 0;
    si.StartupInfo.cb = sizeof_type(STARTUPINFOA).cast(u32);
    pi: PROCESS_INFORMATION = 0;
    // inherit=1: child shares our console and stdio
    if (CreateProcessA(nullptr(u8), full, nullptr(u8), nullptr(u8), 1, 0, nullptr(u8), nullptr(u8), si.^, pi.^) == 0) {
        return -1;
    }
    WaitForSingleObject(pi.hProcess, INFINITE);
    code: u32 = 0;
    GetExitCodeProcess(pi.hProcess, code.^);
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);
    return code.cast(i32);
}

fn os_monotonic_ms(): i64 {
    return GetTickCount64().cast(i64);
}

_os_qpc_freq: i64 = 0;

fn os_monotonic_ns(): i64 {
    if (_os_qpc_freq == 0) {
        win_QueryPerformanceFrequency(_os_qpc_freq.^);
    }
    c: i64 = 0;
    win_QueryPerformanceCounter(c.^);
    // split so c * 1e9 cannot overflow
    sec := c / _os_qpc_freq;
    rem := c - sec * _os_qpc_freq;
    return sec * 1000000000 + rem * 1000000000 / _os_qpc_freq;
}

fn os_unix_time_ms(): i64 {
    ft: u64 = 0; // FILETIME as one u64
    win_GetSystemTimeAsFileTime(ft.^);
    return ((ft - 116444736000000000) / 10000).cast(i64); // 1601 -> 1970, 100ns -> ms
}

fn os_sleep_ms(ms: i64): void {
    if (ms <= 0) { return; }
    ms = min(ms, 4294967294); // Sleep takes a u32; INFINITE (max u32) must not be reachable
    win_Sleep(ms.cast(u32));
}

// writes the temp directory into buf (with a trailing separator), returns the length, 0 = failed.
// Separators become "/".
fn os_temp_dir(buf: *u8, cap: i64): i64 {
    n := GetTempPathA(cap.cast(u32), buf);
    // n > cap: buffer too small, GetTempPathA returns the required size
    if ((n == 0) || (n.cast(i64) > cap)) { return 0; }
    replace_inplace(slice(buf, n.cast(i64)), char("\\"), char("/"));
    return n.cast(i64);
}

enum OsExecStreamMode : u8 {
    inherit := 0; // share the parent's handle
    buffer  := 1; // stdin: fed from ExecOptions.stdin_data, then closed; stdout/stderr: captured into ExecResult
    null    := 2; // NUL / /dev/null
    file    := 3; // the OsFile in ExecOptions.*_file (opened by the caller, stays open)
    merge   := 4; // stderr only: goes wherever stdout goes
};

struct ExecOptions {
    stdin_mode: OsExecStreamMode;
    stdin_data: []u8;   // written to the child when stdin_mode == .buffer, then its stdin is closed
    stdin_file: OsFile;
    stdout_mode: OsExecStreamMode;
    stdout_file: OsFile;
    stderr_mode: OsExecStreamMode;
    stderr_file: OsFile;
    cwd: []u8;          // empty = inherit
    timeout_ms: i64;    // 0 = wait forever; on expiry the child is killed and timed_out is set
    no_window: bool;    // windows only: CREATE_NO_WINDOW, no console flashes up from a GUI parent
};

struct ExecResult {
    started: bool;      // false = the command could not be started, nothing else is meaningful
    ok: bool;
    timed_out: bool;
    exit_code: i32;     // -1 when not started; 128+signal when killed by a signal on posix (also after a timeout kill)
    stdout: []u8;       // on arena, filled only when stdout_mode == .buffer
    stderr: []u8;       // on arena, filled only when stderr_mode == .buffer
};

// resolves the child's handle for one standard stream from its option.
// child_out: what the child gets; ours_out: our end of the pipe (0 = none); owned_out: child_out is ours to close after CreateProcess.
// pipe_size is the pipe buffer hint (0 = default).
fn _win_exec_child_handle(mode: OsExecStreamMode, std_id: u32, file: OsFile, child_reads: bool, pipe_size: u32, sa: *SECURITY_ATTRIBUTES, child_out: *u64, ours_out: *u64, owned_out: *bool): bool {
    child_out.* = 0;
    ours_out.* = 0;
    owned_out.* = false;
    if (mode == .buffer) {
        r: u64 = 0;
        w: u64 = 0;
        if (CreatePipe(r.^, w.^, sa.cast(*u8), pipe_size) == 0) { return false; }
        child: u64 = w;
        ours: u64 = r;
        if (child_reads) { child = r; ours = w; }
        SetHandleInformation(ours.cast(*u8), HANDLE_FLAG_INHERIT, 0); // only the child's end may be inherited
        child_out.* = child;
        ours_out.* = ours;
        owned_out.* = true;
        return true;
    }
    if (mode == .null) {
        nul := "NUL";
        h := CreateFileA(nul.ptr, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, sa.cast(*u8), OPEN_EXISTING, 0, nullptr(u8));
        if (h.cast(u64) == INVALID_HANDLE_VALUE) { return false; }
        child_out.* = h.cast(u64);
        owned_out.* = true;
        return true;
    }
    if (mode == .file) {
        if (file == 0) { return false; }
        SetHandleInformation(file.cast(*u8), HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT); // cleared again after CreateProcess
        child_out.* = file;
        return true;
    }
    child_out.* = GetStdHandle(std_id).cast(u64);
    return true;
}

fn _win_close_if(h: u64): void {
    if (h != 0) { CloseHandle(h.cast(*u8)); }
}

// moves whatever the pipe holds right now into a fresh scratch chunk pushed on sb. Returns false when nothing was pending.
// At EOF (every write end closed) the handle is closed and zeroed.
fn _win_exec_pump(h: *u64, sb: *StringBuilder, alloc: *Alloc): bool {
    hv := h.*;
    avail: u32 = 0;
    if (PeekNamedPipe(hv.cast(*u8), nullptr(u8), 0, nullptr(u32), avail.^, nullptr(u32)) == 0) {
        CloseHandle(hv.cast(*u8));
        h.* = 0;
        return true;
    }
    if (avail == 0) { return false; }
    n := min(avail.cast(i64), _OS_EXEC_READ_CHUNK);
    chunk := mem_alloc(alloc, n, 1);
    got: u32 = 0;
    if (ReadFile(hv.cast(*u8), chunk, n.cast(u32), got.^, nullptr(u8)) == 0) {
        CloseHandle(hv.cast(*u8));
        h.* = 0;
        return true;
    }
    push(sb, slice(chunk, got.cast(i64)));
    return true;
}

// runs cmd through the platform shell (cmd.exe /C here, /bin/sh -c on posix) with options
// Captured output lives on arena.
fn os_exec_ex(cmd: []u8, opts: ExecOptions, arena: *Arena = #temp_arena()): ExecResult {
    res: ExecResult = 0;
    res.exit_code = -1;

    scratch := scratch_begin(arena);
    defer scratch_end(scratch);

    full := _win_shell_cmdline(cmd, scratch.arena);
    cwd := nullptr(u8);
    if (opts.cwd.len > 0) { cwd = arena_push_str_copy_c(scratch.arena, opts.cwd).ptr; }

    sa: SECURITY_ATTRIBUTES = 0;
    sa.nLength = sizeof_type(SECURITY_ATTRIBUTES).cast(u32);
    sa.bInheritHandle = 1;

    in_child: u64 = 0;  in_ours: u64 = 0;  in_owned := false;
    out_child: u64 = 0; out_ours: u64 = 0; out_owned := false;
    err_child: u64 = 0; err_ours: u64 = 0; err_owned := false;

    stdin_pipe_size := min(max(opts.stdin_data.len, 1), 2147483647).cast(u32);
    ok := _win_exec_child_handle(opts.stdin_mode, STD_INPUT_HANDLE, opts.stdin_file, true, stdin_pipe_size, sa.^, in_child.^, in_ours.^, in_owned.^);
    if (ok) { ok = _win_exec_child_handle(opts.stdout_mode, STD_OUTPUT_HANDLE, opts.stdout_file, false, 0, sa.^, out_child.^, out_ours.^, out_owned.^); }
    if (ok) {
        if (opts.stderr_mode == .merge) {
            err_child = out_child; // same handle, closed once through out_owned
        } else {
            ok = _win_exec_child_handle(opts.stderr_mode, STD_ERROR_HANDLE, opts.stderr_file, false, 0, sa.^, err_child.^, err_ours.^, err_owned.^);
        }
    }

    pi: PROCESS_INFORMATION = 0;
    if (ok) {
        si: STARTUPINFOEXA = 0;
        si.StartupInfo.cb = sizeof_type(STARTUPINFOA).cast(u32);
        si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
        si.StartupInfo.hStdInput = in_child.cast(*u8);
        si.StartupInfo.hStdOutput = out_child.cast(*u8);
        si.StartupInfo.hStdError = err_child.cast(*u8);
        flags: u32 = 0;
        if (opts.no_window) { flags = CREATE_NO_WINDOW; }
        // inherit=1 hands over the marked handles
        ok = CreateProcessA(nullptr(u8), full, nullptr(u8), nullptr(u8), 1, flags, nullptr(u8), cwd, si.^, pi.^) != 0;
    }

    // the child holds its own copies now (or never started): release the child ends and un-mark caller files
    if (in_owned)  { CloseHandle(in_child.cast(*u8)); }
    if (out_owned) { CloseHandle(out_child.cast(*u8)); }
    if (err_owned) { CloseHandle(err_child.cast(*u8)); }
    if (opts.stdin_mode == .file)  { SetHandleInformation(in_child.cast(*u8), HANDLE_FLAG_INHERIT, 0); }
    if (opts.stdout_mode == .file) { SetHandleInformation(out_child.cast(*u8), HANDLE_FLAG_INHERIT, 0); }
    if (opts.stderr_mode == .file) { SetHandleInformation(err_child.cast(*u8), HANDLE_FLAG_INHERIT, 0); }
    if (!ok) {
        _win_close_if(in_ours);
        _win_close_if(out_ours);
        _win_close_if(err_ours);
        return res;
    }
    res.started = true;

    // stdin first: the pipe buffer holds all of it, so this returns without waiting on the child. Closing = EOF for the child.
    if (in_ours != 0) {
        win_write_all(in_ours.cast(*u8), opts.stdin_data.ptr, opts.stdin_data.len);
        CloseHandle(in_ours.cast(*u8));
        in_ours = 0;
    }

    out_sb: StringBuilder = #memory_garbage;
    err_sb: StringBuilder = #memory_garbage;
    init(out_sb.^, scratch.alloc);
    init(err_sb.^, scratch.alloc);

    deadline: i64 = 0;
    if (opts.timeout_ms > 0) { deadline = os_monotonic_ms() + opts.timeout_ms; }

    // drain both pipes until EOF; anonymous pipes have no overlapped I/O, so it is peek + short waits on the process
    exited := false;
    while ((out_ours != 0) || (err_ours != 0)) {
        if ((deadline != 0) && (!res.timed_out) && (os_monotonic_ms() >= deadline)) {
            TerminateProcess(pi.hProcess, 1);
            res.timed_out = true;
            exited = true;
        }
        progressed := false;
        if (out_ours != 0) { if (_win_exec_pump(out_ours.^, out_sb.^, scratch.alloc)) { progressed = true; } }
        if (err_ours != 0) { if (_win_exec_pump(err_ours.^, err_sb.^, scratch.alloc)) { progressed = true; } }
        if (progressed) { continue; }
        if (exited) { break; } // child is gone and its pipes are drained; whoever still holds a write end is not our child
        if (WaitForSingleObject(pi.hProcess, 10) == 0) { exited = true; }
    }
    _win_close_if(out_ours);
    _win_close_if(err_ours);

    // the child may outlive its pipes (closed stdout early); wait for it with whatever time is left
    remaining: u32 = INFINITE;
    if (deadline != 0) {
        left := deadline - os_monotonic_ms();
        if (left < 0) { left = 0; }
        remaining = left.cast(u32);
    }
    if (WaitForSingleObject(pi.hProcess, remaining) != 0) {
        TerminateProcess(pi.hProcess, 1);
        res.timed_out = true;
        WaitForSingleObject(pi.hProcess, INFINITE);
    }
    code: u32 = 0;
    GetExitCodeProcess(pi.hProcess, code.^);
    res.exit_code = code.cast(i32);
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);

    out_alloc := arena_as_allocator(arena);
    if (opts.stdout_mode == .buffer) { res.stdout = finalize(out_sb.^, out_alloc, false); }
    if (opts.stderr_mode == .buffer) { res.stderr = finalize(err_sb.^, out_alloc, false); }
    res.ok = res.exit_code == 0 && res.started;
    return res;
}

// runs cmd through the platform shell, waits, returns everything it wrote to stdout (on arena).
// Empty when the command could not start (or printed nothing). stdin and stderr stay inherited; append "2>&1" to capture stderr too.
fn os_exec_output(cmd: []u8, arena: *Arena = #temp_arena()): []u8 {
    opts: ExecOptions = 0;
    opts.stdout_mode = .buffer;
    return os_exec_ex(cmd, opts, arena).stdout;
}

fn os_stdout_write(buf: []u8): void { os_stdout_write(buf.ptr, buf.len); }
fn os_file_read(h: OsFile, buf: []u8): i64 { return os_file_read(h, buf.ptr, buf.len); }
fn os_file_write(h: OsFile, buf: []u8): i64 { return os_file_write(h, buf.ptr, buf.len); }
fn os_cwd(buf: []u8): i64 { return os_cwd(buf.ptr, buf.len); }
fn os_temp_dir(buf: []u8): i64 { return os_temp_dir(buf.ptr, buf.len); }
fn os_clipboard_set(text: []u8): void { os_clipboard_set(text.ptr, 0 .cast(u32), text.len.cast(u32)); }
fn os_clipboard_get(buf: []u8): u32 { return os_clipboard_get(buf.ptr, buf.len.cast(u32)); }

#linkc("GetEnvironmentVariableA") fn win_GetEnvironmentVariableA(name: *u8, buffer: *u8, size: u32): u32;
#linkc("SetEnvironmentVariableA") fn win_SetEnvironmentVariableA(name: *u8, value: *u8): i32;

fn os_get_env(name: []u8, alloc: *Alloc = get_context_temp_arena_as_alloc()): []u8 {
    name_c := #temp_c_string(name, alloc);
    len := win_GetEnvironmentVariableA(name_c, nullptr(u8), 0);
    if (len == 0) {
        return empty_slice(u8);
    }
    buf := mem_alloc_slice(alloc, u8, len);
    win_GetEnvironmentVariableA(name_c, buf.ptr, len);
    return slice(buf, 0, len - 1);
}

fn os_set_env(name: []u8, value: []u8): void {
    win_SetEnvironmentVariableA(#temp_c_string(name), #temp_c_string(value));
}

fn os_delete_env(name: []u8): void {
    win_SetEnvironmentVariableA(#temp_c_string(name), nullptr(u8));
}
