import "internal.mox";
import "vendor/sdl3.mox";
import "slice.mox";
import "os.mox";
import "format.mox";
import "c_interp.mox";
import "string.mox";

// mox ./tests/2_sdl3.mox
#run __compiler_append_linker("libSDL3.dll.a");

fn #fail($fmt: []u8, values: $T) {
    os_stdout_write(#format_temp($fmt, values));
    sdl_error_str := SDL_GetError().cast(*u8);
    sdl_error := slice(sdl_error_str, c_strlen(sdl_error_str));
    os_stdout_write(sdl_error);

    // returns -1 from main
    `return -1;
}

#linkc fn main(): i32 {
    // 1. Initialize SDL
    init_status := SDL_Init(SDL_INIT_VIDEO);
    if (!init_status) {
        #fail("sdl init failed with code: {}\n{}\n", .{ init_status; });
    }

    defer SDL_Quit();
    
    // 2. Create Window
    window := SDL_CreateWindow("SDL3 Minimal", 640, 480, 0);
    if (window == 0) {
        #fail("window creation failed\n", .{});
    }
    
    defer SDL_DestroyWindow(window);
    
    // 3. Create Renderer
    renderer := SDL_CreateRenderer(window, nullptr(i8));
    if (renderer == 0) {
        #fail("render creation failed\n", .{});
    }

    defer SDL_DestroyRenderer(renderer);

    // Main loop
    event : SDL_Event = #memory_garbage;
    quit := false;
    while (!quit) {
        while (SDL_PollEvent(event.^)) {
            event_type :u32 = event.^.cast(*SDL_CommonEvent).type;
            if (event_type == 256) {
                quit = true;
            }
        }
        
        SDL_SetRenderDrawColor(renderer, 25, 25, 25, 255);
        SDL_RenderClear(renderer);

        SDL_SetRenderDrawColor(renderer, 255, 0, 0, 255);
        SDL_RenderDebugText(renderer, 200, 200, "hello world!");

        SDL_RenderPresent(renderer);
    }

    return 0;
}