import "std.mox";
import "build.mox";

// Baking git hash as a constant to binary
fn print_version() {
    git_hash := #run os_exec_output("git rev-parse HEAD");
    println(git_hash);
}

// Build params from environment variables
USE_FOO := #run os_get_env("USE_FOO") == "true";
#run {
    println("\nUSE_FOO = {}", .{ USE_FOO; });
}

fn foo() {
    #if (USE_FOO) {
        println("foo");
    } else {
        println("not foo");
    }
}

// Build C lib as dll, link it and make it available in comptime!

// this function will be linked by compiler at comptime in section below
#linkc fn comptime_example(a: i32, b: i32): i32;

#run {
    // the library is built straight into the output dir, next to the exe
    // a file built somewhere else can be copied there with build_copy_to_output("path/to/file")
    out_dir := __compiler_output_dir();
    temp := get_context_temp_arena_as_alloc();
    if (MOX_OS == .Windows) {
        os_exec(format(temp, "echo __declspec(dllexport) int comptime_example(int a, int b) { return a + b; } | clang -x c - -shared -o \"{}comptime_example.dll\"", .{ out_dir; }));
    } else {
        os_exec(format(temp, "echo 'int comptime_example(int a, int b) { return a + b; }' | clang -x c - -shared -o \"{}comptime_example.so\"", .{ out_dir; }));
    }
    // path without the extension
    __compiler_link_lib(format(temp, "{}comptime_example", .{ out_dir; }), true);
    println("\ncomptime_example(10,20) = {}\n", .{ comptime_example(10, 20) });
}

#linkc fn main(): i32 {
    print_version();
    return 0;
}